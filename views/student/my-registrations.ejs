<%- include('../partials/header') %>

<style>
/* Responsive Dashboard Styles */
.dashboard-container {
    min-height: 100vh;
    background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
}

@media (max-width: 768px) {
    .dashboard-container {
        background: #f9fafb;
    }
}

/* Mobile text color fixes */
@media (max-width: 640px) {
    .dashboard-container h1 {
        color: #1f2937 !important; /* Force dark gray */
    }
    
    .dashboard-container p {
        color: #4b5563 !important; /* Force medium gray */
    }
}
</style>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1 overflow-y-auto">
        <div class="p-4 sm:p-6">
            <!-- Flash Messages -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div id="successMessage" class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-auto max-w-4xl">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        <span><%= success %></span>
                    </div>
                </div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div id="errorMessage" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-auto max-w-4xl">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <span><%= error %></span>
                    </div>
                </div>
            <% } %>

            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-800">My Registrations</h1>
                <p class="text-gray-700 sm:text-gray-600">View all events you have registered for</p>
            </div>

            <!-- Registrations List -->
            <% if (events && events.length > 0) { %>
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event Title</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Venue</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% events.forEach(event => { %>
                                    <% const registration = event.registrations[0]; %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4">
                                            <div class="text-sm font-medium text-gray-900">
                                                <%= event.title %>
                                            </div>
                                            <% if (registration.teamName) { %>
                                                <div class="text-xs text-gray-500 mt-1">
                                                    <i class="fas fa-users mr-1"></i>Team: <%= registration.teamName %>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm text-gray-900">
                                                <%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm text-gray-900">
                                                <%= event.startTime %> - <%= event.endTime %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm text-gray-900">
                                                <%= event.venue %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                <i class="fas fa-check-circle mr-1"></i>Registered
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                        <form method="POST" action="/student/registrations/<%= event._id %>/cancel" 
                                              onsubmit="return confirm('Are you sure you want to cancel this registration?')">
                                            <button type="submit" class="bg-red-100 text-red-800 px-3 py-1 rounded text-sm hover:bg-red-200 transition-colors">
                                                <i class="fas fa-times mr-1"></i>Cancel
                                            </button>
                                        </form>
                                    </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <i class="fas fa-ticket-alt text-gray-400 text-5xl mb-4"></i>
                    <h3 class="text-xl font-semibold text-gray-600 mb-2">You have not registered for any events yet.</h3>
                    <p class="text-gray-500 mb-4">
                        Start exploring and register for exciting events!
                    </p>
                    <a href="/student/events" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition-colors">
                        <i class="fas fa-search mr-2"></i>Browse Events
                    </a>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
    // Control flash message display duration
    window.addEventListener('load', function() {
        // Auto-hide success message after 3 seconds
        const successMessage = document.getElementById('successMessage');
        
        if (successMessage) {
            setTimeout(function() {
                successMessage.style.transition = 'opacity 0.5s ease';
                successMessage.style.opacity = '0';
                setTimeout(function() {
                    successMessage.style.display = 'none';
                }, 500);
            }, 3000);
        }
        
        // Auto-hide error message after 5 seconds
        const errorMessage = document.getElementById('errorMessage');
        
        if (errorMessage) {
            setTimeout(function() {
                errorMessage.style.transition = 'opacity 0.5s ease';
                errorMessage.style.opacity = '0';
                setTimeout(function() {
                    errorMessage.style.display = 'none';
                }, 500);
            }, 5000);
        }
    });
</script>

<%- include('../partials/footer') %>
