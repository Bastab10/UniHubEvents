<%- include('../partials/header') %>

<div class="flex h-screen">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1 overflow-y-auto">
        <div class="p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-800">My Registrations</h1>
                <p class="text-gray-600">Track your event registrations and approval status</p>
            </div>

            <!-- Filters -->
            <div class="bg-white rounded-lg shadow-md p-4 mb-6">
                <form method="GET" class="flex flex-wrap gap-4 items-center">
                    <div>
                        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select id="status" name="status" class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                            <option value="">All Status</option>
                            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                            <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                        </select>
                    </div>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        <i class="fas fa-filter mr-2"></i>Filter
                    </button>
                </form>
            </div>

            <!-- Registrations List -->
            <div class="bg-white rounded-lg shadow-md">
                <% if (events && events.length > 0) { %>
                    <div class="divide-y divide-gray-200">
                        <% events.forEach(event => { %>
                            <% const registration = event.registrations[0]; %>
                            <div class="p-6 hover:bg-gray-50">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <div class="flex items-center mb-2">
                                            <h3 class="text-lg font-semibold text-gray-800 mr-3"><%= event.title %></h3>
                                            <span class="px-2 py-1 text-xs font-medium 
                                                <% if (event.category === 'seminar') { %>bg-blue-100 text-blue-800<% } else if (event.category === 'workshop') { %>bg-green-100 text-green-800<% } else if (event.category === 'cultural') { %>bg-purple-100 text-purple-800<% } else { %>bg-yellow-100 text-yellow-800<% } %> rounded-full">
                                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                            </span>
                                            <span class="ml-2 px-2 py-1 text-xs font-medium 
                                                <% if (registration.status === 'approved') { %>bg-green-100 text-green-800<% } else if (registration.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } else { %>bg-red-100 text-red-800<% } %> rounded-full">
                                                <%= registration.status.charAt(0).toUpperCase() + registration.status.slice(1) %>
                                            </span>
                                        </div>
                                        
                                        <p class="text-gray-600 mb-3"><%= event.description %></p>
                                        
                                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm text-gray-600">
                                            <div>
                                                <i class="fas fa-calendar-alt mr-2"></i>
                                                <%= new Date(event.date).toLocaleDateString() %>
                                            </div>
                                            <div>
                                                <i class="fas fa-clock mr-2"></i>
                                                <%= event.startTime %> - <%= event.endTime %>
                                            </div>
                                            <div>
                                                <i class="fas fa-map-marker-alt mr-2"></i>
                                                <%= event.venue %>
                                            </div>
                                            <div>
                                                <i class="fas fa-user mr-2"></i>
                                                <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                            </div>
                                        </div>

                                        <% if (registration.teamName) { %>
                                            <div class="mt-3 p-3 bg-blue-50 rounded">
                                                <p class="text-sm font-medium text-blue-700 mb-1">
                                                    <i class="fas fa-users mr-1"></i>Team: <%= registration.teamName %>
                                                </p>
                                                <% if (registration.teamMembers && registration.teamMembers.length > 0) { %>
                                                    <p class="text-sm text-blue-600">Members: 
                                                        <%= registration.teamMembers.map(m => m.name).join(', ') %>
                                                    </p>
                                                <% } %>
                                            </div>
                                        <% } %>

                                        <div class="mt-3 text-sm text-gray-500">
                                            <i class="fas fa-clock mr-1"></i>
                                            Registered on <%= new Date(registration.registeredAt).toLocaleDateString() %>
                                        </div>
                                    </div>
                                    
                                    <div class="ml-4 flex flex-col items-end space-y-2">
                                        <% if (registration.status === 'approved') { %>
                                            <span class="px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full">
                                                <i class="fas fa-check mr-1"></i>Approved
                                            </span>
                                            
                                            <% const eventDateTime = new Date(`${event.date.toISOString().split('T')[0]}T${event.startTime}`); %>
                                            <% const now = new Date(); %>
                                            <% const hoursUntilEvent = (eventDateTime - now) / (1000 * 60 * 60); %>
                                            
                                            <% if (hoursUntilEvent > 24) { %>
                                                <form method="POST" action="/student/registrations/<%= event._id %>/cancel" 
                                                      onsubmit="return confirm('Are you sure you want to cancel this registration?')">
                                                    <button type="submit" class="px-3 py-1 bg-red-100 text-red-800 text-sm rounded hover:bg-red-200">
                                                        <i class="fas fa-times mr-1"></i>Cancel
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full">
                                                    <i class="fas fa-lock mr-1"></i>Locked
                                                </span>
                                            <% } %>
                                            
                                        <% } else if (registration.status === 'pending') { %>
                                            <span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-sm rounded-full">
                                                <i class="fas fa-clock mr-1"></i>Pending
                                            </span>
                                            <p class="text-xs text-gray-500 mt-1">Awaiting approval</p>
                                            
                                        <% } else if (registration.status === 'rejected') { %>
                                            <span class="px-3 py-1 bg-red-100 text-red-800 text-sm rounded-full">
                                                <i class="fas fa-times mr-1"></i>Rejected
                                            </span>
                                            <p class="text-xs text-gray-500 mt-1">Contact organizer</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <i class="fas fa-ticket-alt text-gray-400 text-5xl mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">No Registrations Found</h3>
                        <p class="text-gray-500 mb-4">
                            <% if (filters.status) { %>
                                No registrations with status "<%= filters.status %>" found.
                            <% } else { %>
                                You haven't registered for any events yet.
                            <% } %>
                        </p>
                        <a href="/student/events" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700">
                            <i class="fas fa-search mr-2"></i>Browse Events
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
