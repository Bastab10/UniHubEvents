<%- include('../partials/header') %>

<style>
/* Responsive Dashboard Styles */
.dashboard-container {
    min-height: 100vh;
    background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
}

@media (max-width: 768px) {
    .dashboard-container {
        background: #f9fafb;
    }
}

/* Mobile text color fixes */
@media (max-width: 640px) {
    .dashboard-container h1 {
        color: #1f2937 !important; /* Force dark gray */
    }
    
    .dashboard-container p {
        color: #4b5563 !important; /* Force medium gray */
    }
    
    /* Input field mobile fixes */
    input[type="text"] {
        color: #000000 !important; /* Force black text */
        background-color: #ffffff !important; /* Force white background */
    }
    
    input[type="text"]::placeholder {
        color: #6b7280 !important; /* Gray placeholder */
        opacity: 1 !important; /* Force full opacity */
    }
    
    /* Select dropdown mobile fixes */
    select {
        color: #000000 !important; /* Force black text */
        background-color: #ffffff !important; /* Force white background */
    }
    
    select option {
        color: #000000 !important; /* Force black text for options */
        background-color: #ffffff !important; /* Force white background for options */
    }
    
    /* Label text mobile fixes */
    label {
        color: #374151 !important; /* Force dark gray for labels */
    }
}
</style>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="p-4 sm:p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-800">Browse Events</h1>
                <p class="text-gray-700 sm:text-gray-600">Discover and register for exciting events</p>
            </div>

            <!-- Search and Filters -->
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <form method="GET" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search Events</label>
                            <input type="text" id="search" name="search" value="<%= filters.search || '' %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-gray-900"
                                   placeholder="Search by title, description, venue...">
                        </div>
                        <div>
                            <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                            <select id="category" name="category" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-gray-900">
                                <option value="">All Categories</option>
                                <option value="seminar" <%= filters.category === 'seminar' ? 'selected' : '' %>>Seminars</option>
                                <option value="workshop" <%= filters.category === 'workshop' ? 'selected' : '' %>>Workshops</option>
                                <option value="hackathon" <%= filters.category === 'hackathon' ? 'selected' : '' %>>Hackathons</option>
                                <option value="quiz" <%= filters.category === 'quiz' ? 'selected' : '' %>>Quizzes</option>
                                <option value="talkshow" <%= filters.category === 'talkshow' ? 'selected' : '' %>>Talk Shows</option>
                                <option value="bootcamp" <%= filters.category === 'bootcamp' ? 'selected' : '' %>>Bootcamps</option>
                                <option value="cultural" <%= filters.category === 'cultural' ? 'selected' : '' %>>Cultural</option>
                                <option value="sports" <%= filters.category === 'sports' ? 'selected' : '' %>>Sports</option>
                            </select>
                        </div>
                        <div class="flex items-end">
                            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
                                <i class="fas fa-search mr-2"></i>Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Events Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% if (events && events.length > 0) { %>
                    <% events.forEach(event => { %>
                        <div class="bg-white rounded-lg shadow-md overflow-hidden card-hover">
                            <% if (event.poster) { %>
                                <img src="<%= event.poster %>" alt="<%= event.title %>" class="w-full h-48 object-cover">
                            <% } else { %>
                                <div class="w-full h-48 bg-gradient-to-br from-blue-400 to-purple-600 flex items-center justify-center">
                                    <i class="fas fa-calendar-alt text-white text-4xl"></i>
                                </div>
                            <% } %>
                            
                            <div class="p-4">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="text-lg font-semibold text-gray-800"><%= event.title %></h3>
                                    <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                        <%= event.category %>
                                    </span>
                                </div>
                                
                                <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= event.description %></p>
                                
                                <div class="space-y-1 text-sm text-gray-600 mb-3">
                                    <p><i class="fas fa-calendar-alt mr-2"></i><%= new Date(event.date).toLocaleDateString() %></p>
                                    <p><i class="fas fa-clock mr-2"></i><%= event.startTime %> - <%= event.endTime %></p>
                                    <p><i class="fas fa-map-marker-alt mr-2"></i><%= event.venue %></p>
                                    <p><i class="fas fa-user mr-2"></i><%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %></p>
                                </div>
                                
                                <div class="flex justify-between items-center">
                                    <span class="text-sm text-gray-500">
                                        <% if (event.maxParticipants) { %>
                                            <%= event.registrations.length %>/<%= event.maxParticipants %> registered
                                        <% } else { %>
                                            <%= event.registrations.length %> registered
                                        <% } %>
                                    </span>
                                    
                                    <% const isRegistered = event.registrations.some(reg => reg.student._id.toString() === studentId.toString()); %>
                                    <% if (isRegistered) { %>
                                        <span class="px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full">
                                            Registered
                                        </span>
                                    <% } else { %>
                                        <a href="/student/events/<%= event._id %>" class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">
                                            View Details
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full text-center py-12">
                        <i class="fas fa-calendar-times text-gray-400 text-5xl mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">No Events Found</h3>
                        <p class="text-gray-500">Try adjusting your search criteria or check back later for new events.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
