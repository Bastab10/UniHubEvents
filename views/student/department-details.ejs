<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Back Button -->
        <div class="mb-6">
            <a href="/student/leaderboard" class="inline-flex items-center text-gray-600 hover:text-gray-800 font-medium">
                <i class="fas fa-arrow-left mr-2"></i>
                Back to Leaderboard
            </a>
        </div>

        <!-- Department Summary Card -->
        <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6 <%= isUserDepartment ? 'border-l-4 border-l-blue-500' : '' %>">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="w-20 h-20 rounded-full bg-gradient-to-br <%= rank === 1 ? 'from-amber-400 to-orange-500' : rank === 2 ? 'from-gray-400 to-gray-600' : rank === 3 ? 'from-orange-400 to-orange-600' : 'from-blue-500 to-purple-600' %> flex items-center justify-center text-white text-3xl font-bold mr-6">
                        <%= department.department.charAt(0) %>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Department</p>
                        <h1 class="text-3xl font-bold text-gray-800"><%= department.department %></h1>
                        <% if (isUserDepartment) { %>
                            <span class="inline-block mt-1 px-3 py-1 bg-blue-100 text-blue-800 text-sm rounded-full font-medium">
                                Your Department
                            </span>
                        <% } %>
                    </div>
                </div>
                <div class="text-right">
                    <div class="flex items-center justify-end mb-2">
                        <span class="text-5xl font-bold <%= rank === 1 ? 'text-amber-600' : rank === 2 ? 'text-gray-700' : rank === 3 ? 'text-orange-600' : 'text-gray-800' %>">#<%= rank %></span>
                    </div>
                    <p class="text-sm text-gray-500">Current Rank</p>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-gray-200">
                <div class="text-center">
                    <p class="text-3xl font-bold text-gray-800"><%= department.totalPoints %></p>
                    <p class="text-sm text-gray-500">Total Points</p>
                </div>
                <div class="text-center border-l border-gray-200">
                    <p class="text-3xl font-bold text-gray-800"><%= department.eventBreakdown ? department.eventBreakdown.length : 0 %></p>
                    <p class="text-sm text-gray-500">Events Participated</p>
                </div>
                <div class="text-center border-l border-gray-200">
                    <% 
                        const firstPlaces = department.eventBreakdown ? department.eventBreakdown.filter(e => e.position === 'first').length : 0;
                        const secondPlaces = department.eventBreakdown ? department.eventBreakdown.filter(e => e.position === 'second').length : 0;
                        const thirdPlaces = department.eventBreakdown ? department.eventBreakdown.filter(e => e.position === 'third').length : 0;
                    %>
                    <p class="text-3xl font-bold text-gray-800"><%= firstPlaces %>/<%= secondPlaces %>/<%= thirdPlaces %></p>
                    <p class="text-sm text-gray-500">🥇/🥈/🥉 Wins</p>
                </div>
            </div>
        </div>

        <!-- Event Breakdown -->
        <div class="bg-white rounded-lg border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-800">
                    <i class="fas fa-trophy text-amber-500 mr-2"></i>
                    Event Performance
                </h2>
                <span class="text-sm text-gray-500">
                    <%= department.eventBreakdown ? department.eventBreakdown.length : 0 %> events
                </span>
            </div>

            <% if (department.eventBreakdown && department.eventBreakdown.length > 0) { %>
            <div class="divide-y divide-gray-200">
                <% department.eventBreakdown.forEach((event) => { %>
                <div class="px-6 py-4 hover:bg-gray-50">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="mr-4">
                                <% if (event.position === 'first') { %>
                                    <span class="inline-flex items-center justify-center w-10 h-10 bg-amber-100 text-amber-800 rounded-full text-lg">🥇</span>
                                <% } else if (event.position === 'second') { %>
                                    <span class="inline-flex items-center justify-center w-10 h-10 bg-gray-100 text-gray-700 rounded-full text-lg">🥈</span>
                                <% } else { %>
                                    <span class="inline-flex items-center justify-center w-10 h-10 bg-orange-100 text-orange-800 rounded-full text-lg">🥉</span>
                                <% } %>
                            </div>
                            <div>
                                <h3 class="text-base font-medium text-gray-900">
                                    <%= event.eventTitle || 'Event' %>
                                </h3>
                                <p class="text-sm text-gray-500">
                                    <%= event.date ? new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '' %>
                                    <% if (event.event && event.event.category) { %>
                                        <span class="mx-2">•</span>
                                        <span class="capitalize"><%= event.event.category %></span>
                                    <% } %>
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold <%= event.position === 'first' ? 'bg-amber-100 text-amber-800' : event.position === 'second' ? 'bg-gray-100 text-gray-700' : 'bg-orange-100 text-orange-800' %>">
                                +<%= event.points %> points
                            </span>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="text-center py-12">
                <div class="text-5xl mb-4">📋</div>
                <h3 class="text-lg font-medium text-gray-900">No Events Yet</h3>
                <p class="text-gray-500 mt-2">This department hasn't participated in any Versity Week events yet.</p>
            </div>
            <% } %>
        </div>

    </div>

    <%- include('../partials/footer') %>
</body>
</html>
