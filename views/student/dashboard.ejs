<%- include('../partials/header') %>

<style>
/* Responsive Dashboard Styles */
.dashboard-container {
    min-height: 100vh;
    background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
}

@media (max-width: 768px) {
    .dashboard-container {
        background: #f9fafb;
    }
}

.welcome-section {
    background: linear-gradient(135deg, white 0%, white);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

@media (max-width: 640px) {
    .welcome-section {
        padding: 1rem;
        border-radius: 0.75rem;
    }
    
    .welcome-section h1 {
        font-size: 1.5rem !important;
        color: #1f2937 !important; /* Force dark color on mobile */
    }
    
    .welcome-section p {
        font-size: 1rem !important;
        color: #4b5563 !important; /* Force dark color on mobile */
    }
}

/* Mobile text color fixes */
@media (max-width: 640px) {
    .dashboard-container h2 {
        color: #1f2937 !important; /* Force dark gray */
    }
    
    .dashboard-container p {
        color: #4b5563 !important; /* Force medium gray */
    }
    
    /* Filter button mobile fixes */
    .category-btn.active {
        background-color: #dabbf2 !important; /* Force blue background */
        color: #ffffff !important; /* Force white text */
    }
    
    .category-btn.bg-blue-600 {
        background-color: #d1aee2 !important; /* Force blue background */
        color: #ffffff !important; /* Force white text */
    }
}

/* Category button fade effects (no blur) */
.category-btn {
    transition: all 0.3s ease !important;
    position: relative;
}

.category-btn:not(.active) {
    opacity: 0.7;
    transform: scale(0.95);
    color: #000000 !important; /* Force black text */
}

.category-btn:not(.active):hover {
    opacity: 0.9;
    transform: scale(0.98);
}

.category-btn.active {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    z-index: 10;
}

/* Smooth transitions for all states */
.category-btn {
    transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease, color 0.3s ease !important;
}

.stats-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(1, 1fr);
}

@media (min-width: 768px) {
    .stats-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
}

.stat-card {
    background: white;
    border-radius: 0.75rem;
    padding: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    border-left: 4px solid;
}

@media (max-width: 640px) {
    .stat-card {
        padding: 0.75rem;
    }
}

.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
}

.events-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(1, 1fr);
}

@media (min-width: 768px) {
    .events-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }
}

@media (min-width: 1024px) {
    .events-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }
}

@media (max-width: 640px) {
    .events-grid {
        gap: 1rem;
    }
}

.event-card {
    background: white;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
}

.event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.1);
}

@media (max-width: 640px) {
    .event-card {
        border-radius: 0.5rem;
    }
}

.event-image {
    height: 12rem;
    background: #e5e7eb;
    position: relative;
    overflow: hidden;
}

@media (max-width: 640px) {
    .event-image {
        height: 10rem;
    }
}

.event-content {
    padding: 1rem;
}

@media (max-width: 640px) {
    .event-content {
        padding: 0.75rem;
    }
}

.event-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #1f2937;
    line-height: 1.4;
}

@media (max-width: 640px) {
    .event-title {
        font-size: 1rem;
    }
}

.event-description {
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Fallback for browsers that don't support line-clamp */
    display: -moz-box;
    -moz-line-clamp: 2;
    -moz-box-orient: vertical;
    display: box;
    line-clamp: 2;
    box-orient: vertical;
}

@media (max-width: 640px) {
    .event-description {
        font-size: 0.8rem;
    }
}

.event-details {
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #6b7280;
}

@media (max-width: 640px) {
    .event-details {
        font-size: 0.8rem;
        gap: 0.375rem;
    }
}

.category-badge {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    border-radius: 9999px;
    font-weight: 500;
    text-transform: capitalize;
}

@media (max-width: 640px) {
    .category-badge {
        padding: 0.1875rem 0.375rem;
        font-size: 0.6875rem;
    }
}

.view-details-btn {
    background: linear-gradient(135deg, #648ce1, #3b82f6);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
}

.view-details-btn:hover {
    background: linear-gradient(135deg, #1d4ed8, #2563eb);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
}

@media (max-width: 640px) {
    .view-details-btn {
        padding: 0.375rem 0.75rem;
        font-size: 0.8rem;
    }
}

.no-events {
    text-align: center;
    padding: 3rem 1rem;
}

@media (max-width: 640px) {
    .no-events {
        padding: 2rem 1rem;
    }
}

/* Prevent horizontal scrolling */
* {
    max-width: 100%;
    box-sizing: border-box;
}

body {
    overflow-x: hidden;
}

/* Responsive text */
.responsive-text-2xl {
    font-size: 1.5rem;
    line-height: 2rem;
}

@media (min-width: 768px) {
    .responsive-text-2xl {
        font-size: 1.875rem;
        line-height: 2.25rem;
    }
}

.responsive-text-3xl {
    font-size: 1.875rem;
    line-height: 2.25rem;
}

@media (min-width: 768px) {
    .responsive-text-3xl {
        font-size: 3rem;
        line-height: 1;
    }
}
</style>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="p-4 sm:p-6">
            <!-- Welcome Section -->
            <h2 class="responsive-text-3xl font-bold mb-2 text-gray-800">Welcome back, <%= currentUser.profile.firstName %>!</h2>
            <p class="text-gray-700 sm:text-gray-600 text-base sm:text-lg mb-6 sm:mb-8">Here's your personalized dashboard overview</p>

            <!-- Events Section -->
            <!-- Category Filter Buttons -->
            <div class="flex flex-wrap gap-2 mb-6">
                <button onclick="filterEvents('all')" class="category-btn active px-4 py-2 rounded-full text-sm font-medium transition-colors bg-[#be8cdf] text-white">
                    All Events
                </button>
                <button onclick="filterEvents('seminar')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Seminars
                </button>
                <button onclick="filterEvents('workshop')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Workshops
                </button>
                <button onclick="filterEvents('hackathon')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Hackathons
                </button>
                <button onclick="filterEvents('quiz')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Quizzes
                </button>
                <button onclick="filterEvents('talkshow')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Talk Shows
                </button>
                <button onclick="filterEvents('bootcamp')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Bootcamps
                </button>
                <button onclick="filterEvents('cultural')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Cultural
                </button>
                <button onclick="filterEvents('sports')" class="category-btn px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-200 text-gray-700 hover:bg-gray-300">
                    Sports
                </button>
            </div>

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 space-y-4 sm:space-y-0">
                <h2 class="responsive-text-2xl font-bold text-gray-800 flex items-center">
                    <!-- <i class="fas fa-calendar-alt mr-3 text-blue-600"></i> -->
                    Available <span id="category-title">ALL</span> Events
                </h2>
                <div class="flex items-center space-x-2 sm:space-x-4">
                    <span class="text-xs sm:text-sm text-gray-500">Total Events</span>
                    <span id="event-count" class="text-lg sm:text-xl font-bold text-blue-600"><%= allEvents.length %></span>
                </div>
            </div>
            
            <% if (allEvents && allEvents.length > 0) { %>
                <div class="events-grid">
                        <% allEvents.forEach((event, index) => { %>
                            <div class="event-card group" data-category="<%= event.category || 'other' %>">
                                <!-- Event Image -->
                                <div class="event-image">
                                    <% if (event.poster && event.poster.trim() !== '') { %>
                                        <img src="/uploads/<%= event.poster %>" 
                                             alt="<%= event.title %>" 
                                             class="w-full h-full object-cover"
                                             style="object-fit: cover;">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-100 to-purple-100">
                                            <div class="text-center">
                                                <i class="fas fa-calendar-alt text-4xl text-blue-600 mb-2"></i>
                                                <p class="text-blue-600 text-sm">No poster uploaded</p>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                                
                                <!-- Event Content -->
                                <div class="event-content">
                                    <!-- Title and Category Badge -->
                                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
                                        <h3 class="event-title mb-2 sm:mb-0 sm:mr-2">
                                            <%= event.title %>
                                        </h3>
                                        <% if (event.category) { %>
                                            <span class="category-badge ml-0 sm:ml-2 flex-shrink-0
                                                <% if (event.category === 'sports') { %>
                                                    bg-green-100 text-green-800
                                                <% } else if (event.category === 'workshop') { %>
                                                    bg-blue-100 text-blue-800
                                                <% } else if (event.category === 'cultural') { %>
                                                    bg-purple-100 text-purple-800
                                                <% } else if (event.category === 'seminar') { %>
                                                    bg-yellow-100 text-yellow-800
                                                <% } else { %>
                                                    bg-gray-100 text-gray-800
                                                <% } %>
                                            ">
                                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                            </span>
                                        <% } %>
                                    </div>
                                    
                                    <!-- Description -->
                                    <p class="event-description mb-3">
                                        <%= event.description || 'No description available' %>
                                    </p>
                                    
                                    <!-- Event Details -->
                                    <div class="event-details mb-4">
                                        <div class="flex items-center">
                                            <i class="fas fa-calendar mr-2 text-gray-400"></i>
                                            <span><%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-clock mr-2 text-gray-400"></i>
                                            <span><%= event.startTime %> - <%= event.endTime %></span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-map-marker-alt mr-2 text-gray-400"></i>
                                            <span><%= event.venue %></span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-user mr-2 text-gray-400"></i>
                                            <span><%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %></span>
                                        </div>
                                        <div class="flex items-center">
                                            <i class="fas fa-users mr-2 text-gray-400"></i>
                                            <span><%= event.registrations ? event.registrations.length : 0 %> / <%= event.maxParticipants || 'Unlimited' %> registered</span>
                                        </div>
                                    </div>
                                    
                                    <!-- View Details Button -->
                                    <div class="flex justify-end">
                                        <a href="/student/events/<%= event._id %>" class="view-details-btn">
                                            View Details
                                            <i class="fas fa-arrow-right ml-2"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="no-events">
                        <i class="fas fa-calendar-times text-gray-300 text-6xl mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">No Events Available</h3>
                        <p class="text-gray-500">There are currently no events available. Check back later for new events!</p>
                    </div>
                <% } %>
        </div>
    </main>
</div>

<script>
// Category filtering functionality
function filterEvents(category) {
    const eventCards = document.querySelectorAll('.event-card');
    const categoryButtons = document.querySelectorAll('.category-btn');
    const categoryTitle = document.getElementById('category-title');
    const eventCount = document.getElementById('event-count');
    
    // Update active button styling - ensure only one active button
    categoryButtons.forEach(btn => {
        // Remove all active classes and styles
        btn.classList.remove('bg-[#be8cdf]', 'text-white', 'active');
        btn.classList.add('bg-gray-200', 'text-gray-700');
        
        // Apply inactive button styles
        btn.style.opacity = '0.7';
        btn.style.transform = 'scale(0.95)';
        btn.style.color = '#000000';
        btn.style.boxShadow = 'none';
        btn.style.backgroundColor = '#f3f4f6';
    });
    
    // Find and activate the clicked button
    let activeButton = null;
    
    // More reliable selector method
    categoryButtons.forEach(btn => {
        const onclickAttr = btn.getAttribute('onclick');
        if (onclickAttr && onclickAttr.includes(`filterEvents('${category}')`)) {
            activeButton = btn;
            return false; // Exit the loop
        }
    });
    
    // Apply active button styles
    if (activeButton) {
        // Remove inactive classes
        activeButton.classList.remove('bg-gray-200', 'text-gray-700');
        
        // Add active classes
        activeButton.classList.add('bg-[#be8cdf]', 'text-white', 'active');
        
        // Apply active button styles
        activeButton.style.opacity = '1';
        activeButton.style.transform = 'scale(1)';
        activeButton.style.color = '#ffffff';
        activeButton.style.boxShadow = '0 4px 12px rgba(190, 140, 223, 0.3)';
        activeButton.style.backgroundColor = '#be8cdf';
        
        // Force mobile styles
        if (window.innerWidth <= 640) {
            activeButton.style.backgroundColor = '#be8cdf';
            activeButton.style.color = '#ffffff';
        }
    }
    
    // Update category title
    if (category === 'all') {
        categoryTitle.textContent = 'ALL';
    } else {
        categoryTitle.textContent = category.charAt(0).toUpperCase() + category.slice(1);
    }
    
    // Filter events
    let visibleCount = 0;
    eventCards.forEach(card => {
        const eventCategory = card.getAttribute('data-category');
        
        if (category === 'all' || eventCategory === category) {
            card.style.display = 'block';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });
    
    // Update event count
    eventCount.textContent = visibleCount;
    
    // Show/hide no events message
    const eventsGrid = document.querySelector('.events-grid');
    const noEventsMessage = document.querySelector('.no-events');
    
    if (visibleCount === 0 && eventsGrid) {
        if (noEventsMessage) {
            noEventsMessage.style.display = 'block';
            noEventsMessage.innerHTML = `
                <i class="fas fa-calendar-times text-gray-300 text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No ${category === 'all' ? '' : category.charAt(0).toUpperCase() + category.slice(1) + ' '}Events Available</h3>
                <p class="text-gray-500">There are currently no ${category === 'all' ? '' : category + ' '}events available. Check back later for new events!</p>
            `;
        }
    } else if (noEventsMessage) {
        noEventsMessage.style.display = 'none';
    }
}

// Search functionality for events
function searchEventsOnDashboard(searchTerm) {
    const eventCards = document.querySelectorAll('.event-card');
    const eventCount = document.getElementById('event-count');
    const categoryTitle = document.getElementById('category-title');
    const noEventsMessage = document.querySelector('.no-events');
    
    // Reset category filters
    const categoryButtons = document.querySelectorAll('.category-btn');
    categoryButtons.forEach(btn => {
        btn.classList.remove('bg-[#be8cdf]', 'text-white');
        btn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
    });
    
    // Set "All Events" button as active
    const allEventsBtn = Array.from(categoryButtons).find(btn => {
        const onclickAttr = btn.getAttribute('onclick');
        return onclickAttr && onclickAttr.includes("filterEvents('all')");
    });
    if (allEventsBtn) {
        allEventsBtn.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
        allEventsBtn.classList.add('bg-[#be8cdf]', 'text-white');
    }
    
    categoryTitle.textContent = 'SEARCH RESULTS';
    
    if (!searchTerm) {
        // Show all events if search is empty
        eventCards.forEach(card => {
            card.style.display = 'block';
        });
        eventCount.textContent = eventCards.length;
        
        if (noEventsMessage) {
            noEventsMessage.style.display = 'none';
        }
        return;
    }
    
    // Convert search term to lowercase for case-insensitive search
    const searchLower = searchTerm.toLowerCase();
    let visibleCount = 0;
    
    eventCards.forEach(card => {
        // Get event details from the card
        const title = card.querySelector('.event-title')?.textContent.toLowerCase() || '';
        const description = card.querySelector('.event-description')?.textContent.toLowerCase() || '';
        const venue = card.querySelector('.event-venue')?.textContent.toLowerCase() || '';
        const category = card.getAttribute('data-category')?.toLowerCase() || '';
        
        // Check if search term matches any field
        if (title.includes(searchLower) || 
            description.includes(searchLower) || 
            venue.includes(searchLower) || 
            category.includes(searchLower)) {
            card.style.display = 'block';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });
    
    // Update event count
    eventCount.textContent = visibleCount;
    
    // Show/hide no events message
    if (visibleCount === 0) {
        if (noEventsMessage) {
            noEventsMessage.style.display = 'block';
            noEventsMessage.innerHTML = `
                <i class="fas fa-search text-gray-300 text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No events found matching your search.</h3>
                <p class="text-gray-500">Try searching with different keywords or check back later for new events!</p>
            `;
        }
    } else if (noEventsMessage) {
        noEventsMessage.style.display = 'none';
    }
}

// Check for search parameter in URL and perform search on page load
document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const searchParam = urlParams.get('search');
    
    if (searchParam) {
        // Set search input value
        const headerSearchInput = document.getElementById('headerSearchInput');
        if (headerSearchInput) {
            headerSearchInput.value = searchParam;
        }
        
        // Perform search
        searchEventsOnDashboard(searchParam);
    }
});

// Make searchEventsOnDashboard function globally accessible
window.searchEventsOnDashboard = searchEventsOnDashboard;
</script>

<%- include('../partials/footer') %>
