<%- include('../partials/header') %>

<div class="flex h-screen">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1 overflow-y-auto">
        <div class="p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-800">Participation History</h1>
                <p class="text-gray-600">View your past event participation</p>
            </div>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex items-center">
                        <div class="p-3 bg-blue-100 rounded-full">
                            <i class="fas fa-calendar text-blue-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm text-gray-500">Total Events</p>
                            <p class="text-2xl font-bold text-gray-800"><%= events.length %></p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex items-center">
                        <div class="p-3 bg-green-100 rounded-full">
                            <i class="fas fa-chalkboard-teacher text-green-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm text-gray-500">Seminars</p>
                            <p class="text-2xl font-bold text-gray-800">
                                <%= events.filter(e => e.category === 'seminar').length %>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex items-center">
                        <div class="p-3 bg-purple-100 rounded-full">
                            <i class="fas fa-tools text-purple-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm text-gray-500">Workshops</p>
                            <p class="text-2xl font-bold text-gray-800">
                                <%= events.filter(e => e.category === 'workshop').length %>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex items-center">
                        <div class="p-3 bg-yellow-100 rounded-full">
                            <i class="fas fa-football-ball text-yellow-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm text-gray-500">Sports</p>
                            <p class="text-2xl font-bold text-gray-800">
                                <%= events.filter(e => e.category === 'sports').length %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Events List -->
            <div class="bg-white rounded-lg shadow-md">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-800">Past Events</h2>
                </div>
                
                <% if (events && events.length > 0) { %>
                    <div class="divide-y divide-gray-200">
                        <% events.forEach(event => { %>
                            <div class="p-6 hover:bg-gray-50">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <div class="flex items-center mb-2">
                                            <h3 class="text-lg font-semibold text-gray-800 mr-3"><%= event.title %></h3>
                                            <span class="px-2 py-1 text-xs font-medium 
                                                <% if (event.category === 'seminar') { %>bg-blue-100 text-blue-800<% } else if (event.category === 'workshop') { %>bg-green-100 text-green-800<% } else if (event.category === 'cultural') { %>bg-purple-100 text-purple-800<% } else { %>bg-yellow-100 text-yellow-800<% } %> rounded-full">
                                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                            </span>
                                        </div>
                                        
                                        <p class="text-gray-600 mb-3"><%= event.description %></p>
                                        
                                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm text-gray-600">
                                            <div>
                                                <i class="fas fa-calendar-alt mr-2"></i>
                                                <%= new Date(event.date).toLocaleDateString() %>
                                            </div>
                                            <div>
                                                <i class="fas fa-clock mr-2"></i>
                                                <%= event.startTime %> - <%= event.endTime %>
                                            </div>
                                            <div>
                                                <i class="fas fa-map-marker-alt mr-2"></i>
                                                <%= event.venue %>
                                            </div>
                                            <div>
                                                <i class="fas fa-user mr-2"></i>
                                                <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                            </div>
                                        </div>

                                        <% if (event.registrations && event.registrations.length > 0) { %>
                                            <% const registration = event.registrations[0]; %>
                                            <div class="mt-3 p-3 bg-gray-50 rounded">
                                                <p class="text-sm font-medium text-gray-700 mb-1">Registration Details:</p>
                                                <% if (registration.teamName) { %>
                                                    <p class="text-sm text-gray-600"><strong>Team:</strong> <%= registration.teamName %></p>
                                                    <% if (registration.teamMembers && registration.teamMembers.length > 0) { %>
                                                        <p class="text-sm text-gray-600"><strong>Members:</strong> 
                                                            <%= registration.teamMembers.map(m => m.name).join(', ') %>
                                                        </p>
                                                    <% } %>
                                                <% } else { %>
                                                    <p class="text-sm text-gray-600"><strong>Type:</strong> Individual Registration</p>
                                                <% } %>
                                                <p class="text-sm text-gray-600"><strong>Registered:</strong> 
                                                    <%= new Date(registration.registeredAt).toLocaleDateString() %>
                                                </p>
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                    <div class="ml-4 flex flex-col items-end space-y-2">
                                        <span class="px-3 py-1 bg-gray-100 text-gray-800 text-sm rounded-full">
                                            Completed
                                        </span>
                                        
                                        <% if (event.isCompleted) { %>
                                            <span class="px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full">
                                                <i class="fas fa-check mr-1"></i>Attended
                                            </span>
                                        <% } else { %>
                                            <span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-sm rounded-full">
                                                <i class="fas fa-clock mr-1"></i>Pending
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <i class="fas fa-history text-gray-400 text-5xl mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">No Participation History</h3>
                        <p class="text-gray-500">You haven't participated in any events yet. Start exploring and register for upcoming events!</p>
                        <a href="/student/events" class="inline-block mt-4 bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700">
                            <i class="fas fa-search mr-2"></i>Browse Events
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
