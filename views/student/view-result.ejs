<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <% if (result) { %>
        <!-- Results Card -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <!-- Header -->
            <div class="bg-white border-b border-gray-200 py-6 px-4 sm:px-6 lg:px-8 -mx-6 -mt-6 rounded-t-lg">
                <div class="text-center">
                    <h1 class="text-2xl font-semibold text-gray-800"><%= event.title %></h1>
                    <p class="mt-1 text-gray-500 text-sm">
                        <%= new Date(event.date).toLocaleDateString('en-US', {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        }) %>
                    </p>
                </div>
            </div>

            <!-- Results Section -->
            <div class="pt-6">
                <div class="flex items-center justify-center mb-6">
                    <i class="fas fa-trophy text-amber-500 mr-2"></i>
                    <h2 class="text-lg font-semibold text-gray-800 uppercase tracking-wide">Event Results</h2>
                </div>

                <!-- Winners Grid -->
                <div class="grid gap-4 md:grid-cols-3">
                    <!-- 1st Position -->
                    <div class="border border-gray-200 rounded-lg p-4 text-center">
                        <div class="text-2xl mb-2">🥇</div>
                        <div class="text-sm font-medium text-amber-600 mb-3">First Place</div>

                        <div class="text-base font-semibold text-gray-900 mb-2">
                            <%= result.firstPosition.name %>
                        </div>

                        <% if (result.firstPosition.department) { %>
                            <div class="text-sm text-gray-600 mb-1">
                                <%= result.firstPosition.department %>
                            </div>
                        <% } %>

                        <% if (result.firstPosition.collegeId) { %>
                            <div class="text-sm text-gray-500 mb-1">
                                ID: <%= result.firstPosition.collegeId %>
                            </div>
                        <% } %>

                        <% if (result.firstPosition.points) { %>
                            <div class="mt-3">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-amber-100 text-amber-800">
                                    <%= result.firstPosition.points %> Points
                                </span>
                            </div>
                        <% } %>
                    </div>

                    <!-- 2nd Position -->
                    <div class="border border-gray-200 rounded-lg p-4 text-center">
                        <div class="text-2xl mb-2">🥈</div>
                        <div class="text-sm font-medium text-gray-600 mb-3">Second Place</div>

                        <div class="text-base font-semibold text-gray-900 mb-2">
                            <%= result.secondPosition.name %>
                        </div>

                        <% if (result.secondPosition.department) { %>
                            <div class="text-sm text-gray-600 mb-1">
                                <%= result.secondPosition.department %>
                            </div>
                        <% } %>

                        <% if (result.secondPosition.collegeId) { %>
                            <div class="text-sm text-gray-500 mb-1">
                                ID: <%= result.secondPosition.collegeId %>
                            </div>
                        <% } %>

                        <% if (result.secondPosition.points) { %>
                            <div class="mt-3">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-700">
                                    <%= result.secondPosition.points %> Points
                                </span>
                            </div>
                        <% } %>
                    </div>

                    <!-- 3rd Position -->
                    <div class="border border-gray-200 rounded-lg p-4 text-center">
                        <div class="text-2xl mb-2">🥉</div>
                        <div class="text-sm font-medium text-orange-700 mb-3">Third Place</div>

                        <div class="text-base font-semibold text-gray-900 mb-2">
                            <%= result.thirdPosition.name %>
                        </div>

                        <% if (result.thirdPosition.department) { %>
                            <div class="text-sm text-gray-600 mb-1">
                                <%= result.thirdPosition.department %>
                            </div>
                        <% } %>

                        <% if (result.thirdPosition.collegeId) { %>
                            <div class="text-sm text-gray-500 mb-1">
                                ID: <%= result.thirdPosition.collegeId %>
                            </div>
                        <% } %>

                        <% if (result.thirdPosition.points) { %>
                            <div class="mt-3">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-orange-100 text-orange-800">
                                    <%= result.thirdPosition.points %> Points
                                </span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Event Information -->
            <div class="pt-6 border-t border-gray-200 mt-6">
                <h3 class="text-sm font-semibold text-gray-700 mb-4 uppercase tracking-wide">Event Information</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                    <div>
                        <span class="text-gray-500 block">Date</span>
                        <span class="font-medium text-gray-800"><%= new Date(event.date).toLocaleDateString() %></span>
                    </div>
                    <div>
                        <span class="text-gray-500 block">Time</span>
                        <span class="font-medium text-gray-800"><%= event.startTime %> - <%= event.endTime %></span>
                    </div>
                    <div>
                        <span class="text-gray-500 block">Venue</span>
                        <span class="font-medium text-gray-800"><%= event.venue %></span>
                    </div>
                    <div>
                        <span class="text-gray-500 block">Category</span>
                        <span class="font-medium text-gray-800 capitalize"><%= event.category %></span>
                    </div>
                </div>
            </div>

            <!-- Declared By -->
            <div class="pt-6 border-t border-gray-200 mt-6 flex justify-between items-center">
                <div>
                    <span class="text-gray-500 text-sm block">Declared By</span>
                    <span class="font-medium text-gray-800">
                        <%= coordinator.profile.firstName %> <%= coordinator.profile.lastName %>
                    </span>
                </div>
                <div class="text-right">
                    <span class="text-gray-500 text-sm block">Uploaded On</span>
                    <span class="font-medium text-gray-800">
                        <%= new Date(result.uploadedAt).toLocaleDateString() %>
                    </span>
                </div>
            </div>
        </div>

        <% } else { %>
        <!-- No Result Card -->
        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <div class="bg-white border-b border-gray-200 py-6 px-4 sm:px-6 lg:px-8 -mx-6 -mt-6 rounded-t-lg">
                <div class="text-center">
                    <h1 class="text-2xl font-semibold text-gray-800"><%= event.title %></h1>
                    <p class="mt-1 text-gray-500 text-sm">
                        <%= new Date(event.date).toLocaleDateString('en-US', {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        }) %>
                    </p>
                </div>
            </div>

            <div class="text-center py-16">
                <div class="text-6xl mb-4"></div>
                <h2 class="text-xl font-semibold text-gray-800 mb-2">Result Not Declared</h2>
                <p class="text-gray-500 mb-6">
                    The coordinator has not uploaded the results for this event yet.
                </p>
            </div>
        </div>
        <% } %>

    </div>

<%- include('../partials/footer') %>