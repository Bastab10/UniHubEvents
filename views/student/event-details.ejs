<%- include('../partials/header') %>

<div class="flex min-h-screen bg-gray-50">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="bg-gradient-to-r text-black  px-6 py-3">
                <div class="flex items-center">
                    <a href="/student/dashboard" class="text-black hover:text-gray-200 flex items-center mr-4">
                        <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
                    </a>
                </div>   
        </div>

        <div class="p-4 mx-auto max-w-4xl">
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        <span><%= success %></span>
                    </div>
                </div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <span><%= error %></span>
                    </div>
                </div>
            <% } %>
            
            <style>
                @media (max-width: 640px) {
                    input[type="text"] {
                        color: #000000 !important;
                        background-color: #ffffff !important;
                    }
                    
                    input[type="text"]::placeholder {
                        color: #6b7280 !important;
                        opacity: 1 !important;
                    }
                    
                    input[type="text"]:focus {
                        color: #000000 !important;
                    }
                    
                    input[type="text"]:focus::placeholder {
                        color: #9ca3af !important;
                    }
                }
            </style>
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-2xl shadow-lg p-5 border border-gray-200">
                        <% if (event.poster && event.poster.trim() !== '') { %>
                            <img src="<%= event.poster %>" alt="<%= event.title %>" class="w-full h-64 object-cover rounded-2xl mb-4 shadow-lg">
                        <% } else { %>
                            <div class="w-full h-64 bg-gradient-to-br from-blue-400 to-purple-600 rounded-2xl flex items-center justify-center mb-4 shadow-lg">
                                <div class="text-center text-white">
                                    <i class="fas fa-calendar-alt text-4xl mb-2"></i>
                                    <p class="text-sm font-semibold">No Poster</p>
                                </div>
                            </div>
                        <% } %>
                        <div class="text-center">
                            <span class="px-3 py-1 text-sm font-semibold rounded-full
                                <% if (event.category === 'seminar') { %>bg-blue-100 text-blue-800<% } 
                                   else if (event.category === 'workshop') { %>bg-green-100 text-green-800<% } 
                                   else if (event.category === 'cultural') { %>bg-purple-100 text-purple-800<% } 
                                   else if (event.category === 'sports') { %>bg-orange-100 text-orange-800<% }
                                   else { %>bg-gray-100 text-gray-800<% } %>">
                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                            </span>
                            <span class="px-3 py-1 text-sm font-semibold rounded-full bg-indigo-100 text-indigo-800 ml-1">
                                <%= event.eventType === 'team' ? 'Team' : 'Individual' %>
                            </span>
                        </div>
                        <% if (event.subCategory) { %>
                            <div class="text-center mt-2">
                                <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium">
                                    <i class="fas fa-football-ball mr-1"></i><%= event.subCategory %>
                                </span>
                            </div>
                        <% } %>
                        <div class="mt-4 text-center">
                            <p class="text-sm text-gray-500">Registrations</p>
                            <p class="text-2xl font-bold text-gray-800"><%= event.registrations ? event.registrations.length : 0 %></p>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-2 bg-white rounded-xl shadow-lg p-6 border border-gray-200">
                    <div class="flex items-center mb-4">
                        <div class="h-14 w-14 rounded-full bg-blue-100 flex items-center justify-center">
                            <i class="fas fa-calendar text-blue-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <h2 class="text-2xl font-bold text-gray-900"><%= event.title %></h2>
                        </div>
                    </div>

                    <div class="prose max-w-none text-gray-600 mb-4">
                        <p class="text-base leading-relaxed"><%= event.description %></p>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-2 gap-3 mb-4">
                        <div class="bg-blue-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-calendar-alt text-blue-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-blue-600 font-medium">Date</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                </div>
                            </div>
                        </div>
                         
                        <div class="bg-green-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-clock text-green-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-green-600 font-medium">Time</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= event.startTime %> - <%= event.endTime %></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-red-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-map-marker-alt text-red-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-red-600 font-medium">Venue</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= event.venue %></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-purple-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-user text-purple-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-purple-600 font-medium">Organizer</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (event.eventType === 'team') { %>
                        <div class="mb-4 p-3 bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg border border-blue-200">
                            <div class="flex items-center">
                                <i class="fas fa-users text-blue-600 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs font-medium text-blue-600">Team Event</p>
                                    <p class="text-sm font-semibold text-gray-800">Team Size: <%= event.teamSize %> members</p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <% const availableSpots = event.maxParticipants ? event.maxParticipants - event.registrations.length : null; %>
            <% const isPastEvent = new Date(event.date) < new Date(); %>
            
            <% if (process.env.NODE_ENV === 'development') { %>
                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-2 rounded mb-4 mx-auto max-w-3xl text-sm">
                    <div><strong>Debug Info:</strong></div>
                    <div>Current User ID: <%= currentUser._id %></div>
                    <div>Event ID: <%= event._id %></div>
                    <div>Is Registered (from route): <%= isRegistered %></div>
                    <div>Is Past Event: <%= isPastEvent %></div>
                    <div>Total Registrations: <%= event.registrations.length %></div>
                </div>
            <% } %>
            
            <%
                let deptTeamsCount = 0;
                let maxDeptTeams = event.maxTeamsPerDepartment || 0;
                let canRegisterMoreTeams = true;
                let remainingTeamSlots = 0;

                if (event.eventType === 'team' && currentUser.profile && currentUser.profile.department) {
                    const studentDept = currentUser.profile.department.toLowerCase();
                    deptTeamsCount = event.registrations.filter(
                        reg => reg.teamLeaderDepartment && reg.teamLeaderDepartment.toLowerCase() === studentDept
                    ).length;

                    if (maxDeptTeams > 0) {
                        remainingTeamSlots = maxDeptTeams - deptTeamsCount;
                        canRegisterMoreTeams = remainingTeamSlots > 0;
                    } else {
                        remainingTeamSlots = -1;
                        canRegisterMoreTeams = true;
                    }
                }

                const isIndividualRegistered = event.eventType !== 'team' && isRegistered;

                const isTeamLimitReached = event.eventType === 'team' && maxDeptTeams > 0 && remainingTeamSlots <= 0;
            %>

            <% if (isPastEvent) { %>
                <div class="bg-white rounded-lg shadow-md p-6 text-center">
                    <i class="fas fa-calendar-check text-gray-500 text-4xl mb-3"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Event Completed</h3>
                    <p class="text-gray-600">This event has already taken place.</p>
                    <div class="mt-4 inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 rounded-full">
                        <i class="fas fa-history mr-2"></i>
                        <span class="font-medium">Past Event</span>
                    </div>
                </div>
            <% } else if (isIndividualRegistered) { %>
                <div class="bg-white rounded-lg shadow-md p-6 text-center">
                    <i class="fas fa-check-circle text-green-500 text-4xl mb-3"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Already Registered</h3>
                    <div class="inline-flex items-center px-4 py-2 bg-green-100 text-green-800 rounded-full">
                        <i class="fas fa-ticket-alt mr-2"></i>
                        <span class="font-medium">Registration Confirmed</span>
                    </div>
                </div>
            <% } else if (event.eventType === 'team' && isRegistered) { %>
                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="text-center mb-6 pb-6 border-b border-gray-200">
                        <i class="fas fa-check-circle text-green-500 text-4xl mb-3"></i>
                        <h3 class="text-xl font-bold text-gray-800 mb-2">Already Registered</h3>
                        <div class="inline-flex items-center px-4 py-2 bg-green-100 text-green-800 rounded-full mb-3">
                            <i class="fas fa-ticket-alt mr-2"></i>
                            <span class="font-medium">Registration Confirmed</span>
                        </div>
                        <p class="text-gray-600">You can register more teams for this event if needed.</p>
                    </div>
                    
                    <div class="flex items-center mb-4">
                        <i class="fas fa-user-plus text-purple-600 text-xl mr-3"></i>
                        <h2 class="text-xl font-bold text-gray-800">Register Additional Teams</h2>
                    </div>
            <% } else if (isTeamLimitReached) { %>
                <div class="bg-white rounded-lg shadow-md p-6 text-center">
                    <i class="fas fa-ban text-orange-500 text-4xl mb-3"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Department Team Limit Reached</h3>
                    <p class="text-gray-600 mb-3">Maximum team limit reached for your department.</p>
                    <div class="bg-orange-50 border border-orange-200 rounded-lg p-3 mb-3">
                        <p class="text-sm text-orange-800">
                            <strong>Limit:</strong> <%= maxDeptTeams %> teams per department<br>
                            <strong>Registered from your dept:</strong> <%= deptTeamsCount %> teams
                        </p>
                    </div>
                </div>
            <% } else if (availableSpots !== null && availableSpots <= 0) { %>
                <div class="bg-white rounded-lg shadow-md p-6 text-center">
                    <i class="fas fa-times-circle text-red-500 text-4xl mb-3"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Event Full</h3>
                    <p class="text-gray-600">This event has reached maximum capacity</p>
                </div>
            <% } else { %>
                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex items-center mb-4">
                        <i class="fas fa-user-plus text-purple-600 text-xl mr-3"></i>
                        <h2 class="text-xl font-bold text-gray-800">Event Registration</h2>
                    </div>

                    <% if (event.eventType === 'team' && currentUser.profile && currentUser.profile.department) { %>
                        <div class="mb-4 p-4 rounded-lg border
                            <% if (maxDeptTeams > 0) { %>
                                <%= remainingTeamSlots > 0 ? 'bg-green-50 border-green-200' : 'bg-orange-50 border-orange-200' %>
                            <% } else { %>
                                bg-blue-50 border-blue-200
                            <% } %>">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-semibold
                                        <% if (maxDeptTeams > 0) { %>
                                            <%= remainingTeamSlots > 0 ? 'text-green-800' : 'text-orange-800' %>
                                        <% } else { %>
                                            text-blue-800
                                        <% } %>">
                                        <i class="fas fa-users mr-2"></i>
                                        Department: <%= currentUser.profile.department %>
                                    </p>
                                    <p class="text-xs mt-1
                                        <% if (maxDeptTeams > 0) { %>
                                            <%= remainingTeamSlots > 0 ? 'text-green-600' : 'text-orange-600' %>
                                        <% } else { %>
                                            text-blue-600
                                        <% } %>">
                                        <% if (maxDeptTeams > 0) { %>
                                            <strong><%= deptTeamsCount %></strong> team(s) registered from your department.
                                            <% if (remainingTeamSlots > 0) { %>
                                                You can register <strong><%= remainingTeamSlots %></strong> more team(s).
                                            <% } else { %>
                                                Limit reached (<%= maxDeptTeams %> teams max).
                                            <% } %>
                                        <% } else { %>
                                            <strong><%= deptTeamsCount %></strong> team(s) registered.
                                            Unlimited teams allowed per department.
                                        <% } %>
                                    </p>
                                </div>
                                <div class="text-center">
                                    <% if (maxDeptTeams > 0) { %>
                                        <div class="text-2xl font-bold
                                            <%= remainingTeamSlots > 0 ? 'text-green-600' : 'text-orange-600' %>">
                                            <%= remainingTeamSlots > 0 ? remainingTeamSlots : 0 %>
                                        </div>
                                        <div class="text-xs text-gray-500">slots left</div>
                                    <% } else { %>
                                        <div class="text-2xl font-bold text-blue-600">∞</div>
                                        <div class="text-xs text-gray-500">unlimited</div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <form method="POST" action="/student/events/<%= event._id %>/register" id="teamRegistrationForm">
                        <% if (event.eventType === 'team') { %>
                            <div id="teamsContainer">
                            </div>
                            
                            <div class="mt-4 text-center">
                                <button type="button" id="addTeamBtn" class="px-4 py-2 bg-[#0ea5a4] text-white rounded-lg hover:bg-[#0d9488] transition-colors font-medium border border-[#0ea5a4]">
                                    <i class="fas fa-plus mr-2"></i>Add Another Team
                                </button>
                                <p class="text-xs text-gray-500 mt-2">
                                    <% if (maxDeptTeams > 0) { %>
                                        You can register up to <%= remainingTeamSlots %> more team(s) from your department
                                    <% } else { %>
                                        Unlimited teams allowed per department
                                    <% } %>
                                </p>
                            </div>
                        <% } else { %>
                            <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 mb-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-2">Individual Registration</h3>
                                <p class="text-sm text-gray-600">Click the button below to register for this event.</p>
                            </div>
                        <% } %>

                        <div class="mt-6 text-center">
                            <button type="submit" class="px-6 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold rounded-lg hover:from-purple-700 hover:to-blue-700 transition-all transform hover:scale-105 shadow-md">
                                <i class="fas fa-check-circle mr-2"></i>
                                <% if (event.eventType === 'team') { %>Register All Teams<% } else { %>Register for Event<% } %>
                            </button>
                        </div>
                    </form>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
const maxTeamsPerDept = parseInt("<%= maxDeptTeams || 0 %>") || 0;
const currentDeptTeams = parseInt("<%= deptTeamsCount || 0 %>") || 0;
const remainingSlots = maxTeamsPerDept > 0 ? maxTeamsPerDept - currentDeptTeams : -1;
const maxMembersPerTeam = parseInt("<%= event.eventType === 'team' ? event.teamSize : 0 %>") || 0;
let teamCount = 0;
const maxAllowedTeams = remainingSlots > 0 ? remainingSlots : (remainingSlots === -1 ? 10 : 0);
const teamMemberCounts = {};

if ('<%= event.eventType %>' === 'team' && maxAllowedTeams > 0) {
    addTeamSection();
}

document.getElementById('addTeamBtn').addEventListener('click', function() {
    if (teamCount < maxAllowedTeams) {
        addTeamSection();
    } else {
        if (remainingSlots === -1) {
            alert('Maximum 10 teams allowed per submission');
        } else {
            alert('Maximum team limit reached for your department');
        }
    }
});

function addTeamSection() {
    if (teamCount >= maxAllowedTeams) return;
    
    teamCount++;
    const teamIndex = teamCount - 1;
    const autoTeamName = `Team${teamCount}`;
    
    const container = document.getElementById('teamsContainer');
    const teamSection = document.createElement('div');
    teamSection.className = 'team-section bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 mb-4 border border-blue-200';
    teamSection.id = `teamSection_${teamIndex}`;
    teamSection.dataset.teamIndex = teamIndex;
    
    teamSection.innerHTML = `
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-semibold text-gray-800">Team ${teamCount}</h3>
            ${teamCount > 1 ? `<button type="button" onclick="removeTeamSection(${teamIndex})" class="text-red-600 hover:text-red-800 text-sm"><i class="fas fa-trash mr-1"></i>Remove</button>` : ''}
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Team Name *</label>
                <input type="text" name="teams[${teamIndex}][teamName]" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 team-name-input"
                       placeholder="Enter team name" onchange="validateTeamName(this)">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Team Leader Name *</label>
                <input type="text" name="teams[${teamIndex}][teamLeaderName]" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900"
                       placeholder="Team leader name">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Team Leader College ID *</label>
                <input type="text" name="teams[${teamIndex}][teamLeaderCollegeId]" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 college-id-input"
                       placeholder="e.g., 23BCA123">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Team Leader Email *</label>
                <input type="email" name="teams[${teamIndex}][teamLeaderEmail]" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 email-input"
                       placeholder="leader@example.com">
            </div>
            
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700 mb-1">Department (Leader)</label>
                <input type="text" readonly
                       value="<%= currentUser.profile.department %>"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-100 text-gray-900 cursor-not-allowed">
                <input type="hidden" name="teams[${teamIndex}][teamLeaderDepartment]" value="<%= currentUser.profile.department %>">
                <p class="text-xs text-gray-500 mt-1">Auto-filled from your profile</p>
            </div>
        </div>
        
        <div class="mt-4 bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h4 class="text-sm font-semibold text-gray-800">Team Members</h4>
                    <button type="button" onclick="addTeamMemberRow(${teamIndex})" class="px-3 py-1 bg-[#0ea5a4] text-white rounded-md hover:bg-[#0d9488] transition-colors text-sm font-medium border border-[#0ea5a4] add-member-btn-${teamIndex}">
                        <i class="fas fa-plus mr-1"></i>Add Member
                    </button>
                </div>
                <p class="text-xs text-gray-600 mt-1">Maximum ${maxMembersPerTeam} members (excluding leader)</p>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full" id="teamMembersTable_${teamIndex}">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Member Name</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">College ID</th>
                            <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200" id="teamMembersBody_${teamIndex}">
                    </tbody>
                </table>
            </div>
        </div>
    `;
    
    container.appendChild(teamSection);
    
    const initialMembers = Math.min(2, maxMembersPerTeam);
    for (let i = 0; i < initialMembers; i++) {
        addTeamMemberRow(teamIndex);
    }
    
    updateAddTeamButton();
}

function removeTeamSection(teamIndex) {
    const section = document.getElementById(`teamSection_${teamIndex}`);
    if (section) {
        section.remove();
        reindexTeams();
    }
}

function reindexTeams() {
    const sections = document.querySelectorAll('.team-section');
    teamCount = 0;
    sections.forEach((section, index) => {
        teamCount++;
        section.id = `teamSection_${index}`;
        section.dataset.teamIndex = index;
        section.querySelector('h3').textContent = `Team ${teamCount}`;
        
        const inputs = section.querySelectorAll('input, select');
        inputs.forEach(input => {
            const name = input.getAttribute('name');
            if (name) {
                const newName = name.replace(/teams\[\d+\]/, `teams[${index}]`);
                input.setAttribute('name', newName);
            }
        });
        
        const table = section.querySelector('table');
        const tbody = section.querySelector('tbody');
        table.id = `teamMembersTable_${index}`;
        tbody.id = `teamMembersBody_${index}`;
        
        const addBtn = section.querySelector(`[class*="add-member-btn-"]`);
        if (addBtn) {
            addBtn.className = addBtn.className.replace(/add-member-btn-\d+/, `add-member-btn-${index}`);
            addBtn.setAttribute('onclick', `addTeamMemberRow(${index})`);
        }
        
        const removeBtn = section.querySelector('button[onclick^="removeTeamSection"]');
        if (removeBtn) {
            removeBtn.setAttribute('onclick', `removeTeamSection(${index})`);
        }
    });
    
    updateAddTeamButton();
}

function updateAddTeamButton() {
    const addBtn = document.getElementById('addTeamBtn');
    if (addBtn) {
        if (teamCount >= maxAllowedTeams) {
            addBtn.disabled = true;
            addBtn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
            addBtn.disabled = false;
            addBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    }
}

function addTeamMemberRow(teamIndex) {
    if (typeof teamMemberCounts[teamIndex] === 'undefined') {
        teamMemberCounts[teamIndex] = 0;
    }
    if (!teamMemberCounts[teamIndex]) teamMemberCounts[teamIndex] = 0;
    
    if (teamMemberCounts[teamIndex] >= maxMembersPerTeam) {
        alert('Maximum team members reached!');
        return;
    }
    
    const tbody = document.getElementById(`teamMembersBody_${teamIndex}`);
    if (!tbody) return;
    
    const memberIndex = teamMemberCounts[teamIndex];
    const row = document.createElement('tr');
    row.className = 'hover:bg-gray-50';
    row.innerHTML = `
        <td class="px-4 py-2">
            <input type="text" name="teams[${teamIndex}][members][${memberIndex}][name]" required
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900"
                   placeholder="Member name">
        </td>
        <td class="px-4 py-2">
            <input type="text" name="teams[${teamIndex}][members][${memberIndex}][collegeId]" required
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900 college-id-input"
                   placeholder="College ID">
        </td>
        <td class="px-4 py-2 text-center">
            <button type="button" onclick="removeTeamMemberRow(this, ${teamIndex})" class="text-red-600 hover:text-red-800">
                <i class="fas fa-trash"></i>
            </button>
        </td>
    `;
    tbody.appendChild(row);
    teamMemberCounts[teamIndex]++;
    
    const addBtn = document.querySelector(`.add-member-btn-${teamIndex}`);
    if (addBtn && teamMemberCounts[teamIndex] >= maxMembersPerTeam) {
        addBtn.disabled = true;
        addBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }
}

function removeTeamMemberRow(button, teamIndex) {
    const row = button.closest('tr');
    row.remove();
    teamMemberCounts[teamIndex]--;
    
    const tbody = document.getElementById(`teamMembersBody_${teamIndex}`);
    const rows = tbody.querySelectorAll('tr');
    rows.forEach((r, idx) => {
        const inputs = r.querySelectorAll('input');
        inputs[0].name = `teams[${teamIndex}][members][${idx}][name]`;
        inputs[1].name = `teams[${teamIndex}][members][${idx}][collegeId]`;
    });
    
    const addBtn = document.querySelector(`.add-member-btn-${teamIndex}`);
    if (addBtn) {
        addBtn.disabled = false;
        addBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
}

function validateTeamName(input) {
    const nameInputs = document.querySelectorAll('.team-name-input');
    const names = Array.from(nameInputs).map(i => i.value.trim().toLowerCase());
    const currentName = input.value.trim().toLowerCase();
    
    const duplicates = names.filter((name, index) => names.indexOf(name) !== index);
    if (duplicates.includes(currentName)) {
        alert('Team name must be unique!');
        input.value = '';
        input.focus();
    }
}

document.getElementById('teamRegistrationForm').addEventListener('submit', function(e) {
    if ('<%= event.eventType %>' === 'team') {
        const studentPattern = /^\d+(BA|BCA|BSC|BPES)\d{3}$/;
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        
        const collegeIdInputs = document.querySelectorAll('.college-id-input');
        const collegeIds = new Set();
        
        for (const input of collegeIdInputs) {
            const collegeId = input.value.trim().toUpperCase();
            if (!collegeId) continue;
            
            if (!studentPattern.test(collegeId)) {
                e.preventDefault();
                alert('Invalid College ID format: ' + collegeId + '. Use format: YEAR + COURSE + 3 digits');
                input.focus();
                return;
            }
            
            if (collegeIds.has(collegeId)) {
                e.preventDefault();
                alert('Duplicate College ID detected: ' + collegeId + '. Each team member must have a unique College ID.');
                input.focus();
                return;
            }
            collegeIds.add(collegeId);
        }
        
        const emailInputs = document.querySelectorAll('.email-input');
        for (const input of emailInputs) {
            const email = input.value.trim();
            if (email && !emailPattern.test(email)) {
                e.preventDefault();
                alert('Invalid email format: ' + email);
                input.focus();
                return;
            }
        }
        
    }
});
</script>

<script>
    window.addEventListener('load', function() {
        const successMessage = document.querySelector('.bg-green-100');
        
        if (successMessage) {
            setTimeout(function() {
                successMessage.style.transition = 'opacity 0.5s ease';
                successMessage.style.opacity = '0';
                setTimeout(function() {
                    successMessage.style.display = 'none';
                }, 500);
            }, 3000);
        }
        
        const errorMessage = document.querySelector('.bg-red-100');
        
        if (errorMessage) {
            setTimeout(function() {
                errorMessage.style.transition = 'opacity 0.5s ease';
                errorMessage.style.opacity = '0';
                setTimeout(function() {
                    errorMessage.style.display = 'none';
                }, 500);
            }, 3000);
        }
    });
</script>

