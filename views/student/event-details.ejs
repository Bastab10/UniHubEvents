<%- include('../partials/header') %>

<div class="flex min-h-screen bg-gray-50">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <!-- Header -->
        <div class="bg-gradient-to-r text-black  px-6 py-3">
                <div class="flex items-center">
                    <a href="/student/dashboard" class="text-black hover:text-gray-200 flex items-center mr-4">
                        <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
                    </a>
                    <!-- <h1 class="text-xl font-bold text-white">Event Details</h1> -->
                </div>   
        </div>

        <div class="p-4">
            <!-- Success/Error Messages -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 mx-auto max-w-3xl">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        <span><%= success %></span>
                    </div>
                </div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 mx-auto max-w-3xl">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <span><%= error %></span>
                    </div>
                </div>
            <% } %>
            
            <style>
                /* Mobile input field text visibility fixes */
                @media (max-width: 640px) {
                    input[type="text"] {
                        color: #000000 !important; /* Force black text */
                        background-color: #ffffff !important; /* Force white background */
                    }
                    
                    input[type="text"]::placeholder {
                        color: #6b7280 !important; /* Gray placeholder */
                        opacity: 1 !important; /* Force full opacity */
                    }
                    
                    /* Focus states */
                    input[type="text"]:focus {
                        color: #000000 !important; /* Black text on focus */
                    }
                    
                    input[type="text"]:focus::placeholder {
                        color: #9ca3af !important; /* Lighter gray on focus */
                    }
                }
            </style>
            
            <!-- Event Banner -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-4 mx-auto max-w-3xl">
                <% if (event.poster && event.poster.trim() !== '') { %>
                    <img src="/uploads/<%= event.poster %>" 
                         alt="<%= event.title %>" 
                         class="w-full h-48 object-cover">
                <% } else { %>
                    <div class="w-full h-48 bg-gradient-to-br text-black flex items-center justify-center">
                        <div class="text-center text-black">
                            <i class="fas fa-calendar-alt text-4xl mb-2"></i>
                            <p class="text-lg font-semibold">Event Banner</p>
                        </div>
                    </div>
                <% } %>
                
                <!-- Event Info Card -->
                <div class="p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center">
                            <h1 class="text-2xl font-bold text-gray-800 mr-3"><%= event.title %></h1>
                            <span class="px-3 py-1 text-sm font-semibold rounded-full
                                <% if (event.category === 'seminar') { %>bg-blue-100 text-blue-800<% } 
                                   else if (event.category === 'workshop') { %>bg-green-100 text-green-800<% } 
                                   else if (event.category === 'cultural') { %>bg-purple-100 text-purple-800<% } 
                                   else if (event.category === 'sports') { %>bg-orange-100 text-orange-800<% }
                                   else { %>bg-gray-100 text-gray-800<% } %>">
                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                            </span>
                        </div>
                        
                        <% if (event.subCategory) { %>
                            <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm">
                                <i class="fas fa-football-ball mr-1"></i><%= event.subCategory %>
                            </span>
                        <% } %>
                    </div>
                    
                    <div class="prose max-w-none text-gray-600 mb-4">
                        <p class="text-base leading-relaxed"><%= event.description %></p>
                    </div>
                    
                    <!-- Compact Event Details Grid -->
                    <div class="grid grid-cols-2 md:grid-cols-2 gap-3 mb-4">
                        <div class="bg-blue-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-calendar-alt text-blue-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-blue-600 font-medium">Date</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-green-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-clock text-green-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-green-600 font-medium">Time</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= event.startTime %> - <%= event.endTime %></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-red-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-map-marker-alt text-red-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-red-600 font-medium">Venue</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= event.venue %></p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-purple-50 rounded-lg p-3">
                            <div class="flex items-center">
                                <i class="fas fa-user text-purple-500 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs text-purple-600 font-medium">Organizer</p>
                                    <p class="text-sm font-semibold text-gray-800"><%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (event.eventType === 'team') { %>
                        <div class="mb-4 p-3 bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg border border-blue-200">
                            <div class="flex items-center">
                                <i class="fas fa-users text-blue-600 text-lg mr-2"></i>
                                <div>
                                    <p class="text-xs font-medium text-blue-600">Team Event</p>
                                    <p class="text-sm font-semibold text-gray-800">Team Size: <%= event.teamSize %> members</p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Team Registration Section -->
            <% const availableSpots = event.maxParticipants ? event.maxParticipants - event.registrations.length : null; %>
            
            <!-- Debug Information (remove in production) -->
            <% if (process.env.NODE_ENV === 'development') { %>
                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-2 rounded mb-4 mx-auto max-w-3xl text-sm">
                    <div><strong>Debug Info:</strong></div>
                    <div>Current User ID: <%= currentUser._id %></div>
                    <div>Event ID: <%= event._id %></div>
                    <div>Is Registered (from route): <%= isRegistered %></div>
                    <div>Total Registrations: <%= event.registrations.length %></div>
                    <div>Registrations: <%= JSON.stringify(event.registrations.map(r => ({ student: r.student._id, studentStr: r.student._id.toString(), currentUserStr: currentUser._id.toString(), match: r.student._id.toString() === currentUser._id.toString() }))) %></div>
                </div>
            <% } %>
            
            <% if (isRegistered) { %>
                <!-- Already Registered Card -->
                <div class="bg-white rounded-lg shadow-md p-6 text-center mx-auto max-w-2xl">
                    <i class="fas fa-check-circle text-green-500 text-4xl mb-3"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Already Registered</h3>
                    <div class="inline-flex items-center px-4 py-2 bg-green-100 text-green-800 rounded-full">
                        <i class="fas fa-ticket-alt mr-2"></i>
                        <span class="font-medium">Registration Confirmed</span>
                    </div>
                </div>
            <% } else if (availableSpots !== null && availableSpots <= 0) { %>
                <div class="bg-white rounded-lg shadow-md p-6 text-center mx-auto max-w-2xl">
                    <i class="fas fa-times-circle text-red-500 text-4xl mb-3"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Event Full</h3>
                    <p class="text-gray-600">This event has reached maximum capacity</p>
                </div>
            <% } else { %>
                <div class="bg-white rounded-lg shadow-md p-6 mx-auto max-w-3xl">
                    <div class="flex items-center mb-4">
                        <i class="fas fa-user-plus text-purple-600 text-xl mr-3"></i>
                        <h2 class="text-xl font-bold text-gray-800">Event Registration</h2>
                    </div>

                    <form method="POST" action="/student/events/<%= event._id %>/register" id="teamRegistrationForm">
                        <% if (event.eventType === 'team') { %>
                            <!-- Compact Team Information -->
                            <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 mb-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-3">Team Information</h3>
                                
                                <div class="grid grid-cols-1 md:grid-cols-1 gap-3">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Team Name *</label>
                                        <input type="text" id="teamName" name="teamName" required
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900"
                                               placeholder="Enter team name">
                                    </div>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Team Leader Name *</label>
                                        <input type="text" id="teamLeaderName" name="teamLeaderName" required
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900"
                                               placeholder="Team leader name">
                                    </div>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Team Leader College ID *</label>
                                        <input type="text" id="teamLeaderCollegeId" name="teamLeaderCollegeId" required
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900"
                                               placeholder="College ID">
                                    </div>
                                </div>
                            </div>

                            <!-- Compact Team Members Table -->
                            <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
                                <div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
                                    <div class="flex items-center justify-between">
                                        <h3 class="text-base font-semibold text-gray-800">Team Members</h3>
                                        <button type="button" id="addMemberBtn" class="px-3 py-1 bg-[#0ea5a4] text-white rounded-md hover:bg-[#0d9488] transition-colors text-sm font-medium border border-[#0ea5a4]">
                                            <i class="fas fa-plus mr-1"></i>Add Member
                                        </button>
                                    </div>
                                    <p class="text-xs text-gray-600 mt-1">Maximum <%= event.teamSize %> members (including team leader)</p>
                                </div>
                                
                                <div class="overflow-x-auto">
                                    <table class="w-full" id="teamMembersTable">
                                        <thead class="bg-gray-50 border-b border-gray-200">
                                            <tr>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Member Name</th>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">College ID</th>
                                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                                                <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="bg-white divide-y divide-gray-200" id="teamMembersBody">
                                            <!-- Dynamic members will be added here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- Individual Registration -->
                            <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 mb-4">
                                <h3 class="text-base font-semibold text-gray-800 mb-2">Individual Registration</h3>
                                <p class="text-sm text-gray-600">Click the button below to register for this event.</p>
                            </div>
                        <% } %>

                        <!-- Compact Submit Button -->
                        <div class="mt-6 text-center">
                            <button type="submit" class="px-6 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold rounded-lg hover:from-purple-700 hover:to-blue-700 transition-all transform hover:scale-105 shadow-md">
                                <i class="fas fa-check-circle mr-2"></i>
                                <% if (event.eventType === 'team') { %>Register Team<% } else { %>Register for Event<% } %>
                            </button>
                        </div>
                    </form>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
let memberCount = 0;
const maxMembers = parseInt("<%= event.eventType === 'team' ? event.teamSize - 1 : 0 %>");

// Add initial member rows
if (maxMembers > 0) {
    for (let i = 0; i < Math.min(2, maxMembers); i++) {
        addMemberRow();
    }
}

document.getElementById('addMemberBtn').addEventListener('click', function() {
    if (memberCount < maxMembers) {
        addMemberRow();
    } else {
        alert('Maximum team size reached!');
    }
});

function addMemberRow() {
    const tbody = document.getElementById('teamMembersBody');
    const row = document.createElement('tr');
    row.className = 'hover:bg-gray-50';
    row.innerHTML = '<td class="px-6 py-4">' +
        '<input type="text" name="teamMembers[' + memberCount + '][name]" required ' +
        'class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900" ' +
        'placeholder="Member name">' +
        '</td>' +
        '<td class="px-6 py-4">' +
        '<input type="text" name="teamMembers[' + memberCount + '][collegeId]" required ' +
        'class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900" ' +
        'placeholder="College ID">' +
        '</td>' +
        '<td class="px-6 py-4">' +
        '<input type="text" name="teamMembers[' + memberCount + '][department]" ' +
        'class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-900" ' +
        'placeholder="Department">' +
        '</td>' +
        '<td class="px-6 py-4 text-center">' +
        '<button type="button" onclick="removeMember(this)" class="text-red-600 hover:text-red-800">' +
        '<i class="fas fa-trash"></i>' +
        '</button>' +
        '</td>';
    tbody.appendChild(row);
    memberCount++;
    
    // Apply mobile styles to new inputs
    if (window.innerWidth <= 640) {
        const newInputs = row.querySelectorAll('input[type="text"]');
        newInputs.forEach(input => {
            input.style.color = '#000000';
            input.style.backgroundColor = '#ffffff';
        });
    }
    
    // Disable add button if max reached
    if (memberCount >= maxMembers) {
        document.getElementById('addMemberBtn').disabled = true;
        document.getElementById('addMemberBtn').classList.add('opacity-50', 'cursor-not-allowed');
    }
}

function removeMember(button) {
    const row = button.closest('tr');
    row.remove();
    memberCount--;
    
    // Re-enable add button if below max
    if (memberCount < maxMembers) {
        document.getElementById('addMemberBtn').disabled = false;
        document.getElementById('addMemberBtn').classList.remove('opacity-50', 'cursor-not-allowed');
    }
    
    // Re-index remaining members
    reindexMembers();
}

function reindexMembers() {
    const rows = document.querySelectorAll('#teamMembersBody tr');
    memberCount = 0;
    rows.forEach((row, index) => {
        const inputs = row.querySelectorAll('input');
        inputs[0].name = 'teamMembers[' + index + '][name]';
        inputs[1].name = 'teamMembers[' + index + '][collegeId]';
        inputs[2].name = 'teamMembers[' + index + '][department]';
        memberCount++;
    });
}
</script>

<script>
    // Flash message auto-hide system for event registration
    window.addEventListener('load', function() {
        console.log('Event details flash message script loaded');
        
        // Auto-hide success message after 3 seconds
        const successMessage = document.querySelector('.bg-green-100');
        console.log('Success message found:', successMessage);
        
        if (successMessage) {
            console.log('Auto-hiding success message after 3 seconds');
            setTimeout(function() {
                successMessage.style.transition = 'opacity 0.5s ease';
                successMessage.style.opacity = '0';
                setTimeout(function() {
                    successMessage.style.display = 'none';
                }, 500);
            }, 3000);
        }
        
        // Auto-hide error message after 3 seconds
        const errorMessage = document.querySelector('.bg-red-100');
        console.log('Error message found:', errorMessage);
        
        if (errorMessage) {
            console.log('Auto-hiding error message after 3 seconds');
            setTimeout(function() {
                errorMessage.style.transition = 'opacity 0.5s ease';
                errorMessage.style.opacity = '0';
                setTimeout(function() {
                    errorMessage.style.display = 'none';
                }, 500);
            }, 3000);
        }
    });
</script>

<%- include('../partials/footer') %>
