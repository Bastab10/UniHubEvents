<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - College Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/professional-ui.css">
    <style>
        /* Custom professional styles */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        @media (min-width: 1024px) {
            .dashboard-grid {
                grid-template-columns: 2fr 1fr;
            }
        }
        
        .metric-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
            border: 1px solid rgba(226, 232, 240, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }
        
        .metric-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px rgba(0, 0, 0, 0.15);
        }
        
        .welcome-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            color: white;
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }
        
        .welcome-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }
        
        .event-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
            border: 1px solid rgba(226, 232, 240, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .event-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
        }
        
        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }
        
        .category-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            border: 1px solid rgba(226, 232, 240, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }
        
        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
            border-color: rgba(99, 102, 241, 0.3);
        }
        
        .quick-action-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            border: 1px solid rgba(226, 232, 240, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }
        
        .quick-action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
            border-color: rgba(99, 102, 241, 0.3);
        }
        
        .fade-in {
            animation: fadeIn 0.6s ease-out;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .slide-in {
            animation: slideIn 0.5s ease-out;
        }
        
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-30px); }
            to { opacity: 1; transform: translateX(0); }
        }
        
        .sidebar {
            width: 280px;
            background: white;
            border-right: 1px solid rgba(226, 232, 240, 0.1);
            box-shadow: 4px 6px rgba(0, 0, 0, 0.07);
            height: 100vh;
            position: sticky;
            top: 0;
        }
        
        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #374151;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-left: 3px solid transparent;
            position: relative;
        }
        
        .sidebar-item:hover {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border-left-color: #3b82f6;
        }
        
        .sidebar-item.active {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border-left-color: #3b82f6;
        }
        
        .prof-icon {
            width: 20px;
            height: 20px;
            margin-right: 12px;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Modern Professional Navigation -->
    <nav class="bg-gradient-to-r from-blue-600 to-purple-600 shadow-xl border-b border-blue-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <!-- Logo Section -->
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
                                <i class="fas fa-calendar-alt text-blue-600 text-xl"></i>
                            </div>
                            <div>
                                <span class="text-xl font-bold text-white">EventHub</span>
                                <p class="text-xs text-blue-100">College Event Management</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Navigation Links -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="/student/dashboard" class="text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-10">
                        <i class="fas fa-tachometer-alt mr-2"></i>Dashboard
                    </a>
                    <a href="/student/events" class="text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-10">
                        <i class="fas fa-search mr-2"></i>Browse Events
                    </a>
                    <a href="/student/registrations" class="text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-10">
                        <i class="fas fa-ticket-alt mr-2"></i>My Registrations
                    </a>
                    <a href="/student/history" class="text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-10">
                        <i class="fas fa-history mr-2"></i>History
                    </a>
                    <a href="/student/profile" class="text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-10">
                        <i class="fas fa-user mr-2"></i>Profile
                    </a>
                </div>
                
                <!-- User Section -->
                <div class="flex items-center space-x-4">
                    <!-- Notifications -->
                    <button class="relative p-2 text-white hover:bg-white hover:bg-opacity-10 rounded-lg transition-all duration-300">
                        <i class="fas fa-bell text-lg"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    
                    <!-- Messages -->
                    <button class="relative p-2 text-white hover:bg-white hover:bg-opacity-10 rounded-lg transition-all duration-300">
                        <i class="fas fa-envelope text-lg"></i>
                        <span class="absolute top-0 right-0 w-2 h-2 bg-green-500 rounded-full"></span>
                    </button>
                    
                    <!-- User Profile Dropdown -->
                    <div class="relative">
                        <button class="flex items-center space-x-3 p-2 text-white hover:bg-white hover:bg-opacity-10 rounded-lg transition-all duration-300" onclick="toggleUserMenu()">
                            <img src="<%= currentUser.profile.avatar || '/images/default-avatar.png' %>" 
                                 alt="Profile" 
                                 class="h-8 w-8 rounded-full object-cover border-2 border-white">
                            <div class="text-left">
                                <p class="text-sm font-medium text-white">
                                    <%= currentUser.profile.firstName %> <%= currentUser.profile.lastName %>
                                </p>
                                <p class="text-xs text-blue-100">
                                    <%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %>
                                </p>
                            </div>
                            <i class="fas fa-chevron-down text-sm text-blue-200"></i>
                        </button>
                        <div id="userMenu" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-2xl py-2 z-50 border border-gray-100">
                            <div class="px-4 py-3 border-b border-gray-100">
                                <p class="text-sm font-semibold text-gray-800">
                                    <%= currentUser.profile.firstName %> <%= currentUser.profile.lastName %>
                                </p>
                                <p class="text-xs text-gray-500">
                                    <%= currentUser.email %>
                                </p>
                            </div>
                            <a href="/student/profile" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                <i class="fas fa-user mr-3 text-gray-400"></i>
                                <span>My Profile</span>
                            </a>
                            <a href="/student/settings" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                <i class="fas fa-cog mr-3 text-gray-400"></i>
                                <span>Settings</span>
                            </a>
                            <a href="/student/help" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                <i class="fas fa-question-circle mr-3 text-gray-400"></i>
                                <span>Help & Support</span>
                            </a>
                            <hr class="my-2 border-gray-100">
                            <a href="/auth/logout" class="flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                <i class="fas fa-sign-out-alt mr-3"></i>
                                <span>Logout</span>
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Mobile Menu Button -->
                <div class="md:hidden">
                    <button class="p-2 text-white hover:bg-white hover:bg-opacity-10 rounded-lg transition-all duration-300" onclick="toggleMobileMenu()">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden md:hidden bg-blue-700 border-t border-blue-800">
            <div class="px-4 py-3 space-y-2">
                <a href="/student/dashboard" class="flex items-center text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300">
                    <i class="fas fa-tachometer-alt mr-3"></i>Dashboard
                </a>
                <a href="/student/events" class="flex items-center text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300">
                    <i class="fas fa-search mr-3"></i>Browse Events
                </a>
                <a href="/student/registrations" class="flex items-center text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300">
                    <i class="fas fa-ticket-alt mr-3"></i>My Registrations
                </a>
                <a href="/student/history" class="flex items-center text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300">
                    <i class="fas fa-history mr-3"></i>History
                </a>
                <a href="/student/profile" class="flex items-center text-white hover:text-blue-100 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300">
                    <i class="fas fa-user mr-3"></i>Profile
                </a>
            </div>
        </div>
    </nav>

    <!-- Professional Sidebar -->
    <aside class="sidebar">
        <div class="p-6">
            <h2 class="text-lg font-semibold text-gray-800 mb-6 flex items-center">
                <i class="fas fa-th-large mr-3 text-blue-600"></i>
                Student Panel
            </h2>
            
            <nav class="space-y-2">
                <a href="/student/dashboard" class="sidebar-item active">
                    <i class="fas fa-tachometer-alt prof-icon"></i>
                    <span>Dashboard</span>
                </a>
                
                <a href="/student/events" class="sidebar-item">
                    <i class="fas fa-search prof-icon"></i>
                    <span>Browse Events</span>
                </a>
                
                <a href="/student/registrations" class="sidebar-item">
                    <i class="fas fa-ticket-alt prof-icon"></i>
                    <span>My Registrations</span>
                </a>
                
                <a href="/student/history" class="sidebar-item">
                    <i class="fas fa-history prof-icon"></i>
                    <span>Participation History</span>
                </a>
                
                <a href="/student/profile" class="sidebar-item">
                    <i class="fas fa-user prof-icon"></i>
                    <span>My Profile</span>
                </a>
            </nav>
            
            <!-- Quick Stats -->
            <div class="mt-8 p-4 bg-gray-50 rounded-lg">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Quick Stats</h3>
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Total Events</span>
                        <span class="text-lg font-bold text-gray-800"><%= stats.registeredEvents || 0 %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">Pending</span>
                        <span class="text-lg font-bold text-yellow-600"><%= stats.pendingEvents || 0 %></span>
                    </div>
                </div>
            </div>
        </div>
    </aside>
        <div class="dashboard-grid">
            <!-- Welcome Section -->
            <div class="welcome-section fade-in">
                <div class="flex justify-between items-start">
                    <div>
                        <h1 class="text-3xl font-bold mb-2">Welcome back, <%= currentUser.profile.firstName %>!</h1>
                        <p class="text-blue-100">Here's your personalized overview for today</p>
                    </div>
                    <div class="hidden md:block">
                        <i class="fas fa-graduation-cap text-6xl text-blue-200 opacity-50"></i>
                    </div>
                </div>
            </div>

            <!-- Metrics Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Available Events Metric -->
                <div class="metric-card" data-animate>
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-search text-blue-600 text-xl"></i>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Available Events</p>
                                <p class="text-2xl font-bold text-gray-800 counter" data-target="<%= stats.availableEvents %>">0</p>
                            </div>
                        </div>
                        <div class="mt-4">
                            <a href="/student/events" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm">
                                Explore Events
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Registered Events Metric -->
                <div class="metric-card" data-animate>
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-ticket-alt text-green-600 text-xl"></i>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Registered Events</p>
                                <p class="text-2xl font-bold text-gray-800 counter" data-target="<%= stats.registeredEvents %>">0</p>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="flex items-center text-sm text-gray-600 mb-2">
                                <i class="fas fa-check-circle mr-2"></i>
                                <span class="font-medium">All approved</span>
                            </div>
                            <a href="/student/registrations" class="inline-flex items-center text-green-600 hover:text-green-800 font-medium text-sm">
                                View Registrations
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Pending Registrations Metric -->
                <div class="metric-card" data-animate>
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-clock text-yellow-600 text-xl"></i>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500 font-medium">Pending Registrations</p>
                                <p class="text-2xl font-bold text-gray-800 counter" data-target="<%= stats.pendingEvents %>">0</p>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="flex items-center text-sm text-gray-600 mb-2">
                                <i class="fas fa-hourglass-half mr-2"></i>
                                <span class="font-medium">Awaiting approval</span>
                            </div>
                            <a href="/student/registrations?status=pending" class="inline-flex items-center text-yellow-600 hover:text-yellow-800 font-medium text-sm">
                                Check Status
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Events Section -->
        <div class="dashboard-grid">
            <div class="event-card">
                <div class="bg-gradient-to-r from-blue-600 to-purple-600 p-4 text-white">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-bold flex items-center">
                            <i class="fas fa-calendar-check mr-3"></i>
                            Your Upcoming Events
                        </h2>
                        <a href="/student/registrations" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-1 rounded-full text-sm transition">
                            View All
                        </a>
                    </div>
                </div>
                
                <div class="p-6 max-h-96 overflow-y-auto">
                    <% if (upcomingRegistered && upcomingRegistered.length > 0) { %>
                        <div class="space-y-4">
                            <% upcomingRegistered.forEach((event, index) => { %>
                                <div class="border-l-4 border-green-500 pl-4 py-3 hover:bg-gray-50 transition-colors rounded-r-lg slide-in" 
                                     style="animation-delay: <%= index * 100 %>ms;">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <h3 class="font-semibold text-gray-800 mb-2 flex items-center">
                                                <%= event.title %>
                                                <span class="ml-2 px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full">
                                                    Registered
                                                </span>
                                            </h3>
                                            <div class="grid grid-cols-2 gap-2 text-sm text-gray-600">
                                                <div class="flex items-center">
                                                    <i class="fas fa-calendar-alt mr-2 text-blue-500"></i>
                                                    <span class="font-medium">Date:</span>
                                                    <%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-clock mr-2 text-green-500"></i>
                                                    <span class="font-medium">Time:</span>
                                                    <%= event.startTime %> - <%= event.endTime %>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                                                    <span class="font-medium">Venue:</span>
                                                    <%= event.venue %>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-user mr-2 text-purple-500"></i>
                                                    <span class="font-medium">Organizer:</span>
                                                    <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="ml-4 flex flex-col items-end space-y-2">
                                            <span class="px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full">
                                                <i class="fas fa-check-circle mr-1"></i>Confirmed
                                            </span>
                                            
                                            <div class="text-right">
                                                <button class="bg-transparent border border-white text-white px-3 py-1 rounded text-sm font-medium hover:bg-white hover:text-blue-600 transition">
                                                    View Details
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-12">
                                <i class="fas fa-calendar-times text-gray-300 text-6xl mb-4"></i>
                                <h3 class="text-xl font-semibold text-gray-600 mb-2">No Upcoming Events</h3>
                                <p class="text-gray-500 mb-6">You haven't registered for any upcoming events yet.</p>
                                <a href="/student/events" class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transform transition hover:scale-105">
                                    <i class="fas fa-search mr-2"></i>
                                    Browse Events
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Featured Events Section -->
            <div class="dashboard-grid">
                <div class="event-card">
                    <div class="bg-gradient-to-r from-purple-600 to-pink-600 p-4 text-white">
                        <h2 class="text-xl font-bold flex items-center">
                            <i class="fas fa-star mr-3"></i>
                            Featured Events
                        </h2>
                    </div>
                    
                    <div class="p-6">
                        <!-- Main Featured Event -->
                        <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg p-6 text-white mb-4 transform transition hover:scale-105">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-star text-yellow-300 text-2xl mr-3"></i>
                                <span class="text-sm font-medium bg-white bg-opacity-20 px-2 py-1 rounded">Event of the Week</span>
                            </div>
                            <h3 class="text-xl font-bold mb-2">Annual Tech Symposium</h3>
                            <p class="text-blue-100 mb-4">Join us for the biggest tech event of the year!</p>
                            <div class="flex items-center text-sm text-blue-100 mb-4">
                                <i class="fas fa-calendar-alt mr-2"></i>
                                <span>March 25, 2026</span>
                                <i class="fas fa-map-marker-alt ml-4 mr-2"></i>
                                <span>Main Auditorium</span>
                            </div>
                            <div class="flex items-center text-sm text-blue-100 mb-4">
                                <i class="fas fa-calendar-check mr-2"></i>
                                <span>April 1, 2026</span>
                                <i class="fas fa-map-marker-alt ml-4 mr-2"></i>
                                <span>Conference Hall</span>
                            </div>
                            <a href="/student/events" class="inline-flex items-center bg-white text-blue-600 px-4 py-2 rounded font-medium hover:bg-blue-50 transition">
                                <i class="fas fa-ticket-alt mr-2"></i>
                                Register Now
                            </a>
                        </div>
                        
                        <!-- Secondary Featured Event -->
                        <div class="border-l-4 border-purple-500 pl-4 py-3 hover:bg-gray-50 transition-colors rounded-r-lg">
                            <div class="flex justify-between items-start mb-2">
                                <h4 class="font-semibold text-gray-800">Sports Championship</h4>
                                <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">Popular</span>
                            </div>
                            <p class="text-sm text-gray-600 mb-2">Limited spots available</p>
