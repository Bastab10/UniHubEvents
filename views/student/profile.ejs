<%- include('../partials/header') %>

<style>
.dashboard-container {
    min-height: 100vh;
    background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
}

@media (max-width: 768px) {
    .dashboard-container {
        background: #f9fafb;
    }
}

@media (max-width: 640px) {
    .dashboard-container h3 {
        color: #1f2937 !important;
    }
    
    .dashboard-container p {
        color: #4b5563 !important;
    }
    
    input[type="text"],
    input[type="email"],
    input[type="tel"] {
        color: #1a1a1a !important;
        background-color: #ffffff !important;
    }
    
    input[type="text"]::placeholder,
    input[type="email"]::placeholder,
    input[type="tel"]::placeholder {
        color: #6b7280 !important;
        opacity: 1 !important;
    }
    
    label {
        color: #374151 !important;
    }
}
</style>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1 overflow-y-auto">
        <div class="p-4 sm:p-6">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">My Profile</h3>
                    </div>

            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-1">
                            <div class="text-center">
                                <div class="mx-auto h-16 w-16 bg-gray-200 rounded-full flex items-center justify-center mb-3">
                                    <i class="fas fa-user text-gray-400 text-2xl"></i>
                                </div>
                                <h2 class="text-lg font-semibold text-gray-800 mb-1">
                                    <%= currentUser.profile.fullName %>
                                </h2>
                                <p class="text-sm text-gray-600 mb-2"><%= currentUser.email %></p>
                                <span class="inline-block px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">
                                    <%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %>
                                </span>
                            </div>
                        </div>

                        <div class="lg:col-span-2">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Your Details</h3>
                            <form method="POST" action="/student/profile" class="space-y-3">
                                <div>
                                    <label for="fullName" class="block text-xs font-medium text-gray-700 mb-1">Full Name</label>
                                    <input type="text" id="fullName" name="fullName" value="<%= currentUser.profile.fullName %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-gray-900"
                                           required>
                                </div>

                                <div>
                                    <label for="email" class="block text-xs font-medium text-gray-700 mb-1">Email</label>
                                    <input type="email" id="email" name="email" value="<%= currentUser.email %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-gray-900"
                                           placeholder="Enter your email" readonly>
                                    <p class="text-xs text-gray-500 mt-1">Email can be updated by contacting admin</p>
                                </div>

                                <div>
                                    <label for="collegeId" class="block text-xs font-medium text-gray-700 mb-1">College ID</label>
                                    <input type="text" id="collegeId" name="collegeId" value="<%= currentUser.profile.collegeId %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-gray-900"
                                           placeholder="Enter your college ID" readonly>
                                    <p class="text-xs text-gray-500 mt-1">Contact admin to update College ID</p>
                                </div>

                                <div>
                                    <label for="department" class="block text-xs font-medium text-gray-700 mb-1">Department</label>
                                    <input type="text" id="department" name="department" value="<%= currentUser.profile.department %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-gray-900"
                                           placeholder="Your department" readonly>
                                    <p class="text-xs text-gray-500 mt-1">Contact admin to update Department</p>
                                </div>

                                <div class="flex justify-end space-x-2 pt-2">
                                    <button type="button" class="px-3 py-1.5 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                                        Cancel
                                    </button>
                                    <button type="submit" class="px-3 py-1.5 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700">
                                        Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<%- include('../partials/footer') %>
