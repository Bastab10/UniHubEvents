<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - College Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .form-input:focus, .form-select:focus {
            border-color: #0ea5a4;
            box-shadow: 0 0 0 3px rgba(14, 165, 164, 0.1);
            outline: none;
        }
        .btn-primary-teal {
            background-color: #0ea5a4;
            color: white;
            transition: all 0.2s ease;
        }
        .btn-primary-teal:hover {
            background-color: #0d9488;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(14, 165, 164, 0.3);
        }
        .btn-primary-teal:focus {
            box-shadow: 0 0 0 3px rgba(14, 165, 164, 0.3);
        }
        .input-error {
            border-color: #ef4444 !important;
        }
        @media (max-width: 640px) {
            .form-input, .form-select {
                font-size: 16px;
            }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen flex items-center justify-center py-8 px-4">

    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-200">

            <div class="text-center mb-6">
                <div class="mx-auto inline-flex items-center justify-center rounded-full bg-[#0ea5a4] text-white w-10 h-10">
                    <i class="fas fa-user-plus text-lg"></i>
                </div>
                <h3 class="mt-4 text-2xl font-bold text-gray-900">
                    Create your account
                </h3>
                <p class="text-gray-500 text-sm mt-1">
                    Join our College Event Management System
                </p>
            </div>

            <!-- Flash Messages -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 flex items-start gap-2">
                    <i class="fas fa-exclamation-circle mt-0.5"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 flex items-start gap-2">
                    <i class="fas fa-check-circle mt-0.5"></i>
                    <span><%= success %></span>
                </div>
            <% } %>

            <!-- Validation Errors -->
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4">
                    <div class="flex items-start gap-2 mb-2">
                        <i class="fas fa-exclamation-triangle mt-0.5"></i>
                        <strong class="text-sm">Please fix the following errors:</strong>
                    </div>
                    <ul class="text-sm list-disc list-inside ml-1">
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="/auth/register" method="POST" id="registrationForm" class="space-y-4">

                <div>
                    <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                    <input id="fullName" name="fullName" type="text" required
                           value="<%= typeof formData !== 'undefined' ? formData.fullName : '' %>"
                           class="form-input w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm transition-all"
                           placeholder="Enter your full name">
                </div>

                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                    <input id="email" name="email" type="email" required
                           value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                           class="form-input w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm transition-all"
                           placeholder="Enter your college email">
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password *</label>
                    <div class="relative">
                        <input id="password" name="password" type="password" required
                               class="form-input w-full px-4 py-2.5 pr-10 border border-gray-300 rounded-lg text-sm transition-all"
                               placeholder="Create a password">
                        <button type="button" id="togglePassword" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none">
                            <i class="fas fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="collegeId" class="block text-sm font-medium text-gray-700 mb-1">College ID *</label>
                    <input id="collegeId" name="collegeId" type="text" required
                           value="<%= typeof formData !== 'undefined' ? formData.collegeId : '' %>"
                           class="form-input w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm transition-all"
                           placeholder="YYCourseRollNo">
                    <div id="collegeIdError" class="text-red-600 text-xs mt-1 hidden"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="department" class="block text-sm font-medium text-gray-700 mb-1">Department *</label>
                        <select id="department" name="department" required class="form-select w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm bg-white transition-all">
                            <option value="">Select Department</option>
                            <option value="Anthropology" <%= typeof formData !== 'undefined' && formData.department === 'Anthropology' ? 'selected' : '' %>>Anthropology</option>
                            <option value="Assamese" <%= typeof formData !== 'undefined' && formData.department === 'Assamese' ? 'selected' : '' %>>Assamese</option>
                            <option value="Botany" <%= typeof formData !== 'undefined' && formData.department === 'Botany' ? 'selected' : '' %>>Botany</option>
                            <option value="Chemistry" <%= typeof formData !== 'undefined' && formData.department === 'Chemistry' ? 'selected' : '' %>>Chemistry</option>
                            <option value="Computer Science" <%= typeof formData !== 'undefined' && formData.department === 'Computer Science' ? 'selected' : '' %>>Computer Science</option>
                            <option value="Economics" <%= typeof formData !== 'undefined' && formData.department === 'Economics' ? 'selected' : '' %>>Economics</option>
                            <option value="Education" <%= typeof formData !== 'undefined' && formData.department === 'Education' ? 'selected' : '' %>>Education</option>
                            <option value="Electronics" <%= typeof formData !== 'undefined' && formData.department === 'Electronics' ? 'selected' : '' %>>Electronics</option>
                            <option value="English" <%= typeof formData !== 'undefined' && formData.department === 'English' ? 'selected' : '' %>>English</option>
                            <option value="Geography" <%= typeof formData !== 'undefined' && formData.department === 'Geography' ? 'selected' : '' %>>Geography</option>
                            <option value="Hindi" <%= typeof formData !== 'undefined' && formData.department === 'Hindi' ? 'selected' : '' %>>Hindi</option>
                            <option value="History" <%= typeof formData !== 'undefined' && formData.department === 'History' ? 'selected' : '' %>>History</option>
                            <option value="Home Science" <%= typeof formData !== 'undefined' && formData.department === 'Home Science' ? 'selected' : '' %>>Home Science</option>
                            <option value="Mathematics" <%= typeof formData !== 'undefined' && formData.department === 'Mathematics' ? 'selected' : '' %>>Mathematics</option>
                            <option value="Philosophy" <%= typeof formData !== 'undefined' && formData.department === 'Philosophy' ? 'selected' : '' %>>Philosophy</option>
                            <option value="Physics" <%= typeof formData !== 'undefined' && formData.department === 'Physics' ? 'selected' : '' %>>Physics</option>
                            <option value="Political Science" <%= typeof formData !== 'undefined' && formData.department === 'Political Science' ? 'selected' : '' %>>Political Science</option>
                            <option value="Statistics" <%= typeof formData !== 'undefined' && formData.department === 'Statistics' ? 'selected' : '' %>>Statistics</option>
                            <option value="Zoology" <%= typeof formData !== 'undefined' && formData.department === 'Zoology' ? 'selected' : '' %>>Zoology</option>
                        </select>
                    </div>

                    <div>
                        <label for="role" class="block text-sm font-medium text-gray-700 mb-1">Role *</label>
                        <select id="role" name="role" required class="form-select w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm bg-white transition-all">
                            <option value="">Select Role</option>
                            <option value="student" <%= typeof formData !== 'undefined' && formData.role === 'student' ? 'selected' : '' %>>Student</option>
                            <option value="faculty" <%= typeof formData !== 'undefined' && formData.role === 'faculty' ? 'selected' : '' %>>Coordinator</option>
                        </select>
                    </div>
                </div>

                <div id="designationField" style="display: none;">
                    <label for="designation" class="block text-sm font-medium text-gray-700 mb-1">Designation *</label>
                    <input id="designation" name="designation" type="text"
                           value="<%= typeof formData !== 'undefined' ? formData.designation : '' %>"
                           class="form-input w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm transition-all"
                           placeholder="e.g., Assistant Professor, Lecturer, HOD">
                    <p class="text-xs text-gray-500 mt-1">Your position in the department</p>
                </div>

                <button type="submit" class="btn-primary-teal w-full py-2.5 px-4 rounded-lg font-semibold text-sm">
                    Create Account
                </button>

            </form>

            <div class="text-center mt-6 pt-4 border-t border-gray-100">
                <p class="text-gray-500 text-sm">
                    Already have an account?
                    <a href="/auth/login" class="text-[#0ea5a4] hover:text-[#0d9488] font-medium">
                        Sign in here
                    </a>
                </p>
            </div>

        </div>
    </div>
    
    <script>
        // Student College ID validation function
        function validateStudentCollegeId(collegeId) {
            // Format: YEAR + COURSE + 3 digits
            // Examples: 23BA123, 24BCA456, 25BSC789, 26BPES001
            const pattern = /^\d+(BA|BCA|BSC|BPES)\d{3}$/;
            return pattern.test(collegeId.toUpperCase());
        }

        // Coordinator College ID validation function
        function validateCoordinatorCollegeId(collegeId) {
            // Format: FAC + 3 digits OR DEPT + 3 digits
            // Examples: FAC001, FAC123, DEPT001, DEPT123
            const pattern = /^(FAC\d{3}|DEPT\d{3})$/;
            return pattern.test(collegeId.toUpperCase());
        }

        // Role change handler, dynamic form fields based on role selection
        document.getElementById('role').addEventListener('change', function() {
            const role = this.value;
            const designationField = document.getElementById('designationField');
            const designationInput = document.getElementById('designation');
            const collegeIdInput = document.getElementById('collegeId');
            const collegeIdLabel = collegeIdInput.parentElement.querySelector('label');
            const collegeIdPlaceholder = collegeIdInput;
            const collegeIdHelp = collegeIdInput.parentElement.querySelector('p.text-gray-500');
            
            if (role === 'faculty') {
                // Show designation field for coordinator
                designationField.style.display = 'block';
                designationInput.setAttribute('required', 'required');
                
                // Update College ID guidance for coordinator
                collegeIdLabel.textContent = 'College ID *';
                collegeIdPlaceholder.placeholder = 'Coordinator ID (e.g., FAC001, DEPT123)';
                collegeIdHelp.textContent = 'Format: FAC001 or DEPT123';
                
                // Enable Coordinator College ID validation
                collegeIdInput.removeEventListener('input', validateStudentCollegeId);
                collegeIdInput.addEventListener('input', function() {
                    const collegeId = this.value;
                    const errorDiv = document.getElementById('collegeIdError');
                    const submitButton = document.querySelector('button[type="submit"]');
                    
                    if (collegeId && !validateCoordinatorCollegeId(collegeId)) {
                        errorDiv.style.display = 'block';
                        errorDiv.textContent = 'Invalid Coordinator ID format. Use: FAC001 or DEPT123';
                        this.classList.add('input-error');
                        submitButton.disabled = true;
                    } else {
                        errorDiv.style.display = 'none';
                        this.classList.remove('input-error');
                        submitButton.disabled = false;
                    }
                });
                collegeIdInput.classList.remove('input-error');
                document.getElementById('collegeIdError').style.display = 'none';
                document.querySelector('button[type="submit"]').disabled = false;
                
            } else if (role === 'student') {
                // Hide designation field for students
                designationField.style.display = 'none';
                designationInput.removeAttribute('required');
                designationInput.value = '';
                
                // Update College ID guidance for students
                collegeIdLabel.textContent = 'College ID *';
                collegeIdPlaceholder.placeholder = 'e.g., 23BA123, 24BCA456';
                collegeIdHelp.textContent = 'Format: YEAR + COURSE + 3 digits';
                
                // Re-enable Student College ID validation
                collegeIdInput.removeEventListener('input', validateCoordinatorCollegeId);
                collegeIdInput.addEventListener('input', function() {
                    const collegeId = this.value;
                    const errorDiv = document.getElementById('collegeIdError');
                    const submitButton = document.querySelector('button[type="submit"]');
                    
                    if (collegeId && !validateStudentCollegeId(collegeId)) {
                        errorDiv.style.display = 'block';
                        errorDiv.textContent = 'Invalid College ID format. Use format: YEAR + COURSE + 3 digits (e.g., 23BA123)';
                        this.classList.add('input-error');
                        submitButton.disabled = true;
                    } else {
                        errorDiv.style.display = 'none';
                        this.classList.remove('input-error');
                        submitButton.disabled = false;
                    }
                });
                collegeIdInput.classList.remove('input-error');
                document.getElementById('collegeIdError').style.display = 'none';
                document.querySelector('button[type="submit"]').disabled = false;
            } else {
                // Hide designation field for other roles
                designationField.style.display = 'none';
                designationInput.removeAttribute('required');
                designationInput.value = '';
            }
        });
        // Form submission validation
        document.getElementById('registrationForm').addEventListener('submit', function(e) {
            const role = document.getElementById('role').value;
            const collegeId = document.getElementById('collegeId').value;
            
            // Validate College ID format based on role
            if (role === 'student' && !validateStudentCollegeId(collegeId)) {
                e.preventDefault();
                document.getElementById('collegeIdError').style.display = 'block';
                document.getElementById('collegeIdError').textContent = 'Invalid College ID format. Use format: YEAR + COURSE + 3 digits (e.g., 23BA123)';
                document.getElementById('collegeId').classList.add('input-error');
                document.getElementById('collegeId').focus();
                return false;
            }
            
            if (role === 'faculty' && !validateCoordinatorCollegeId(collegeId)) {
                e.preventDefault();
                document.getElementById('collegeIdError').style.display = 'block';
                document.getElementById('collegeIdError').textContent = 'Invalid Coordinator ID format. Use: FAC001 or DEPT123';
                document.getElementById('collegeId').classList.add('input-error');
                document.getElementById('collegeId').focus();
                return false;
            }
            
            // Validate designation for coordinator
            if (role === 'faculty' && !document.getElementById('designation').value.trim()) {
                e.preventDefault();
                alert('Please enter your designation');
                document.getElementById('designation').focus();
                return false;
            }
        });
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('role');
            if (roleSelect.value) {
                roleSelect.dispatchEvent(new Event('change'));
            }

            // Toggle password visibility
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');

            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                
                // Toggle eye icon
                eyeIcon.classList.toggle('fa-eye');
                eyeIcon.classList.toggle('fa-eye-slash');
            });
        });
    </script>

</body>
</html>