<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - College Event Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-light min-vh-100">

    <div class="min-vh-100 d-flex align-items-center justify-content-center py-4 px-3">

        <!-- Smaller Card Wrapper -->
        <div class="w-100 bg-white shadow rounded-4 p-4 border"
             style="max-width: 34rem; box-sizing: border-box;">

            <div class="text-center mb-3">
                <div class="mx-auto d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white"
                     style="width: 42px; height: 42px;">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h3 class="mt-3 fw-bold">
                    Create your account
                </h3>
                <p class="text-muted small">
                    Join our College Event Management System
                </p>
            </div>

            <!-- Flash Messages -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Validation Errors -->
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Please fix the following errors:</strong>
                    <ul class="mb-0 mt-2">
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <form action="/auth/register" method="POST" id="registrationForm">
                <div class="row g-2">

                    <div class="col-12">
                        <label for="fullName" class="form-label small">Full Name *</label>
                        <input id="fullName" name="fullName" type="text" required
                               value="<%= typeof formData !== 'undefined' ? formData.fullName : '' %>"
                               class="form-control form-control-sm"
                               placeholder="Enter your full name">
                    </div>

                    <div class="col-12">
                        <label for="email" class="form-label small">Email *</label>
                        <input id="email" name="email" type="email" required
                               value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                               class="form-control form-control-sm"
                               placeholder="Enter your college email">
                    </div>

                    <div class="col-12">
                        <label for="password" class="form-label small">Password *</label>
                        <input id="password" name="password" type="password" required
                               class="form-control form-control-sm"
                               placeholder="Create a password (min 6 characters)">
                    </div>

                    <div class="col-12">
                        <label for="collegeId" class="form-label small">College ID *</label>
                        <input id="collegeId" name="collegeId" type="text" required
                               value="<%= typeof formData !== 'undefined' ? formData.collegeId : '' %>"
                               class="form-control form-control-sm"
                               placeholder="YYCourseCodeRollNo">
                        <div id="collegeIdError" class="text-danger small" style="display: none;"></div>
                    </div>

                    <div class="col-md-6">
                        <label for="department" class="form-label small">Department *</label>
                        <select id="department" name="department" required class="form-select form-select-sm">
                            <option value="">Select Department</option>
                            <option value="Computer Science" <%= typeof formData !== 'undefined' && formData.department === 'Computer Science' ? 'selected' : '' %>>Computer Science</option>
                            <option value="Physics" <%= typeof formData !== 'undefined' && formData.department === 'Physics' ? 'selected' : '' %>>Physics</option>
                            <option value="Mathematics" <%= typeof formData !== 'undefined' && formData.department === 'Mathematics' ? 'selected' : '' %>>Mathematics</option>
                            <option value="Chemistry" <%= typeof formData !== 'undefined' && formData.department === 'Chemistry' ? 'selected' : '' %>>Chemistry</option>
                            <option value="Biology" <%= typeof formData !== 'undefined' && formData.department === 'Biology' ? 'selected' : '' %>>Biology</option>
                            <option value="English" <%= typeof formData !== 'undefined' && formData.department === 'English' ? 'selected' : '' %>>English</option>
                            <option value="Economics" <%= typeof formData !== 'undefined' && formData.department === 'Economics' ? 'selected' : '' %>>Economics</option>
                            <option value="Commerce" <%= typeof formData !== 'undefined' && formData.department === 'Commerce' ? 'selected' : '' %>>Commerce</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="role" class="form-label small">Role *</label>
                        <select id="role" name="role" required class="form-select form-select-sm">
                            <option value="">Select Role</option>
                            <option value="student" <%= typeof formData !== 'undefined' && formData.role === 'student' ? 'selected' : '' %>>Student</option>
                            <option value="faculty" <%= typeof formData !== 'undefined' && formData.role === 'faculty' ? 'selected' : '' %>>Coordinator</option>
                        </select>
                    </div>

                    <div class="col-12" id="designationField" style="display: none;">
                        <label for="designation" class="form-label small">Designation *</label>
                        <input id="designation" name="designation" type="text"
                               value="<%= typeof formData !== 'undefined' ? formData.designation : '' %>"
                               class="form-control form-control-sm"
                               placeholder="e.g., Assistant Professor, Lecturer, HOD">
                        <div class="form-text">Your position in the department</div>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-sm">
                                Create Account
                            </button>
                        </div>
                    </div>

                </div>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted small">
                    Already have an account?
                    <a href="/auth/login" class="text-primary text-decoration-none">
                        Sign in here
                    </a>
                </p>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Student College ID validation function
        function validateStudentCollegeId(collegeId) {
            // Format: YEAR + COURSE + 3 digits
            // Examples: 23BA123, 24BCA456, 25BSC789, 26BPES001
            const pattern = /^\d+(BA|BCA|BSC|BPES)\d{3}$/;
            return pattern.test(collegeId.toUpperCase());
        }

        // Coordinator College ID validation function
        function validateCoordinatorCollegeId(collegeId) {
            // Format: FAC + 3 digits OR DEPT + 3 digits
            // Examples: FAC001, FAC123, DEPT001, DEPT123
            const pattern = /^(FAC\d{3}|DEPT\d{3})$/;
            return pattern.test(collegeId.toUpperCase());
        }

        // Role change handler, dynamic form fields based on role selection
        document.getElementById('role').addEventListener('change', function() {
            const role = this.value;
            const designationField = document.getElementById('designationField');
            const designationInput = document.getElementById('designation');
            const collegeIdInput = document.getElementById('collegeId');
            const collegeIdLabel = collegeIdInput.parentElement.querySelector('label');
            const collegeIdPlaceholder = collegeIdInput;
            const collegeIdHelp = collegeIdInput.parentElement.querySelector('.form-text');
            
            if (role === 'faculty') {
                // Show designation field for coordinator
                designationField.style.display = 'block';
                designationInput.setAttribute('required', 'required');
                
                // Update College ID guidance for coordinator
                collegeIdLabel.textContent = 'College ID *';
                collegeIdPlaceholder.placeholder = 'Coordinator ID (e.g., FAC001, DEPT123)';
                collegeIdHelp.textContent = 'Format: FAC001 or DEPT123';
                
                // Enable Coordinator College ID validation
                collegeIdInput.removeEventListener('input', validateStudentCollegeId);
                collegeIdInput.addEventListener('input', function() {
                    const collegeId = this.value;
                    const errorDiv = document.getElementById('collegeIdError');
                    const submitButton = document.querySelector('button[type="submit"]');
                    
                    if (collegeId && !validateCoordinatorCollegeId(collegeId)) {
                        errorDiv.style.display = 'block';
                        errorDiv.textContent = 'Invalid Coordinator ID format. Use: FAC001 or DEPT123';
                        this.classList.add('is-invalid');
                        submitButton.disabled = true;
                    } else {
                        errorDiv.style.display = 'none';
                        this.classList.remove('is-invalid');
                        submitButton.disabled = false;
                    }
                });
                collegeIdInput.classList.remove('is-invalid');
                document.getElementById('collegeIdError').style.display = 'none';
                document.querySelector('button[type="submit"]').disabled = false;
                
            } else if (role === 'student') {
                // Hide designation field for students
                designationField.style.display = 'none';
                designationInput.removeAttribute('required');
                designationInput.value = '';
                
                // Update College ID guidance for students
                collegeIdLabel.textContent = 'College ID *';
                collegeIdPlaceholder.placeholder = 'e.g., 23BA123, 24BCA456';
                collegeIdHelp.textContent = 'Format: YEAR + COURSE + 3 digits';
                
                // Re-enable Student College ID validation
                collegeIdInput.removeEventListener('input', validateCoordinatorCollegeId);
                collegeIdInput.addEventListener('input', function() {
                    const collegeId = this.value;
                    const errorDiv = document.getElementById('collegeIdError');
                    const submitButton = document.querySelector('button[type="submit"]');
                    
                    if (collegeId && !validateStudentCollegeId(collegeId)) {
                        errorDiv.style.display = 'block';
                        errorDiv.textContent = 'Invalid College ID format. Use format: YEAR + COURSE + 3 digits (e.g., 23BA123)';
                        this.classList.add('is-invalid');
                        submitButton.disabled = true;
                    } else {
                        errorDiv.style.display = 'none';
                        this.classList.remove('is-invalid');
                        submitButton.disabled = false;
                    }
                });
                collegeIdInput.classList.remove('is-invalid');
                document.getElementById('collegeIdError').style.display = 'none';
                document.querySelector('button[type="submit"]').disabled = false;
            } else {
                // Hide designation field for other roles
                designationField.style.display = 'none';
                designationInput.removeAttribute('required');
                designationInput.value = '';
            }
        });
        // Form submission validation
        document.getElementById('registrationForm').addEventListener('submit', function(e) {
            const role = document.getElementById('role').value;
            const collegeId = document.getElementById('collegeId').value;
            
            // Validate College ID format based on role
            if (role === 'student' && !validateStudentCollegeId(collegeId)) {
                e.preventDefault();
                document.getElementById('collegeIdError').style.display = 'block';
                document.getElementById('collegeIdError').textContent = 'Invalid College ID format. Use format: YEAR + COURSE + 3 digits (e.g., 23BA123)';
                document.getElementById('collegeId').classList.add('is-invalid');
                document.getElementById('collegeId').focus();
                return false;
            }
            
            if (role === 'faculty' && !validateCoordinatorCollegeId(collegeId)) {
                e.preventDefault();
                document.getElementById('collegeIdError').style.display = 'block';
                document.getElementById('collegeIdError').textContent = 'Invalid Coordinator ID format. Use: FAC001 or DEPT123';
                document.getElementById('collegeId').classList.add('is-invalid');
                document.getElementById('collegeId').focus();
                return false;
            }
            
            // Validate designation for coordinator
            if (role === 'faculty' && !document.getElementById('designation').value.trim()) {
                e.preventDefault();
                alert('Please enter your designation');
                document.getElementById('designation').focus();
                return false;
            }
        });
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('role');
            if (roleSelect.value) {
                roleSelect.dispatchEvent(new Event('change'));
            }
        });
    </script>

</body>
</html>