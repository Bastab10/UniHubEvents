<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - College Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .form-input:focus {
            border-color: #0ea5a4;
            box-shadow: 0 0 0 3px rgba(14, 165, 164, 0.1);
            outline: none;
        }
        .btn-primary-teal {
            background-color: #0ea5a4;
            color: white;
            transition: all 0.2s ease;
        }
        .btn-primary-teal:hover {
            background-color: #0d9488;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(14, 165, 164, 0.3);
        }
        .btn-primary-teal:focus {
            box-shadow: 0 0 0 3px rgba(14, 165, 164, 0.3);
        }
        @media (max-width: 640px) {
            .form-input, .form-select {
                font-size: 16px;
            }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen flex items-center justify-center py-8 px-4">

    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-200">

            <div class="text-center mb-6">
                <div class="mx-auto inline-flex items-center justify-center rounded-full bg-[#0ea5a4] text-white w-10 h-10">
                    <i class="fas fa-calendar-alt text-lg"></i>
                </div>
                <h3 class="mt-4 text-2xl font-bold text-gray-900">
                    Sign in to your account
                </h3>
                <p class="text-gray-500 text-sm mt-1">
                    College Event Management System
                </p>
            </div>

            <form action="/auth/login" method="POST" class="space-y-4">

                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username or Email</label>
                    <input id="username" name="username" type="text" required
                           value="<%= typeof username !== 'undefined' ? username : '' %>"
                           class="form-input w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm transition-all"
                           placeholder="Enter your username or email"
                           autocomplete="username">
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input id="password" name="password" type="password" required
                           class="form-input w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm transition-all"
                           placeholder="Enter your password"
                           autocomplete="current-password">
                </div>

                <div>
                    <label for="role" class="block text-sm font-medium text-gray-700 mb-1">Select Role</label>
                    <select id="role" name="role" required class="form-select w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm bg-white transition-all">
                        <option value="">Choose your role</option>
                        <option value="student" <%= typeof selectedRole !== 'undefined' && selectedRole === 'student' ? 'selected' : '' %>>
                            Student
                        </option>
                        <option value="faculty" <%= typeof selectedRole !== 'undefined' && selectedRole === 'faculty' ? 'selected' : '' %>>
                            Coordinator
                        </option>
                        <option value="admin" <%= typeof selectedRole !== 'undefined' && selectedRole === 'admin' ? 'selected' : '' %>>
                            Admin
                        </option>
                    </select>
                </div>

                <div class="flex items-center gap-2">
                    <input id="remember-me" name="remember-me" type="checkbox" class="w-4 h-4 text-[#0ea5a4] border-gray-300 rounded focus:ring-[#0ea5a4]">
                    <label for="remember-me" class="text-sm text-gray-600">Remember me</label>
                </div>

                <button type="submit" class="btn-primary-teal w-full py-2.5 px-4 rounded-lg font-semibold text-sm flex items-center justify-center gap-2">
                    <i class="fas fa-sign-in-alt"></i>
                    Sign in
                </button>

            </form>

            <div class="text-center mt-6 pt-4 border-t border-gray-100">
                <p class="text-gray-500 text-sm">
                    Don't have an account?
                    <a href="/auth/register" class="text-[#0ea5a4] hover:text-[#0d9488] font-medium">
                        Register here
                    </a>
                </p>
            </div>

        </div>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
        <div id="successMessage"
             class="fixed top-4 right-4 bg-green-100 border-l-4 border-green-500 text-green-700 px-4 py-3 rounded-lg shadow-lg z-50">
            <div class="flex items-center">
                <i class="fas fa-check-circle mr-2"></i>
                <%= success %>
            </div>
        </div>
    <% } %>

    <% if (error) { %>
        <div id="errorMessage"
             class="fixed top-4 right-4 bg-red-100 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded-lg shadow-lg z-50">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <%= error %>
            </div>
        </div>
    <% } %>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const successMessage = document.getElementById('successMessage');
            if (successMessage) {
                setTimeout(function() {
                    successMessage.style.transition = 'opacity 0.5s';
                    successMessage.style.opacity = '0';
                    setTimeout(function() {
                        successMessage.remove();
                    }, 500);
                }, 5000);
            }
        });
    </script>

</body>
</html>