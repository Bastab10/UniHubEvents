<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - College Event Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .btn-primary {
            background-color: #0ea5a4 !important;
            border-color: #0ea5a4 !important;
            color: white !important;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            background-color: #0d9488 !important;
            border-color: #0d9488 !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(14, 165, 164, 0.3);
        }

        .btn-primary:focus {
            background-color: #0d9488 !important;
            border-color: #0d9488 !important;
            box-shadow: 0 0 0 3px rgba(14, 165, 164, 0.3);
        }
        
        /* Match registration form container and centering */
        body {
            background: #f8f9fa;
        }
        
        .min-vh-100 {
            min-height: 100vh;
        }
        
        .d-flex {
            display: flex;
        }
        
        .align-items-center {
            align-items: center;
        }
        
        .justify-content-center {
            justify-content: center;
        }
        
        .bg-light {
            background-color: #f8f9fa;
        }
        
        /* Form field styling to match registration */
        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }
        
        .form-control {
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        
        .form-control:focus {
            border-color: #0ea5a4;
            box-shadow: 0 0 0 0.25rem rgba(14, 165, 164, 0.1);
        }
        
        .form-select {
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        
        .form-select:focus {
            border-color: #0ea5a4;
            box-shadow: 0 0 0 0.25rem rgba(14, 165, 164, 0.1);
        }
        
        .shadow {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
        
        .rounded-4 {
            border-radius: 0.5rem !important;
        }
        
        .border {
            border: 1px solid #dee2e6 !important;
        }
        
        /* Mobile responsiveness */
        @media (max-width: 576px) {
            .container {
                padding: 0.75rem;
            }
            
            .bg-white.shadow.rounded-4.p-4.border {
                margin: 0.5rem;
                padding: 1rem !important;
            }
            
            .form-control, .form-select {
                font-size: 16px !important; /* Prevents zoom on iOS */
                padding: 0.75rem;
            }
            
            .btn {
                padding: 0.75rem;
                font-size: 1rem;
            }
            
            .form-label {
                font-weight: 600;
                margin-bottom: 0.5rem;
            }
        }
        
        @media (max-width: 480px) {
            .container {
                padding: 0.5rem;
            }
            
            .bg-white.shadow.rounded-4.p-4.border {
                margin: 0.25rem;
                padding: 1.5rem !important;
            }
            
            h3 {
                font-size: 1.5rem !important;
            }
            
            .text-muted {
                font-size: 0.875rem !important;
            }
        }
        
        /* Touch-friendly targets */
        .form-control:focus, .form-select:focus {
            transform: scale(1.02);
            transition: transform 0.2s ease;
        }
        
        .btn:hover {
            transform: translateY(-1px);
            transition: all 0.2s ease;
        }
        
        /* Prevent horizontal scroll */
        body {
            overflow-x: hidden;
        }
    </style>
</head>

<body class="bg-light min-vh-100 d-flex align-items-center">

    <div class="container mobile-form-container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                <!-- CARD WRAPPER (Match Registration Form Size) -->
                <div class="bg-white shadow rounded-4 p-4 border" 
                     style="max-width: 34rem; box-sizing: border-box; margin: 0 auto;">

                    <div class="text-center mb-3">
                        <div class="mx-auto d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white"
                             style="width: 42px; height: 42px;">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <h3 class="mt-3 fw-bold">
                            Sign in to your account
                        </h3>
                        <p class="text-muted small">
                            College Event Management System
                        </p>
                    </div>

                    <form action="/auth/login" method="POST">

                        <div class="mb-3">
                            <label for="username" class="form-label small">Username or Email</label>
                            <input id="username" name="username" type="text" required
                                   value="<%= typeof username !== 'undefined' ? username : '' %>"
                                   class="form-control form-control-sm"
                                   placeholder="Enter your username or email"
                                   autocomplete="username">
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label small">Password</label>
                            <input id="password" name="password" type="password" required
                                   class="form-control form-control-sm"
                                   placeholder="Enter your password"
                                   autocomplete="current-password">
                        </div>

                        <div class="mb-3">
                            <label for="role" class="form-label small">Select Role</label>
                            <select id="role" name="role" required class="form-select form-select-sm">
                                <option value="">Choose your role</option>
                                <option value="student" <%= typeof selectedRole !== 'undefined' && selectedRole === 'student' ? 'selected' : '' %>>
                                    Student
                                </option>
                                <option value="faculty" <%= typeof selectedRole !== 'undefined' && selectedRole === 'faculty' ? 'selected' : '' %>>
                                    Coordinator
                                </option>
                                <option value="admin" <%= typeof selectedRole !== 'undefined' && selectedRole === 'admin' ? 'selected' : '' %>>
                                    Admin
                                </option>
                            </select>
                        </div>

                        <div class="mb-3 form-check">
                            <input id="remember-me" name="remember-me" type="checkbox" class="form-check-input">
                            <label for="remember-me" class="form-check-label">
                                Remember me
                            </label>
                        </div>

                        <div class="mb-4">
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    Sign in
                                </button>
                            </div>
                        </div>

                    </form>

                    <div class="text-center mt-3">
                        <p class="text-muted">
                            Don't have an account?
                            <a href="/auth/register" class="text-primary text-decoration-none">
                                Register here
                            </a>
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
        <div id="successMessage"
             class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3"
             style="z-index: 1050;">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <%= success %>
            </div>
        </div>
    <% } %>

    <% if (error) { %>
        <div id="errorMessage"
             class="alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 m-3"
             style="z-index: 1050;">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-circle me-2"></i>
                <%= error %>
            </div>
        </div>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-hide success message after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const successMessage = document.getElementById('successMessage');
            if (successMessage) {
                setTimeout(function() {
                    successMessage.style.transition = 'opacity 0.5s';
                    successMessage.style.opacity = '0';
                    setTimeout(function() {
                        successMessage.remove();
                    }, 500);
                }, 5000);
            }
        });
    </script>

</body>
</html>