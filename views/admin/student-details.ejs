<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - NLU Event Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <%- include('../partials/header') %>
    
    <div class="flex h-screen">
        <%- include('../partials/sidebar') %>
        
        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                <div class="mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">Student Details</h1>
                            <p class="text-gray-600">Complete student profile and registration information</p>
                        </div>
                        <div class="flex space-x-4">
                            <a href="/admin/dashboard" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
                                <i class="fas fa-arrow-left mr-2"></i>
                                Back to Dashboard
                            </a>
                            <!-- <a href="/admin/students" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                                <i class="fas fa-users mr-2"></i>
                                All Students
                            </a> -->
                        </div>
                    </div>
                </div>

                <!-- Student Profile Information -->
                <div class="bg-white p-6 rounded-lg shadow">
                    <div class="flex items-center mb-4">
                        <div class="h-16 w-16 rounded-full bg-gray-200 flex items-center justify-center">
                            <i class="fas fa-user text-gray-500 text-2xl"></i>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-semibold text-gray-900">Personal Information</h3>
                            <p class="text-sm text-gray-500">Basic student details</p>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <div class="flex justify-between">
                            <span class="text-sm font-medium text-gray-700">Full Name:</span>
                            <span class="text-sm text-gray-900">
                                <%= student.profile.firstName %> <%= student.profile.lastName %>
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm font-medium text-gray-700">Email:</span>
                            <span class="text-sm text-gray-900">
                                <%= student.profile.email %>
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm font-medium text-gray-700">College ID:</span>
                            <span class="text-sm text-gray-900">
                                <%= student.profile.collegeId || 'N/A' %>
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm font-medium text-gray-700">Department:</span>
                            <span class="text-sm text-gray-900">
                                <%= student.profile.department || 'N/A' %>
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm font-medium text-gray-700">Verification Status:</span>
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                                <% if (student.profile.verified) { %>
                                    bg-green-100 text-green-800
                                <% } else { %>
                                    bg-red-100 text-red-800
                                <% } %>
                            ">
                                <% if (student.profile.verified) { %>
                                    <i class="fas fa-check-circle mr-1"></i>
                                    Verified
                                <% } else { %>
                                    <i class="fas fa-exclamation-triangle mr-1"></i>
                                    Not Verified
                                <% } %>
                            </span>
                        </div>
                        <% if (student.profile.verifiedDate) { %>
                            <div class="flex justify-between">
                                <span class="text-sm font-medium text-gray-700">Verified Date:</span>
                                <span class="text-sm text-gray-900">
                                    <%= new Date(student.profile.verifiedDate).toLocaleDateString() %>
                                </span>
                            </div>
                        <% } %>
                        <% if (student.profile.verifiedBy) { %>
                            <div class="flex justify-between">
                                <span class="text-sm font-medium text-gray-700">Verified By:</span>
                                <span class="text-sm text-gray-900">
                                    <%= student.profile.verifiedBy.profile.firstName %> <%= student.profile.verifiedBy.profile.lastName %>
                                </span>
                            </div>
                        <% } %>
                        <% if (student.profile.verificationNotes) { %>
                            <div class="flex justify-between">
                                <span class="text-sm font-medium text-gray-700">Verification Notes:</span>
                                <span class="text-sm text-gray-900">
                                    <%= student.profile.verificationNotes %>
                                </span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Student Registration History -->
                <div class="bg-white p-6 rounded-lg shadow">
                    <div class="flex items-center mb-4">
                        <div class="h-16 w-16 rounded-full bg-indigo-100 flex items-center justify-center">
                            <i class="fas fa-calendar-check text-indigo-600 text-2xl"></i>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-semibold text-gray-900">Event Registration History</h3>
                            <p class="text-sm text-gray-500">All events this student has registered for</p>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Event Title
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Event Date
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Category
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Registration Date
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Status
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (studentEvents && studentEvents.length > 0) { %>
                                    <% studentEvents.forEach(event => { %>
                                        <% const registration = event.registrations.find(reg => reg.student && reg.student.toString() === student._id.toString()); %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm font-medium text-gray-900">
                                                    <%= event.title %>
                                                </div>
                                                <div class="text-sm text-gray-500">
                                                    <%= event.venue %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= new Date(event.date).toLocaleDateString() %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= event.category %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= registration ? new Date(registration.registeredAt).toLocaleDateString() : 'N/A' %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                    <% if (registration && registration.status === 'pending') { %>
                                                        bg-yellow-100 text-yellow-800
                                                    <% } else if (registration && registration.status === 'approved') { %>
                                                        bg-green-100 text-green-800
                                                    <% } else if (registration && registration.status === 'rejected') { %>
                                                        bg-red-100 text-red-800
                                                    <% } else { %>
                                                        bg-gray-100 text-gray-800
                                                    <% } %>
                                                ">
                                                    <%= registration ? registration.status.charAt(0).toUpperCase() + registration.status.slice(1) : 'N/A' %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                <button onclick="viewEventDetails('<%= event._id %>')" class="bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700 transition">
                                                    <i class="fas fa-eye mr-1"></i>
                                                    View Event
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                                            <div class="flex flex-col items-center">
                                                <i class="fas fa-calendar-times text-4xl text-gray-300 mb-4"></i>
                                                <p class="text-lg font-medium">No registration history found</p>
                                                <p class="text-sm">This student hasn't registered for any events yet.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
