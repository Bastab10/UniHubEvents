<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - NLU Event Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
    /* Dashboard Container Styles */
    .dashboard-container {
        min-height: 100vh;
        background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
    }

    @media (max-width: 768px) {
        .dashboard-container {
            background: #f9fafb;
        }
    }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    
    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>
        
        <main class="flex-1">
            <div class="p-6">
                <div class="mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">All Events</h1>
                            <p class="text-gray-600">Complete list of all events in the system</p>
                        </div>
                        <div class="flex space-x-4">
                            <a href="/admin/dashboard" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
                                <i class="fas fa-arrow-left mr-2"></i>
                                Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Events List -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Event Title
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Date
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Category
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Venue
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Organizer
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Status
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Registrations
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (events && events.length > 0) { %>
                                    <% events.forEach((event, index) => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm font-medium text-gray-900">
                                                    <%= event.title %>
                                                </div>
                                                <div class="text-sm text-gray-500">
                                                    <%= event.description ? event.description.substring(0, 50) + '...' : 'No description' %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= new Date(event.date).toLocaleDateString() %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= event.category %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= event.venue %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <% if (event.organizer) { %>
                                                    <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                    <% if (event.status === 'pending') { %>
                                                        bg-yellow-100 text-yellow-800
                                                    <% } else if (event.status === 'approved') { %>
                                                        bg-green-100 text-green-800
                                                    <% } else if (event.status === 'rejected') { %>
                                                        bg-red-100 text-red-800
                                                    <% } else { %>
                                                        bg-gray-100 text-gray-800
                                                    <% } %>
                                                ">
                                                    <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= event.registrations ? event.registrations.length : 0 %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                <button onclick="toggleDetails('<%= index %>')" class="bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700 transition">
                                                    <i class="fas fa-eye mr-1"></i>
                                                    View Details
                                                </button>
                                                <button onclick="viewRegistrations('<%= event._id %>')" class="bg-green-600 text-white px-3 py-1 rounded text-xs hover:bg-green-700 transition ml-2">
                                                    <i class="fas fa-users mr-1"></i>
                                                    Registrations
                                                </button>
                                                <% if (event.status === 'pending') { %>
                                                    <button onclick="approveEvent('<%= event._id %>')" class="bg-purple-600 text-white px-3 py-1 rounded text-xs hover:bg-purple-700 transition ml-2">
                                                        <i class="fas fa-check mr-1"></i>
                                                        Approve
                                                    </button>
                                                    <button onclick="rejectEvent('<%= event._id %>')" class="bg-red-600 text-white px-3 py-1 rounded text-xs hover:bg-red-700 transition ml-2">
                                                        <i class="fas fa-times mr-1"></i>
                                                        Reject
                                                    </button>
                                                <% } %>
                                            </td>
                                        </tr>
                                        
                                        <!-- Event Details Row (Hidden by default) -->
                                        <tr id="details-<%= index %>" class="hidden bg-gray-50">
                                            <td colspan="8" class="px-6 py-4">
                                                <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-200">
                                                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                                        <!-- Event Information -->
                                                        <div class="lg:col-span-2">
                                                            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                                                                <i class="fas fa-calendar text-blue-600 mr-2"></i>
                                                                Event Information
                                                            </h3>
                                                            
                                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                                                <div>
                                                                    <h4 class="text-sm font-medium text-gray-700 mb-2">Basic Details</h4>
                                                                    <div class="space-y-2">
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Category:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= event.category %></span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Date:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= new Date(event.date).toLocaleDateString() %></span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Time:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= event.time || 'Not specified' %></span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Duration:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= event.duration || 'Not specified' %></span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Venue:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= event.venue %></span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Max Participants:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= event.maxParticipants || 'Unlimited' %></span>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div>
                                                                    <h4 class="text-sm font-medium text-gray-700 mb-2">Organizer Information</h4>
                                                                    <div class="space-y-2">
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Name:</span>
                                                                            <span class="text-sm font-medium text-gray-900">
                                                                                <% if (event.organizer) { %>
                                                                                    <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                                                                <% } else { %>
                                                                                    N/A
                                                                                <% } %>
                                                                            </span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Email:</span>
                                                                            <span class="text-sm font-medium text-gray-900">
                                                                                <% if (event.organizer) { %>
                                                                                    <%= event.organizer.profile.email %>
                                                                                <% } else { %>
                                                                                    N/A
                                                                                <% } %>
                                                                            </span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Department:</span>
                                                                            <span class="text-sm font-medium text-gray-900">
                                                                                <% if (event.organizer) { %>
                                                                                    <%= event.organizer.profile.department || 'N/A' %>
                                                                                <% } else { %>
                                                                                    N/A
                                                                                <% } %>
                                                                            </span>
                                                                        </div>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-sm text-gray-600">Created:</span>
                                                                            <span class="text-sm font-medium text-gray-900"><%= new Date(event.createdAt).toLocaleDateString() %></span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div>
                                                                <h4 class="text-sm font-medium text-gray-700 mb-2">Description</h4>
                                                                <p class="text-sm text-gray-600"><%= event.description || 'No description provided' %></p>
                                                            </div>
                                                        </div>

                                                        <!-- Registration Statistics -->
                                                        <div>
                                                            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                                                                <i class="fas fa-users text-green-600 mr-2"></i>
                                                                Registration Statistics
                                                            </h3>
                                                            
                                                            <div class="grid grid-cols-2 gap-3 mb-4">
                                                                <div class="text-center bg-blue-50 p-3 rounded-lg">
                                                                    <div class="text-2xl font-bold text-blue-600">
                                                                        <%= event.registrations ? event.registrations.length : 0 %>
                                                                    </div>
                                                                    <p class="text-xs text-gray-600">Total</p>
                                                                </div>
                                                                <div class="text-center bg-green-50 p-3 rounded-lg">
                                                                    <div class="text-2xl font-bold text-green-600">
                                                                        <%= event.registrations ? event.registrations.filter(reg => reg.status === 'approved').length : 0 %>
                                                                    </div>
                                                                    <p class="text-xs text-gray-600">Approved</p>
                                                                </div>
                                                                <div class="text-center bg-yellow-50 p-3 rounded-lg">
                                                                    <div class="text-2xl font-bold text-yellow-600">
                                                                        <%= event.registrations ? event.registrations.filter(reg => reg.status === 'pending').length : 0 %>
                                                                    </div>
                                                                    <p class="text-xs text-gray-600">Pending</p>
                                                                </div>
                                                                <div class="text-center bg-red-50 p-3 rounded-lg">
                                                                    <div class="text-2xl font-bold text-red-600">
                                                                        <%= event.registrations ? event.registrations.filter(reg => reg.status === 'rejected').length : 0 %>
                                                                    </div>
                                                                    <p class="text-xs text-gray-600">Rejected</p>
                                                                </div>
                                                            </div>

                                                            <!-- Action Buttons -->
                                                            <div class="space-y-2">
                                                                <% if (event.status === 'pending') { %>
                                                                    <button onclick="approveEvent('<%= event._id %>')" class="w-full bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                                                                        <i class="fas fa-check mr-2"></i>
                                                                        Approve Event
                                                                    </button>
                                                                    <button onclick="rejectEvent('<%= event._id %>')" class="w-full bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                                                                        <i class="fas fa-times mr-2"></i>
                                                                        Reject Event
                                                                    </button>
                                                                <% } %>
                                                                <button onclick="viewRegistrations('<%= event._id %>')" class="w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                                                                    <i class="fas fa-users mr-2"></i>
                                                                    View All Registrations
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9" class="px-6 py-8 text-center text-gray-500">
                                            <div class="flex flex-col items-center">
                                                <i class="fas fa-calendar-times text-4xl text-gray-300 mb-4"></i>
                                                <p class="text-lg font-medium">No events found</p>
                                                <p class="text-sm">There are no events in the system yet.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleDetails(index) {
            const detailsRow = document.getElementById(`details-${index}`);
            detailsRow.classList.toggle('hidden');
        }

        function viewEventDetails(eventId) {
            // This function is no longer needed since details are shown inline
            console.log('Event details shown inline');
        }

        function viewRegistrations(eventId) {
            window.location.href = `/admin/events/${eventId}/registrations`;
        }

        function approveEvent(eventId) {
            if (confirm('Are you sure you want to approve this event?')) {
                fetch(`/admin/events/${eventId}/approve`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Event approved successfully!');
                        window.location.reload();
                    } else {
                        alert('Error approving event: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error approving event');
                });
            }
        }

        function rejectEvent(eventId) {
            const reason = prompt('Please enter rejection reason:');
            if (reason) {
                fetch(`/admin/events/${eventId}/reject`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ reason })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Event rejected successfully!');
                        window.location.reload();
                    } else {
                        alert('Error rejecting event: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error rejecting event');
                });
            }
        }
    </script>
</body>
</html>
