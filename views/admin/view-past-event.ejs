<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - NLU Event Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
    /* Dashboard Container Styles */
    .dashboard-container {
        min-height: 100vh;
        background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
    }

    @media (max-width: 768px) {
        .dashboard-container {
            background: #f9fafb;
        }
    }

    /* Past Event Badge */
    .past-badge {
        background-color: #6b7280;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* Event Poster */
    .event-poster {
        width: 100%;
        max-width: 300px;
        height: 200px;
        object-fit: cover;
        border-radius: 12px;
    }

    .event-poster-placeholder {
        width: 100%;
        max-width: 300px;
        height: 200px;
        border-radius: 12px;
        background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    </style>
</head>
<body class="bg-gray-50">
    <%- include('../partials/header') %>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                <!-- Header -->
                <div class="mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">Past Event Details</h1>
                            <p class="text-gray-600">Complete information for completed event</p>
                        </div>
                    </div>
                </div>

                <!-- Event Information -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                    <!-- Event Poster & Quick Info -->
                    <div class="lg:col-span-1">
                        <div class="bg-white p-6 rounded-lg shadow">
                            <% if (event.poster && event.poster.trim() !== '') { %>
                                <img src="/uploads/<%= event.poster %>" alt="<%= event.title %>" class="event-poster mb-4">
                            <% } else { %>
                                <div class="event-poster-placeholder mb-4">
                                    <i class="fas fa-calendar-alt text-gray-400 text-4xl"></i>
                                </div>
                            <% } %>
                            <div class="text-center">
                                <span class="past-badge">Completed</span>
                                <% if (event.status) { %>
                                    <span class="ml-2 px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                                        <% if (event.status === 'pending') { %>
                                            bg-yellow-100 text-yellow-800
                                        <% } else if (event.status === 'approved') { %>
                                            bg-green-100 text-green-800
                                        <% } else if (event.status === 'rejected') { %>
                                            bg-red-100 text-red-800
                                        <% } else { %>
                                            bg-gray-100 text-gray-800
                                        <% } %>
                                    ">
                                        <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                    </span>
                                <% } %>
                            </div>
                            <div class="mt-4 text-center">
                                <p class="text-sm text-gray-500">Total Registrations</p>
                                <p class="text-3xl font-bold text-gray-800"><%= event.registrations ? event.registrations.length : 0 %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Event Details -->
                    <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow">
                        <div class="flex items-center mb-4">
                            <div class="h-16 w-16 rounded-full bg-gray-200 flex items-center justify-center">
                                <i class="fas fa-calendar text-gray-600 text-2xl"></i>
                            </div>
                            <div class="ml-4">
                                <h2 class="text-xl font-bold text-gray-900"><%= event.title %></h2>
                                <% if (event.category) { %>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mt-1
                                        <% if (event.category === 'sports') { %>
                                            bg-green-100 text-green-800
                                        <% } else if (event.category === 'workshop') { %>
                                            bg-blue-100 text-blue-800
                                        <% } else if (event.category === 'cultural') { %>
                                            bg-purple-100 text-purple-800
                                        <% } else if (event.category === 'seminar') { %>
                                            bg-yellow-100 text-yellow-800
                                        <% } else { %>
                                            bg-gray-100 text-gray-800
                                        <% } %>
                                    ">
                                        <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <h3 class="text-sm font-medium text-gray-700 mb-3 border-b pb-2">Event Information</h3>
                                <div class="space-y-3">
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-tag mr-2 text-gray-400"></i>Category:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.category || 'N/A' %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-calendar mr-2 text-gray-400"></i>Date:</span>
                                        <span class="text-sm font-medium text-gray-900">
                                            <%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-clock mr-2 text-gray-400"></i>Time:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.startTime || 'N/A' %> - <%= event.endTime || 'N/A' %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-hourglass-half mr-2 text-gray-400"></i>Duration:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.duration || 'Not specified' %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-map-marker-alt mr-2 text-gray-400"></i>Venue:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.venue || 'N/A' %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-users mr-2 text-gray-400"></i>Max Participants:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.maxParticipants || 'Unlimited' %></span>
                                    </div>
                                    <% if (event.eventType) { %>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-layer-group mr-2 text-gray-400"></i>Event Type:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.eventType.charAt(0).toUpperCase() + event.eventType.slice(1) %></span>
                                    </div>
                                    <% } %>
                                    <% if (event.teamSize && event.teamSize > 1) { %>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-user-friends mr-2 text-gray-400"></i>Team Size:</span>
                                        <span class="text-sm font-medium text-gray-900"><%= event.teamSize %> members</span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>

                            <div>
                                <h3 class="text-sm font-medium text-gray-700 mb-3 border-b pb-2">Organizer Information</h3>
                                <div class="space-y-3">
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-user mr-2 text-gray-400"></i>Name:</span>
                                        <span class="text-sm font-medium text-gray-900">
                                            <% if (event.organizer) { %>
                                                <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-envelope mr-2 text-gray-400"></i>Email:</span>
                                        <span class="text-sm font-medium text-gray-900">
                                            <% if (event.organizer) { %>
                                                <%= event.organizer.profile.email %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-building mr-2 text-gray-400"></i>Department:</span>
                                        <span class="text-sm font-medium text-gray-900">
                                            <% if (event.organizer) { %>
                                                <%= event.organizer.profile.department || 'N/A' %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-calendar-plus mr-2 text-gray-400"></i>Event Created:</span>
                                        <span class="text-sm font-medium text-gray-900">
                                            <% if (event.createdAt) { %>
                                                <%= new Date(event.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </span>
                                    </div>
                                    <% if (event.organizer && event.organizer.createdAt) { %>
                                    <div class="flex justify-between">
                                        <span class="text-sm text-gray-600"><i class="fas fa-user-clock mr-2 text-gray-400"></i>Organizer Since:</span>
                                        <span class="text-sm font-medium text-gray-900">
                                            <%= new Date(event.organizer.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t">
                            <h3 class="text-sm font-medium text-gray-700 mb-2">Description</h3>
                            <p class="text-sm text-gray-600 leading-relaxed"><%= event.description || 'No description provided' %></p>
                        </div>
                    </div>
                </div>

                <!-- Recent Registrations Section -->
                <div class="bg-white p-6 rounded-lg shadow">
                    <div class="flex items-center mb-4">
                        <div class="h-12 w-12 rounded-full bg-indigo-100 flex items-center justify-center">
                            <i class="fas fa-user-check text-indigo-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-semibold text-gray-900">Recent Registrations</h3>
                            <p class="text-sm text-gray-600">Students who registered for this event</p>
                        </div>
                        <div class="ml-auto">
                            <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-sm font-medium">
                                Total: <%= event.registrations ? event.registrations.length : 0 %>
                            </span>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Student Name
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Email
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        College ID
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Registration Date
                                    </th>
                                    <th class="text-center px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Status
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (event.registrations && event.registrations.length > 0) { %>
                                    <% event.registrations.forEach(registration => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
                                                        <i class="fas fa-user text-gray-500 text-sm"></i>
                                                    </div>
                                                    <div class="ml-3">
                                                        <div class="text-sm font-medium text-gray-900">
                                                            <% if (registration.student) { %>
                                                                <%= registration.student.profile.firstName %> <%= registration.student.profile.lastName %>
                                                            <% } else { %>
                                                                Student Not Found
                                                            <% } %>
                                                        </div>
                                                        <% if (registration.student && registration.student.profile.department) { %>
                                                            <div class="text-xs text-gray-500">
                                                                <%= registration.student.profile.department %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <% if (registration.student) { %>
                                                    <%= registration.student.profile.email %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <% if (registration.student) { %>
                                                    <%= registration.student.profile.collegeId || 'N/A' %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <% if (registration.registeredAt) { %>
                                                    <%= new Date(registration.registeredAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                                                    <% if (registration.status === 'pending') { %>
                                                        bg-yellow-100 text-yellow-800
                                                    <% } else if (registration.status === 'approved') { %>
                                                        bg-green-100 text-green-800
                                                    <% } else if (registration.status === 'rejected') { %>
                                                        bg-red-100 text-red-800
                                                    <% } else { %>
                                                        bg-gray-100 text-gray-800
                                                    <% } %>
                                                ">
                                                    <%= registration.status ? registration.status.charAt(0).toUpperCase() + registration.status.slice(1) : 'Unknown' %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                            <div class="flex flex-col items-center">
                                                <i class="fas fa-user-times text-4xl text-gray-300 mb-4"></i>
                                                <p class="text-lg font-medium">No registrations yet</p>
                                                <p class="text-sm">No students have registered for this event.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function deletePastEvent(eventId) {
            if (confirm('Are you sure you want to delete this past event? This action cannot be undone.')) {
                fetch(`/admin/past-events/${eventId}/delete`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Event deleted successfully!');
                        window.location.href = '/admin/past-events';
                    } else {
                        alert('Error deleting event: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error deleting event');
                });
            }
        }
    </script>
</body>
</html>
