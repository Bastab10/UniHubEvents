<div class="min-h-screen bg-gray-50">
    <main class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto mb-8">
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-8">
                <div class="text-center mb-6">
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Profile Information</h3>
                    <p class="text-gray-600">Manage your administrative account and system settings</p>
                </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Profile Card -->
                        <div class="lg:col-span-1">
                            <div class="text-center">
                                <div class="mx-auto h-16 w-16 bg-gray-200 rounded-full flex items-center justify-center mb-3">
                                    <i class="fas fa-user-shield text-gray-400 text-2xl"></i>
                                </div>
                                <h2 class="text-lg font-semibold text-gray-800 mb-1">
                                    <%= currentUser.profile.firstName %> <%= currentUser.profile.lastName %>
                                </h2>
                                <p class="text-sm text-gray-600 mb-2"><%= currentUser.email %></p>
                                <span class="inline-block px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full">
                                    <%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %>
                                </span>
                            </div>
                        </div>

                        <!-- Profile Form -->
                        <div class="lg:col-span-2">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Edit Profile</h3>
                            <form method="POST" action="/admin/profile" class="space-y-3">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <div>
                                        <label for="firstName" class="block text-xs font-medium text-gray-700 mb-1">First Name</label>
                                        <input type="text" id="firstName" name="firstName" value="<%= currentUser.profile.firstName %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                                               required>
                                    </div>
                                    <div>
                                        <label for="lastName" class="block text-xs font-medium text-gray-700 mb-1">Last Name</label>
                                        <input type="text" id="lastName" name="lastName" value="<%= currentUser.profile.lastName %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                                               required>
                                    </div>
                                </div>

                                <div>
                                    <label for="email" class="block text-xs font-medium text-gray-700 mb-1">Email</label>
                                    <input type="email" id="email" name="email" value="<%= currentUser.email %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                                           placeholder="Enter your email" readonly>
                                    <p class="text-xs text-gray-500 mt-1">Email can be updated by contacting system administrator</p>
                                </div>

                                <div>
                                    <label for="collegeId" class="block text-xs font-medium text-gray-700 mb-1">Admin ID</label>
                                    <input type="text" id="collegeId" name="collegeId" value="<%= currentUser.profile.collegeId %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                                           placeholder="Enter your admin ID" readonly>
                                    <p class="text-xs text-gray-500 mt-1">Admin ID cannot be changed</p>
                                </div>

                                <div>
                                    <label for="phone" class="block text-xs font-medium text-gray-700 mb-1">Phone Number</label>
                                    <input type="tel" id="phone" name="phone" value="<%= currentUser.profile.phone || '' %>"
                                           class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                                           placeholder="Enter your phone number">
                                </div>

                                <div>
                                    <label for="department" class="block text-xs font-medium text-gray-700 mb-1">Department</label>
                                    <select id="department" name="department" 
                                            class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                                        <option value="">Select Department</option>
                                        <option value="System Administration" <%= currentUser.profile.department === 'System Administration' ? 'selected' : '' %>>System Administration</option>
                                        <option value="IT Department" <%= currentUser.profile.department === 'IT Department' ? 'selected' : '' %>>IT Department</option>
                                        <option value="Academic Affairs" <%= currentUser.profile.department === 'Academic Affairs' ? 'selected' : '' %>>Academic Affairs</option>
                                        <option value="Student Services" <%= currentUser.profile.department === 'Student Services' ? 'selected' : '' %>>Student Services</option>
                                    </select>
                                </div>

                                <div class="flex justify-end space-x-2 pt-2">
                                    <button type="button" class="px-3 py-1.5 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                                        Cancel
                                    </button>
                                    <button type="submit" class="px-3 py-1.5 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700">
                                        Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Admin Statistics -->
            <div class="max-w-4xl mx-auto">
                <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 bg-red-100 rounded-full">
                                <i class="fas fa-users text-red-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Total Users</p>
                                <p class="text-2xl font-bold text-gray-800">0</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 bg-blue-100 rounded-full">
                                <i class="fas fa-calendar text-blue-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Total Events</p>
                                <p class="text-2xl font-bold text-gray-800">0</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 bg-green-100 rounded-full">
                                <i class="fas fa-user-check text-green-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Active Faculty</p>
                                <p class="text-2xl font-bold text-gray-800">0</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 bg-purple-100 rounded-full">
                                <i class="fas fa-graduation-cap text-purple-600 text-xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Active Students</p>
                                <p class="text-2xl font-bold text-gray-800">0</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Settings Card -->
            <div class="max-w-4xl mx-auto">
                <div class="mt-8">
                    <div class="bg-gradient-to-r from-red-500 to-orange-600 rounded-xl shadow-xl p-6 text-white relative overflow-hidden">
                        <!-- Decorative Elements -->
                        <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-16 -mt-16"></div>
                        <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/10 rounded-full -ml-12 -mb-12"></div>
                        
                        <div class="relative z-10">
                            <!-- Badge -->
                            <div class="inline-flex items-center bg-white/20 backdrop-blur-sm rounded-full px-3 py-1 mb-4">
                                <span class="text-yellow-300 text-sm font-semibold">⚙️ System Administration</span>
                            </div>
                            
                            <!-- Settings Content -->
                            <h3 class="text-2xl font-bold mb-3">System Management</h3>
                            
                            <div class="flex items-center mb-4">
                                <i class="fas fa-shield-alt mr-2 text-yellow-300"></i>
                                <span class="text-yellow-100">Full system access and control</span>
                            </div>
                            
                            <p class="text-yellow-50 mb-6 leading-relaxed">
                                Manage users, events, registrations, and system settings. Monitor platform activity and ensure smooth operation of the campus event management system.
                            </p>
                            
                            <!-- Quick Actions -->
                            <div class="mt-6 p-4 bg-white/10 backdrop-blur-sm rounded-lg">
                                <div class="flex items-center mb-3">
                                    <i class="fas fa-cogs text-yellow-300 text-xl mr-3"></i>
                                    <span class="text-yellow-300 text-sm font-semibold">Quick Actions</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <button class="w-full bg-white text-red-600 font-semibold py-2 px-4 rounded-lg hover:bg-yellow-50 transition-all transform hover:scale-105 shadow-lg">
                                        <i class="fas fa-users-cog mr-2"></i>
                                        User Management
                                    </button>
                                    <button class="w-full bg-white text-red-600 font-semibold py-2 px-4 rounded-lg hover:bg-yellow-50 transition-all transform hover:scale-105 shadow-lg">
                                        <i class="fas fa-chart-line mr-2"></i>
                                        System Analytics
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Main Action Button -->
                            <button class="w-full bg-white text-red-600 font-semibold py-3 px-6 rounded-lg hover:bg-yellow-50 transition-all transform hover:scale-105 shadow-lg mt-4">
                                <i class="fas fa-cog mr-2"></i>
                                System Settings
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
