<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - NLU Event Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
    /* Dashboard Container Styles */
    .dashboard-container {
        min-height: 100vh;
        background: linear-gradient(to bottom right, #f9fafb, #f3f4f6);
    }

    @media (max-width: 768px) {
        .dashboard-container {
            background: #f9fafb;
        }
    }

    /* Past Event Badge */
    .past-badge {
        background-color: #6b7280;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* Event Image thumbnail */
    .event-thumbnail {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
    }

    .event-thumbnail-placeholder {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Delete button animation */
    .delete-btn {
        transition: all 0.2s ease;
    }

    .delete-btn:hover {
        transform: scale(1.05);
    }

    /* Row highlight on hover */
    .event-row {
        transition: background-color 0.2s ease;
    }

    .event-row:hover {
        background-color: #f9fafb;
    }

    /* Fade out animation for deleted rows */
    .fade-out {
        animation: fadeOut 0.3s ease forwards;
    }

    @keyframes fadeOut {
        from {
            opacity: 1;
            transform: translateX(0);
        }
        to {
            opacity: 0;
            transform: translateX(-20px);
        }
    }
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

        <main class="flex-1">
            <div class="p-6">
                <div class="mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">Past Events</h1>
                            <p class="text-gray-600">All events that have already taken place</p>
                        </div>
                        <div class="flex space-x-4">
                            <a href="/admin/dashboard" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
                                <i class="fas fa-arrow-left mr-2"></i>
                                Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Stats Summary -->
                <% if (pastEvents && pastEvents.length > 0) { %>
                <div class="bg-white rounded-lg shadow p-4 mb-6">
                    <div class="flex items-center">
                        <div class="p-3 bg-gray-100 rounded-full">
                            <i class="fas fa-history text-gray-600 text-xl"></i>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm text-gray-500">Total Past Events</p>
                            <p class="text-2xl font-bold text-gray-800"><%= pastEvents.length %></p>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Past Events List -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200" id="pastEventsTable">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Event Details
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Organizer
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Date & Time
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200" id="eventsTableBody">
                                <% if (pastEvents && pastEvents.length > 0) { %>
                                    <% pastEvents.forEach(event => { %>
                                        <tr class="event-row" id="event-<%= event._id %>">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="flex items-center">
                                                    <% if (event.poster && event.poster.trim() !== '') { %>
                                                        <img src="/uploads/<%= event.poster %>" alt="<%= event.title %>" class="event-thumbnail">
                                                    <% } else { %>
                                                        <div class="event-thumbnail-placeholder">
                                                            <i class="fas fa-calendar-alt text-gray-400 text-xl"></i>
                                                        </div>
                                                    <% } %>
                                                    <div class="ml-4">
                                                        <div class="text-sm font-medium text-gray-900">
                                                            <%= event.title %>
                                                        </div>
                                                        <% if (event.category) { %>
                                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                                                <% if (event.category === 'sports') { %>
                                                                    bg-green-100 text-green-800
                                                                <% } else if (event.category === 'workshop') { %>
                                                                    bg-blue-100 text-blue-800
                                                                <% } else if (event.category === 'cultural') { %>
                                                                    bg-purple-100 text-purple-800
                                                                <% } else if (event.category === 'seminar') { %>
                                                                    bg-yellow-100 text-yellow-800
                                                                <% } else { %>
                                                                    bg-gray-100 text-gray-800
                                                                <% } %>
                                                            ">
                                                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <% if (event.organizer) { %>
                                                    <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <div>
                                                    <i class="fas fa-calendar mr-1 text-gray-400"></i>
                                                    <%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                </div>
                                                <div class="text-gray-500 text-xs mt-1">
                                                    <i class="fas fa-clock mr-1 text-gray-400"></i>
                                                    <%= event.startTime || 'N/A' %> - <%= event.endTime || 'N/A' %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                <button onclick="viewEventDetails('<%= event._id %>')" class="bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700 transition">
                                                    <i class="fas fa-eye mr-1"></i>
                                                    View
                                                </button>
                                                <button onclick="deletePastEvent('<%= event._id %>')" class="delete-btn bg-red-600 text-white px-3 py-1 rounded text-xs hover:bg-red-700 transition ml-2">
                                                    <i class="fas fa-trash mr-1"></i>
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                                            <div class="flex flex-col items-center">
                                                <i class="fas fa-calendar-check text-4xl text-gray-300 mb-4"></i>
                                                <p class="text-lg font-medium">No past events found</p>
                                                <p class="text-sm">There are no events that have already taken place.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function viewEventDetails(eventId) {
            window.location.href = `/admin/past-events/${eventId}`;
        }

        function deletePastEvent(eventId) {
            if (confirm('Are you sure you want to delete this past event? This action cannot be undone.')) {
                fetch(`/admin/past-events/${eventId}/delete`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Remove the row from the table with animation
                        const row = document.getElementById(`event-${eventId}`);
                        if (row) {
                            row.classList.add('fade-out');
                            setTimeout(() => {
                                row.remove();
                                // Check if table is now empty
                                const tbody = document.getElementById('eventsTableBody');
                                if (tbody.children.length === 0) {
                                    location.reload(); // Reload to show empty state
                                }
                            }, 300);
                        }
                        alert('Event deleted successfully!');
                    } else {
                        alert('Error deleting event: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error deleting event');
                });
            }
        }
    </script>
</body>
</html>
