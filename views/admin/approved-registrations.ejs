<%- include('../partials/header') %>
    
    <div class="flex h-screen">
        <%- include('../partials/sidebar') %>
        
        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                <div class="mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">Approved Registrations</h1>
                            <p class="text-gray-600">List of all approved student registrations</p>
                        </div>
                        <div class="flex space-x-4">
                            <a href="/admin/dashboard" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
                                <i class="fas fa-arrow-left mr-2"></i>
                                Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Registration Statistics -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
                    <div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-500">
                        <h3 class="text-sm font-medium text-gray-600">Total Approved</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= approvedRegistrations.length %></p>
                        <p class="text-xs text-gray-500">All approved registrations</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-500">
                        <h3 class="text-sm font-medium text-gray-600">Unique Students</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= uniqueStudents %></p>
                        <p class="text-xs text-gray-500">Students with registrations</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow border-l-4 border-purple-500">
                        <h3 class="text-sm font-medium text-gray-600">Events Covered</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= uniqueEvents %></p>
                        <p class="text-xs text-gray-500">Events with registrations</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow border-l-4 border-yellow-500">
                        <h3 class="text-sm font-medium text-gray-600">This Month</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= thisMonth %></p>
                        <p class="text-xs text-gray-500">Approved this month</p>
                    </div>
                </div>

                <!-- Approved Registrations List -->
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Student Name
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Email
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Event Title
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Event Date
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Registration Date
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Approval Date
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% if (approvedRegistrations && approvedRegistrations.length > 0) { %>
                                    <% approvedRegistrations.forEach(reg => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <% if (reg.student) { %>
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= reg.student.profile.firstName %> <%= reg.student.profile.lastName %>
                                                    </div>
                                                    <div class="text-sm text-gray-500">
                                                        ID: <%= reg.student.profile.collegeId || 'N/A' %>
                                                    </div>
                                                <% } else { %>
                                                    <div class="text-sm font-medium text-gray-900">
                                                        Student Not Found
                                                    </div>
                                                    <div class="text-sm text-gray-500">
                                                        ID: N/A
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= reg.student ? reg.student.profile.email : 'N/A' %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <% if (reg.event) { %>
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= reg.event.title %>
                                                    </div>
                                                    <div class="text-sm text-gray-500">
                                                        <%= reg.event.category %> • <%= reg.event.venue %>
                                                    </div>
                                                <% } else { %>
                                                    <div class="text-sm font-medium text-gray-900">
                                                        Event Not Found
                                                    </div>
                                                    <div class="text-sm text-gray-500">
                                                        N/A • N/A
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= reg.event ? new Date(reg.event.date).toLocaleDateString() : 'N/A' %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= reg.registration ? new Date(reg.registration.registeredAt).toLocaleDateString() : 'N/A' %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                <%= reg.registration ? new Date(reg.registration.approvalDate).toLocaleDateString() : 'N/A' %>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                <% if (reg.student) { %>
                                                    <button onclick="viewStudentDetails('<%= reg.student._id %>')" class="bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700 transition">
                                                        <i class="fas fa-user mr-1"></i>
                                                        Student
                                                    </button>
                                                <% } %>
                                                <% if (reg.event) { %>
                                                    <button onclick="viewEventDetails('<%= reg.event._id %>')" class="bg-purple-600 text-white px-3 py-1 rounded text-xs hover:bg-purple-700 transition ml-2">
                                                        <i class="fas fa-calendar mr-1"></i>
                                                        Event
                                                    </button>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                                            <div class="flex flex-col items-center">
                                                <i class="fas fa-user-check text-4xl text-gray-300 mb-4"></i>
                                                <p class="text-lg font-medium">No approved registrations found</p>
                                                <p class="text-sm">There are no approved student registrations yet.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function viewStudentDetails(studentId) {
            window.location.href = `/admin/students/${studentId}`;
        }

        function viewEventDetails(eventId) {
            window.open(`/admin/events/${eventId}`, '_blank', 'width=800,height=600,scrollbars=yes,resizable=yes');
        }
    </script>
<%- include('../partials/footer') %>
