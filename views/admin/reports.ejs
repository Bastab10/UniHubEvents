<%- include('../partials/header') %>

<div class="flex h-screen bg-gray-100">
    <%- include('../partials/sidebar') %>

    <main class="flex-1 overflow-y-auto">
            <div class="p-8">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-2xl font-bold text-gray-800">Reports & Analytics</h1>
                    <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800">
                        <i class="fas fa-arrow-left mr-1"></i>Back to Dashboard
                    </a>
                </div>

                <!-- Main Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                                <i class="fas fa-calendar text-2xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Total Events</p>
                                <p class="text-2xl font-bold text-gray-800"><%= stats.totalEvents %></p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-green-100 text-green-600">
                                <i class="fas fa-graduation-cap text-2xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Total Students</p>
                                <p class="text-2xl font-bold text-gray-800"><%= stats.totalStudents %></p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-purple-100 text-purple-600">
                                <i class="fas fa-chalkboard-teacher text-2xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Faculty</p>
                                <p class="text-2xl font-bold text-gray-800"><%= stats.totalFaculty %></p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center">
                            <div class="p-3 rounded-full bg-orange-100 text-orange-600">
                                <i class="fas fa-ticket-alt text-2xl"></i>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm text-gray-500">Registrations</p>
                                <p class="text-2xl font-bold text-gray-800"><%= stats.totalRegistrations %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Category-wise Events -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-pie-chart mr-2 text-blue-500"></i>Events by Category
                        </h3>
                        <% if (stats.categoryStats && stats.categoryStats.length > 0) { %>
                            <div class="space-y-3">
                                <% stats.categoryStats.forEach(cat => { %>
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm text-gray-700 capitalize"><%= cat._id %></span>
                                        <div class="flex items-center">
                                            <div class="w-32 bg-gray-200 rounded-full h-2 mr-3">
                                                <div class="bg-blue-500 h-2 rounded-full percentage-bar" data-percentage="<%= (cat.count / stats.totalEvents * 100).toFixed(1) %>"></div>
                                            </div>
                                            <span class="text-sm font-semibold text-gray-800 w-8"><%= cat.count %></span>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-gray-500 text-center py-4">No data available</p>
                        <% } %>
                    </div>

                    <!-- Event Mode Distribution -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-chart-pie mr-2 text-purple-500"></i>Event Mode Distribution
                        </h3>
                        <% if (stats.eventModeStats && stats.eventModeStats.length > 0) { %>
                            <div class="space-y-3">
                                <% stats.eventModeStats.forEach(mode => { %>
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm text-gray-700 capitalize">
                                            <%= mode._id === 'versity' ? 'Versity Week' : 'Normal' %>
                                        </span>
                                        <div class="flex items-center">
                                            <div class="w-32 bg-gray-200 rounded-full h-2 mr-3">
                                                <div class="h-2 rounded-full percentage-bar <%= mode._id === 'versity' ? 'bg-purple-500' : 'bg-gray-500' %>" data-percentage="<%= (mode.count / stats.totalEvents * 100).toFixed(1) %>"></div>
                                            </div>
                                            <span class="text-sm font-semibold text-gray-800 w-8"><%= mode.count %></span>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-gray-500 text-center py-4">No data available</p>
                        <% } %>
                    </div>

                    <!-- Registration Status -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-tasks mr-2 text-green-500"></i>Registration Status
                        </h3>
                        <% if (stats.registrationStats && stats.registrationStats.length > 0) { %>
                            <div class="space-y-3">
                                <% stats.registrationStats.forEach(stat => { %>
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm text-gray-700 capitalize">
                                            <span class="inline-block w-3 h-3 rounded-full mr-2 
                                                <%= stat._id === 'approved' ? 'bg-green-500' : stat._id === 'pending' ? 'bg-yellow-500' : 'bg-red-500' %>">
                                            </span>
                                            <%= stat._id %>
                                        </span>
                                        <span class="text-sm font-semibold text-gray-800"><%= stat.count %></span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-gray-500 text-center py-4">No data available</p>
                        <% } %>
                    </div>

                    <!-- Department-wise Students -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-building mr-2 text-orange-500"></i>Students by Department (Top 10)
                        </h3>
                        <% if (stats.departmentStats && stats.departmentStats.length > 0) { %>
                            <div class="space-y-2 max-h-64 overflow-y-auto">
                                <% stats.departmentStats.slice(0, 10).forEach(dept => { %>
                                    <div class="flex items-center justify-between py-1">
                                        <span class="text-sm text-gray-700"><%= dept._id || 'Unknown' %></span>
                                        <span class="text-sm font-semibold bg-gray-100 px-2 py-1 rounded"><%= dept.count %></span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-gray-500 text-center py-4">No data available</p>
                        <% } %>
                    </div>

                    <!-- Monthly Events Trend -->
                    <div class="bg-white rounded-lg shadow-md p-6 lg:col-span-2">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-chart-line mr-2 text-blue-500"></i>Monthly Event Creation (Last 6 Months)
                        </h3>
                        <% if (stats.monthlyStats && stats.monthlyStats.length > 0) { %>
                            <div class="flex items-end space-x-4 h-32">
                                <% 
                                    const maxCount = Math.max(...stats.monthlyStats.map(s => s.count));
                                    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                %>
                                <% stats.monthlyStats.forEach(stat => { %>
                                    <div class="flex-1 flex flex-col items-center">
                                        <div class="w-full bg-blue-500 rounded-t chart-bar" data-height="<%= (stat.count / maxCount * 100).toFixed(0) %>"></div>
                                        <span class="text-xs text-gray-600 mt-2">
                                            <%= monthNames[stat._id.month - 1] %> <%= stat._id.year %>
                                        </span>
                                        <span class="text-xs font-semibold text-gray-800"><%= stat.count %></span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-gray-500 text-center py-4">No data available</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Apply percentage widths to bars
        document.querySelectorAll('.percentage-bar').forEach(bar => {
            const percentage = bar.getAttribute('data-percentage');
            if (percentage) {
                bar.style.width = percentage + '%';
            }
        });

        // Apply heights to chart bars
        document.querySelectorAll('.chart-bar').forEach(bar => {
            const height = bar.getAttribute('data-height');
            if (height) {
                bar.style.height = height + 'px';
            }
        });
    </script>
