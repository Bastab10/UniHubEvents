<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Panel - Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside class="w-64 bg-gray-800 text-white flex flex-col">
            <div class="p-6 border-b border-gray-700">
                <h2 class="text-lg font-bold">Faculty Panel</h2>
                <p class="text-sm text-gray-300">Event Management</p>
            </div>
            
            <nav class="flex-1 p-4">
                <ul class="space-y-2">
                    <li>
                        <a href="/faculty/dashboard" class="flex items-center space-x-3 p-3 rounded-lg bg-gray-700 hover:bg-gray-600">
                            <i class="fas fa-tachometer-alt w-5"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/events/create" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
                            <i class="fas fa-plus-circle w-5"></i>
                            <span>Create Event</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/events" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
                            <i class="fas fa-calendar w-5"></i>
                            <span>My Events</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/participants" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
                            <i class="fas fa-users w-5"></i>
                            <span>Participants</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/sports" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
                            <i class="fas fa-running w-5"></i>
                            <span>Sports</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/seminars" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
                            <i class="fas fa-chalkboard-teacher w-5"></i>
                            <span>Seminars</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/analytics" class="flex items-center space-x-3 p-4 rounded-xl hover:bg-white/10 transition-all duration-300">
                            <i class="fas fa-chart-bar w-5 text-pink-300"></i>
                            <span class="font-medium">Analytics</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/profile" class="flex items-center space-x-3 p-4 rounded-xl hover:bg-white/10 transition-all duration-300">
                            <i class="fas fa-user-circle w-5 text-cyan-300"></i>
                            <span class="font-medium">My Profile</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto">
            <!-- Header -->
            <header class="bg-white shadow-sm border-b">
                <div class="px-6 py-4">
                    <h1 class="text-2xl font-bold text-gray-800">Faculty Dashboard</h1>
                    <p class="text-gray-600">Manage institutional events and sports activities</p>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="p-6">
                <!-- 2.1 Faculty Dashboard Stats -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <div class="bg-white p-6 rounded-lg shadow">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Events Created</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= stats.totalEvents %></p>
                        <p class="text-xs text-gray-500">Total events by you</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Approved Events</h3>
                        <p class="text-2xl font-bold text-green-600"><%= stats.approvedEvents %></p>
                        <p class="text-xs text-gray-500">Active events</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Pending Events</h3>
                        <p class="text-2xl font-bold text-yellow-600"><%= stats.pendingEvents %></p>
                        <p class="text-xs text-gray-500">Under review</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow">
                        <h3 class="text-sm font-medium text-gray-600 mb-2">Total Participants</h3>
                        <p class="text-2xl font-bold text-blue-600">247</p>
                        <p class="text-xs text-gray-500">Across all events</p>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-6">Quick Actions</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <a href="/faculty/events/create" class="bg-gradient-to-r from-blue-500 to-blue-600 text-white p-6 rounded-xl text-center hover:from-blue-600 hover:to-blue-700 transition-all duration-300 transform hover:scale-105 shadow-lg">
                            <i class="fas fa-plus-circle text-3xl mb-3"></i>
                            <h3 class="font-bold">Create Event</h3>
                            <p class="text-sm opacity-90">Add new institutional event</p>
                        </a>
                        
                        <a href="/faculty/events" class="bg-gradient-to-r from-green-500 to-green-600 text-white p-6 rounded-xl text-center hover:from-green-600 hover:to-green-700 transition-all duration-300 transform hover:scale-105 shadow-lg">
                            <i class="fas fa-calendar text-3xl mb-3"></i>
                            <h3 class="font-bold">Manage Events</h3>
                            <p class="text-sm opacity-90">View and edit your events</p>
                        </a>
                        
                        <a href="/faculty/sports" class="bg-gradient-to-r from-purple-500 to-purple-600 text-white p-6 rounded-xl text-center hover:from-purple-600 hover:to-purple-700 transition-all duration-300 transform hover:scale-105 shadow-lg">
                            <i class="fas fa-running text-3xl mb-3"></i>
                            <h3 class="font-bold">Sports Events</h3>
                            <p class="text-sm opacity-90">Manage sports activities</p>
                        </a>
                        
                        <a href="/faculty/seminars" class="bg-gradient-to-r from-yellow-500 to-yellow-600 text-white p-6 rounded-xl text-center hover:from-yellow-600 hover:to-yellow-700 transition-all duration-300 transform hover:scale-105 shadow-lg">
                            <i class="fas fa-chalkboard-teacher text-3xl mb-3"></i>
                            <h3 class="font-bold">Seminars</h3>
                            <p class="text-sm opacity-90">Organize seminars</p>
                        </a>
                    </div>
                </div>

                <!-- Recent Events -->
                <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-gray-800">Your Recent Events</h2>
                        <a href="/faculty/events" class="text-blue-600 hover:text-blue-800 font-medium">View All</a>
                    </div>
                    
                    <% if (recentEvents && recentEvents.length > 0) { %>
                        <div class="space-y-4">
                            <% recentEvents.forEach(event => { %>
                                <div class="border rounded-xl p-6 hover:shadow-md transition-all">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <div class="flex items-center space-x-2 mb-2">
                                                <h3 class="font-bold text-gray-800"><%= event.title %></h3>
                                                <span class="px-2 py-1 text-xs rounded-full 
                                                    <% if (event.status === 'approved') { %>bg-green-100 text-green-800<% } else if (event.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } else { %>bg-red-100 text-red-800<% } %>">
                                                    <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                                </span>
                                                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                                                    <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                                </span>
                                            </div>
                                            <div class="grid grid-cols-2 gap-4 text-sm text-gray-600">
                                                <div><i class="fas fa-calendar-alt mr-2"></i><%= new Date(event.date).toLocaleDateString() %></div>
                                                <div><i class="fas fa-clock mr-2"></i><%= event.startTime %> - <%= event.endTime %></div>
                                                <div><i class="fas fa-map-marker-alt mr-2"></i><%= event.venue %></div>
                                                <div><i class="fas fa-users mr-2"></i><%= event.registrations.length %> / <%= event.maxParticipants || 'Unlimited' %></div>
                                            </div>
                                        </div>
                                        <div class="flex space-x-2 ml-4">
                                            <a href="/faculty/events/<%= event._id %>/edit" class="p-2 text-blue-600 hover:bg-blue-50 rounded" title="Edit Event">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="/faculty/events/<%= event._id %>/registrations" class="p-2 text-green-600 hover:bg-green-50 rounded" title="View Participants">
                                                <i class="fas fa-users"></i>
                                            </a>
                                            <a href="/faculty/events/<%= event._id %>/attendance" class="p-2 text-purple-600 hover:bg-purple-50 rounded" title="Mark Attendance">
                                                <i class="fas fa-check-square"></i>
                                            </a>
                                            <% if (event.status !== 'approved') { %>
                                                <form action="/faculty/events/<%= event._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this event?')" class="inline">
                                                    <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded" title="Delete Event">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8">
                            <p class="text-gray-500">No events created yet</p>
                            <a href="/faculty/events/create" class="inline-block mt-4 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
                                Create Your First Event
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Participant Monitoring -->
                <div class="bg-white rounded-2xl shadow-lg p-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-6">Participant Monitoring</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <a href="/faculty/participants" class="p-4 border rounded-xl hover:bg-gray-50 text-center">
                            <i class="fas fa-users text-blue-600 text-2xl mb-2"></i>
                            <p class="font-medium">View Registered Students</p>
                        </a>
                        <a href="/faculty/participants/approve" class="p-4 border rounded-xl hover:bg-gray-50 text-center">
                            <i class="fas fa-check-circle text-green-600 text-2xl mb-2"></i>
                            <p class="font-medium">Approve/Reject Participants</p>
                        </a>
                        <a href="/faculty/participants/tracking" class="p-4 border rounded-xl hover:bg-gray-50 text-center">
                            <i class="fas fa-chart-line text-purple-600 text-2xl mb-2"></i>
                            <p class="font-medium">Track Participation Numbers</p>
                        </a>
                        <a href="/faculty/participants/export" class="p-4 border rounded-xl hover:bg-gray-50 text-center">
                            <i class="fas fa-download text-yellow-600 text-2xl mb-2"></i>
                            <p class="font-medium">Export Participant Lists</p>
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
