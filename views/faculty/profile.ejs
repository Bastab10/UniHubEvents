<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coordinator Profile - Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-50">

    <%- include('../partials/header') %>

    <!-- ✅ FIXED HERE (min-h-screen instead of h-screen) -->
    <div class="flex min-h-screen">

        <%- include('../partials/sidebar') %>

        <!-- ✅ FIXED HERE (removed overflow-y-auto) -->
        <main class="flex-1">
            <div class="p-6">
                 <div class="text-center mb-6">
                            <h3 class="text-2xl font-bold text-gray-800 mb-2">
                                Profile Information
                            </h3>
                            <p class="text-gray-600">
                                Manage your coordinator profile and event management settings
                            </p>
                        </div>
                <div class="max-w-4xl mx-auto mb-8">
                    <div class="bg-white rounded-lg shadow-md border border-gray-200 p-8">

                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                            <!-- Profile Card -->
                            <div class="lg:col-span-1">
                                <div class="text-center">
                                    <div class="mx-auto h-16 w-16 bg-gray-200 rounded-full flex items-center justify-center mb-3">
                                        <i class="fas fa-chalkboard-teacher text-gray-400 text-2xl"></i>
                                    </div>

                                    <h2 class="text-lg font-semibold text-gray-800 mb-1">
                                        <%= currentUser.profile.fullName %>
                                    </h2>

                                    <p class="text-sm text-gray-600 mb-2">
                                        <%= currentUser.email %>
                                    </p>

                                    <span class="inline-block px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full">
                                        <%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %>
                                    </span>
                                </div>
                            </div>

                            <!-- Profile Form -->
                            <div class="lg:col-span-2">
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                    Edit Profile
                                </h3>

                                <form method="POST" action="/faculty/profile" class="space-y-3">

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Full Name
                                        </label>
                                        <input type="text"
                                               name="fullName"
                                               value="<%= currentUser.profile.fullName %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-black"
                                               required>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Email
                                        </label>
                                        <input type="email"
                                               value="<%= currentUser.email %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md bg-gray-100 text-black"
                                               readonly>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Email can be updated by contacting admin
                                        </p>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Coordinator ID
                                        </label>
                                        <input type="text"
                                               value="<%= currentUser.profile.collegeId %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md bg-gray-100 text-black"
                                               readonly>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Coordinator ID cannot be changed
                                        </p>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Department
                                        </label>
                                        <select name="department"
                                                class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-black">
                                            <option value="">Select Department</option>
                                            <option value="Mathematics Department">Mathematics Department</option>
                                            <option value="Physics Department">Physics Department</option>
                                            <option value="Statistics Department">Statistics Department</option>
                                            <option value="Zoology Department">Zoology Department</option>
                                            <option value="Computer Science Department">Computer Science Department</option>
                                            <option value="Physical Education Department">Physical Education Department</option>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Phone Number
                                        </label>
                                        <input type="tel"
                                               name="phone"
                                               value="<%= currentUser.profile.phone || '' %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-black">
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Professional Bio
                                        </label>
                                        <textarea name="bio"
                                                  rows="3"
                                                  class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-black"><%= currentUser.profile.bio || '' %></textarea>
                                    </div>

                                    <div class="flex justify-end space-x-2 pt-2">
                                        <button type="button"
                                                class="px-3 py-1.5 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                                            Cancel
                                        </button>

                                        <button type="submit"
                                                class="px-3 py-1.5 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700">
                                            Save Changes
                                        </button>
                                    </div>

                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('../partials/footer') %>

</body>
</html>