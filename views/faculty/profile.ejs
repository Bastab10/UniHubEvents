<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coordinator Profile - Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
    /* Compact Action Buttons - Match Header Logout Button Style */
    .compact-action-btn {
        text-decoration: none;
        display: flex;
        align-items: center;
        padding: 0.5rem 0.875rem;
        border-radius: 0.5rem;
        border: 1px solid #0ea5a4;
        color: #0ea5a4;
        transition: all 0.2s ease;
        font-weight: 500;
        white-space: nowrap;
        font-size: 0.8125rem;
        cursor: pointer;
        min-height: 2.5rem;
        justify-content: center;
    }

    .compact-action-btn:hover {
        background-color: #0ea5a4;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(14, 165, 164, 0.3);
    }

    .compact-action-btn:focus {
        background-color: #0ea5a4;
        color: white;
        outline: none;
    }

    /* Mobile responsiveness for compact buttons */
    @media (max-width: 640px) {
        .compact-action-btn {
            padding: 0.625rem 0.75rem;
            font-size: 0.75rem;
            min-height: 2.75rem;
            width: 100%;
            margin-bottom: 0.5rem;
        }
        
        .compact-action-btn i {
            font-size: 0.875rem !important;
        }
        
        .compact-action-btn span {
            font-size: 0.75rem !important;
        }
    }

    /* Mobile Responsive Layout */
    @media (max-width: 768px) {
        body {
            padding: 0.5rem;
        }
        
        main {
            padding: 0.75rem;
            margin: 0;
            overflow-x: hidden;
        }
        
        .bg-white.rounded-xl.shadow-lg.p-6 {
            padding: 1rem;
            border-radius: 0.75rem;
        }
        
        .grid.grid-cols-1.md\\:grid-cols-2 {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    /* Profile Card Mobile Optimization */
    @media (max-width: 640px) {
        .profile-card {
            padding: 1.25rem;
            margin-bottom: 1rem;
        }
        
        .profile-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        
        .profile-avatar {
            width: 80px;
            height: 80px;
            margin: 0 auto 1rem;
        }
        
        .profile-info {
            text-align: center;
        }
        
        .profile-stats {
            flex-direction: column;
            gap: 1rem;
        }
        
        .stat-card {
            text-align: center;
            padding: 1rem;
        }
    }

    /* Form Mobile Optimization */
    @media (max-width: 640px) {
        .form-group {
            margin-bottom: 1.25rem;
        }
        
        label {
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }
        
        input[type="text"],
        input[type="email"],
        input[type="tel"],
        select,
        textarea {
            width: 100%;
            padding: 0.75rem;
            font-size: 1rem;
            border-radius: 0.5rem;
            border: 1px solid #d1d5db;
            margin-bottom: 0.5rem;
        }
        
        textarea {
            min-height: 100px;
            resize: vertical;
        }
        
        .btn {
            width: 100%;
            padding: 0.875rem 1rem;
            font-size: 1rem;
            min-height: 3rem;
            margin-bottom: 0.75rem;
            border-radius: 0.5rem;
        }
    }

    /* Typography Mobile Optimization */
    @media (max-width: 640px) {
        h1 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        
        h2 {
            font-size: 1.25rem;
            margin-bottom: 1rem;
        }
        
        h3 {
            font-size: 1.125rem;
            margin-bottom: 0.75rem;
        }
        
        .text-2xl {
            font-size: 1.5rem;
        }
        
        .text-lg {
            font-size: 1rem;
        }
    }

    /* Button Groups Mobile */
    @media (max-width: 640px) {
        .flex.gap-4 {
            flex-direction: column;
            gap: 0.75rem;
        }
        
        .flex.justify-end {
            justify-content: stretch;
            flex-direction: column;
        }
    }

    /* Remove horizontal scrolling */
    @media (max-width: 640px) {
        body {
            overflow-x: hidden;
        }
        
        main {
            overflow-x: hidden;
        }
    }
    </style>
</head>

<body class="bg-gray-50">

    <%- include('../partials/header') %>

    <!-- ✅ FIXED HERE (min-h-screen instead of h-screen) -->
    <div class="flex min-h-screen">

        <%- include('../partials/sidebar') %>

        <!-- ✅ FIXED HERE (removed overflow-y-auto) -->
        <main class="flex-1">
            <div class="p-6">
                 <div class="text-center mb-6">
                            <h3 class="text-2xl font-bold text-gray-800 mb-2">
                                Profile Information
                            </h3>
                            <p class="text-gray-600">
                                Manage your coordinator profile and event management settings
                            </p>
                        </div>
                <div class="max-w-4xl mx-auto mb-8">
                    <div class="bg-white rounded-lg shadow-md border border-gray-200 p-8">

                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                            <!-- Profile Card -->
                            <div class="lg:col-span-1">
                                <div class="text-center">
                                    <div class="mx-auto h-16 w-16 bg-gray-200 rounded-full flex items-center justify-center mb-3">
                                        <i class="fas fa-chalkboard-teacher text-gray-400 text-2xl"></i>
                                    </div>

                                    <h2 class="text-lg font-semibold text-gray-800 mb-1">
                                        <%= currentUser.profile.fullName %>
                                    </h2>

                                    <p class="text-sm text-gray-600 mb-2">
                                        <%= currentUser.email %>
                                    </p>

                                    <span class="inline-block px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full">
                                        <%= currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) %>
                                    </span>
                                </div>
                            </div>

                            <!-- Profile Form -->
                            <div class="lg:col-span-2">
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                    Edit Profile
                                </h3>

                                <form method="POST" action="/faculty/profile" class="space-y-3">

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Full Name
                                        </label>
                                        <input type="text"
                                               name="fullName"
                                               value="<%= currentUser.profile.fullName %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 text-black"
                                               required>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Email
                                        </label>
                                        <input type="email"
                                               value="<%= currentUser.email %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md bg-gray-100 text-black"
                                               readonly>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Email can be updated by contacting admin
                                        </p>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Coordinator ID
                                        </label>
                                        <input type="text"
                                               value="<%= currentUser.profile.collegeId %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md bg-gray-100 text-black"
                                               readonly>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Coordinator ID cannot be changed
                                        </p>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Department
                                        </label>
                                        <select name="department"
                                                class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-black">
                                            <option value="">Select Department</option>
                                            <option value="Mathematics Department">Mathematics Department</option>
                                            <option value="Physics Department">Physics Department</option>
                                            <option value="Statistics Department">Statistics Department</option>
                                            <option value="Zoology Department">Zoology Department</option>
                                            <option value="Computer Science Department">Computer Science Department</option>
                                            <option value="Physical Education Department">Physical Education Department</option>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Phone Number
                                        </label>
                                        <input type="tel"
                                               name="phone"
                                               value="<%= currentUser.profile.phone || '' %>"
                                               class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-black">
                                    </div>

                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">
                                            Professional Bio
                                        </label>
                                        <textarea name="bio"
                                                  rows="3"
                                                  class="w-full px-2 py-2 text-sm border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-black"><%= currentUser.profile.bio || '' %></textarea>
                                    </div>

                                    <div class="flex justify-end space-x-2 pt-2">
                                        <button type="button" class="compact-action-btn"></button>
                                            <i class="fas fa-times text-sm"></i>
                                            <span class="text-xs">Cancel</span>
                                        </button>
                                        <button type="submit" class="compact-action-btn">
                                            <i class="fas fa-save text-sm"></i>
                                            <span class="text-xs">Save Changes</span>
                                        </button>
                                    </div>

                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <%- include('../partials/footer') %>

</body>
</html>