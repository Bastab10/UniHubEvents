<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <% if (success && success.length > 0) { %>
                <div class="mb-6 bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-r-lg animate-pulse">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle mr-3 text-green-500"></i>
                        <span class="font-medium"><%= success %></span>
                    </div>
                </div>
            <% } %>
            <% if (error && error.length > 0) { %>
                <div class="mb-6 bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-r-lg">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-3 text-red-500"></i>
                        <span class="font-medium"><%= error %></span>
                    </div>
                </div>
            <% } %>

            <div class="bg-white rounded-lg border border-gray-200 p-6">
                 <div class="bg-white border-b border-gray-200 py-6 px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <h1 class="text-2xl font-semibold text-gray-800">Upload Event Result</h1>
                <p class="mt-1 text-gray-500 text-sm">Declare winners for your completed events</p>
            </div>
        </div>
                <form action="/faculty/upload-result" method="POST" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Select Event</label>
                        <select name="eventId" required 
                                class="w-full px-3 py-2 border border-gray-300 rounded-md bg-white focus:outline-none focus:ring-1 focus:ring-gray-400">
                            <option value="">-- Choose an Event --</option>
                            <% if (events && events.length > 0) { %>
                                <% events.forEach(event => { %>
                                    <option value="<%= event._id %>">
                                        <%= event.title %> (<%= new Date(event.date).toLocaleDateString() %>)
                                        <%= event.hasResult ? ' - [Result Already Uploaded]' : '' %>
                                    </option>
                                <% }); %>
                            <% } else { %>
                                <option value="" disabled>No completed events available</option>
                            <% } %>
                        </select>
                        <p class="mt-1 text-xs text-gray-500">Only events that have ended are shown</p>
                    </div>

                    <div class="pt-4 border-t border-gray-200">
                        <h3 class="text-sm font-semibold text-gray-700 mb-4 uppercase tracking-wide">Winners</h3>

                        <div class="grid gap-4 md:grid-cols-3">
                            <div class="border border-gray-200 rounded-lg p-4">
                                <div class="text-sm font-medium text-amber-600 mb-3">🥇 First Place</div>
                                <label class="block text-sm text-gray-600 mb-1">Name</label>
                                <input type="text" name="firstPosition[name]" required
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">
                                
                                <label class="block text-sm text-gray-600 mb-1">Department</label>
                                <input type="text" name="firstPosition[department]"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">
                                
                                <label class="block text-sm text-gray-600 mb-1">College ID</label>
                                <input type="text" name="firstPosition[collegeId]" required
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                                <label class="block text-sm text-gray-600 mb-1">Points <span class="text-xs text-gray-400">(Optional)</span></label>
                                <input type="number" name="firstPosition[points]" min="0" placeholder="Enter points"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400">
                            </div>

                            <div class="border border-gray-200 rounded-lg p-4">
                                <div class="text-sm font-medium text-gray-600 mb-3">🥈 Second Place</div>
                                <label class="block text-sm text-gray-600 mb-1">Name</label>
                                <input type="text" name="secondPosition[name]" required
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">
                                
                                <label class="block text-sm text-gray-600 mb-1">Department</label>
                                <input type="text" name="secondPosition[department]"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">
                                
                                <label class="block text-sm text-gray-600 mb-1">College ID</label>
                                <input type="text" name="secondPosition[collegeId]"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                                <label class="block text-sm text-gray-600 mb-1">Points <span class="text-xs text-gray-400">(Optional)</span></label>
                                <input type="number" name="secondPosition[points]" min="0" placeholder="Enter points"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400">
                            </div>

                            <div class="border border-gray-200 rounded-lg p-4">
                                <div class="text-sm font-medium text-orange-700 mb-3">🥉 Third Place</div>
                                <label class="block text-sm text-gray-600 mb-1">Name</label>
                                <input type="text" name="thirdPosition[name]" required
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">
                                
                                <label class="block text-sm text-gray-600 mb-1">Department</label>
                                <input type="text" name="thirdPosition[department]"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">
                                
                                <label class="block text-sm text-gray-600 mb-1">College ID</label>
                                <input type="text" name="thirdPosition[collegeId]"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                                <label class="block text-sm text-gray-600 mb-1">Points <span class="text-xs text-gray-400">(Optional)</span></label>
                                <input type="number" name="thirdPosition[points]" min="0" placeholder="Enter points"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400">
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 flex gap-3">
                        <button type="submit" class="px-4 py-2 bg-gray-800 text-white text-sm rounded hover:bg-gray-900">
                            Upload Result
                        </button>
                        <a href="/faculty/dashboard" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded hover:bg-gray-300">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>

            <div class="mt-6 text-sm text-gray-500">
                <p>Note: You can only upload results for completed events. Each event can have only one result set.</p>
            </div>
        </div>
    </div>

    <script>
        setTimeout(() => {
            const flashMessages = document.querySelectorAll('[class*="border-l-4"]');
            flashMessages.forEach(msg => {
                msg.style.opacity = '0';
                msg.style.transition = 'opacity 0.5s';
                setTimeout(() => msg.remove(), 500);
            });
        }, 5000);

        document.querySelector('form').addEventListener('submit', function(e) {
            const eventSelect = document.querySelector('select[name="eventId"]');
            if (!eventSelect.value) {
                e.preventDefault();
                alert('Please select an event');
                return false;
            }
        });
    </script>
    
<%- include('../partials/footer') %>
