<%- include('../partials/header') %>

<style>
/* My Events Styles */
.events-container {
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    min-height: 100vh;
}

.events-header {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: white;
    padding: 2rem 0;
    margin-bottom: 2rem;
}

.events-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(1, 1fr);
}

@media (min-width: 768px) {
    .events-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .events-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

.event-card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
}

.event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.1);
}

.event-image {
    height: 12rem;
    background: #e5e7eb;
    position: relative;
    overflow: hidden;
}

.event-content {
    padding: 1.5rem;
}

.event-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 0.5rem;
}

.event-description {
    color: #6b7280;
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Fallback for browsers that don't support line-clamp */
    display: -moz-box;
    -moz-line-clamp: 2;
    -moz-box-orient: vertical;
    display: box;
    line-clamp: 2;
    box-orient: vertical;
}

.event-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #6b7280;
    margin-bottom: 1rem;
}

.status-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
}

.status-approved {
    background: #d1fae5;
    color: #065f46;
}

.status-pending {
    background: #fed7aa;
    color: #92400e;
}

.status-rejected {
    background: #fee2e2;
    color: #991b1b;
}

.action-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
}

.no-events {
    text-align: center;
    padding: 4rem 2rem;
    color: #6b7280;
}

.no-events i {
    font-size: 4rem;
    color: #d1d5db;
    margin-bottom: 1rem;
}

/* Responsive Design */
@media (max-width: 768px) {
    .events-header {
        padding: 1.5rem 0;
    }
    
    .events-header h1 {
        font-size: 1.75rem;
    }
    
    .event-card {
        border-radius: 0.75rem;
    }
    
    .event-content {
        padding: 1rem;
    }
    
    .event-title {
        font-size: 1.125rem;
    }
    
    .event-image {
        height: 10rem;
    }
}
</style>

<div class="events-container">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <!-- Header Section -->
        <div class="events-header">
            <div class="container mx-auto px-4">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                    <div>
                        <h1 class="text-3xl font-bold mb-2">My Events</h1>
                        <p class="text-blue-100">Manage and track your created events</p>
                    </div>
                    <div class="mt-4 md:mt-0">
                        <a href="/faculty/create-event" class="bg-white text-blue-600 px-6 py-3 rounded-lg font-medium hover:bg-blue-50 transition-colors shadow-lg">
                            <i class="fas fa-plus mr-2"></i>
                            Create New Event
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="container mx-auto px-4 mb-6">
            <div class="bg-white rounded-lg shadow-md p-4">
                <form method="GET" action="/faculty/my-events" class="flex flex-wrap gap-4 items-end">
                    <div class="flex-1 min-w-48">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select name="status" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-800">
                            <option value="">All Status</option>
                            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                            <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                        </select>
                    </div>
                    
                    <div class="flex-1 min-w-48">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                        <select name="category" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="">All Categories</option>
                            <option value="technical" <%= filters.category === 'technical' ? 'selected' : '' %>>Technical</option>
                            <option value="cultural" <%= filters.category === 'cultural' ? 'selected' : '' %>>Cultural</option>
                            <option value="sports" <%= filters.category === 'sports' ? 'selected' : '' %>>Sports</option>
                            <option value="seminar" <%= filters.category === 'seminar' ? 'selected' : '' %>>Seminar</option>
                            <option value="workshop" <%= filters.category === 'workshop' ? 'selected' : '' %>>Workshop</option>
                        </select>
                    </div>
                    
                    <div>
                        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors">
                            <i class="fas fa-filter mr-2"></i>
                            Filter
                        </button>
                        <a href="/faculty/my-events" class="ml-2 text-gray-600 hover:text-gray-800">
                            <i class="fas fa-times"></i>
                            Clear
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Events Section -->
        <div class="container mx-auto px-4">
            <% if (events && events.length > 0) { %>
                <div class="events-grid">
                    <% events.forEach(event => { %>
                        <div class="event-card">
                            <!-- Event Image -->
                            <div class="event-image">
                                <% if (event.poster && event.poster.trim() !== '') { %>
                                    <img src="<%= event.poster %>" 
                                         alt="<%= event.title %>" 
                                         class="w-full h-full object-cover"
                                         style="object-fit: cover;"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-100 to-purple-100" style="display:none;">
                                        <i class="fas fa-calendar-alt text-4xl text-blue-600"></i>
                                    </div>
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-100 to-purple-100">
                                        <i class="fas fa-calendar-alt text-4xl text-blue-600"></i>
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Event Content -->
                            <div class="event-content">
                                <!-- Title and Status -->
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="event-title flex-1 mr-2">
                                        <%= event.title %>
                                    </h3>
                                    <span class="status-badge status-<%= event.status %>">
                                        <%= event.status %>
                                    </span>
                                </div>
                                
                                <!-- Description -->
                                <p class="event-description">
                                    <%= event.description || 'No description available' %>
                                </p>
                                
                                <!-- Event Meta -->
                                <div class="event-meta">
                                    <div class="flex items-center">
                                        <i class="fas fa-calendar mr-2 text-gray-400"></i>
                                        <span><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-clock mr-2 text-gray-400"></i>
                                        <span><%= event.startTime %> - <%= event.endTime %></span>
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-map-marker-alt mr-2 text-gray-400"></i>
                                        <span><%= event.venue %></span>
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-users mr-2 text-gray-400"></i>
                                        <span><%= event.registrations ? event.registrations.length : 0 %> registered</span>
                                    </div>
                                </div>
                                
                                <!-- Action Buttons -->
                                <div class="action-buttons">
                                    <a href="/faculty/events/<%= event._id %>" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye mr-1"></i>
                                        View
                                    </a>
                                    <a href="/faculty/events/<%= event._id %>/edit" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-edit mr-1"></i>
                                        Edit
                                    </a>
                                    <% if (event.status === 'pending') { %>
                                        <button onclick="deleteEvent('<%= event._id %>')" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash mr-1"></i>
                                            Delete
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="no-events">
                    <i class="fas fa-calendar-times"></i>
                    <h3 class="text-xl font-semibold text-gray-600 mb-2">No Events Found</h3>
                    <p class="text-gray-500 mb-4">
                        <% if (filters.status || filters.category) { %>
                            No events match your current filters. Try adjusting your criteria.
                        <% } else { %>
                            You haven't created any events yet. Start by creating your first event!
                        <% } %>
                    </p>
                    <a href="/faculty/create-event" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors inline-block">
                        <i class="fas fa-plus mr-2"></i>
                        Create Your First Event
                    </a>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
// Delete event function
function deleteEvent(eventId) {
    if (confirm('Are you sure you want to delete this event? This action cannot be undone.')) {
        fetch(`/faculty/events/${eventId}/delete`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Remove the event card from the page
                const eventCard = document.querySelector(`[data-event-id="${eventId}"]`);
                if (eventCard) {
                    eventCard.remove();
                }
                // Show success message
                alert('Event deleted successfully!');
                // Reload page to update the list
                window.location.reload();
            } else {
                alert('Error deleting event: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error deleting event. Please try again.');
        });
    }
}

// Add data attributes to event cards for easier manipulation
document.addEventListener('DOMContentLoaded', function() {
    const eventCards = document.querySelectorAll('.event-card');
    eventCards.forEach((card, index) => {
        // This would need to be set properly when rendering
        // card.setAttribute('data-event-id', events[index]._id);
    });
});
</script>
