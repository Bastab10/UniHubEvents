<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Dashboard - Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-blue-600 text-white shadow-lg">
        <div class="container mx-auto px-6 py-4">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-bold">Faculty Dashboard</h1>
                    <p class="text-blue-100">Event Management System</p>
                </div>
                <div class="flex items-center space-x-4">
                    <button class="bg-blue-700 hover:bg-blue-800 px-4 py-2 rounded-lg">
                        <i class="fas fa-plus mr-2"></i>Create Event
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-10">
        <div class="container mx-auto px-6 py-3">
            <div class="flex space-x-6">
                <a href="/faculty/dashboard" class="text-blue-600 font-medium hover:text-blue-800">Dashboard</a>
                <a href="/faculty/events" class="text-gray-600 hover:text-gray-800">My Events</a>
                <a href="/faculty/participants" class="text-gray-600 hover:text-gray-800">Participants</a>
                <a href="/faculty/sports" class="text-gray-600 hover:text-gray-800">Sports</a>
                <a href="/faculty/seminars" class="text-gray-600 hover:text-gray-800">Seminars</a>
                <a href="/faculty/reports" class="text-gray-600 hover:text-gray-800">Reports</a>
                <a href="/faculty/analytics" class="text-gray-600 hover:text-gray-800">Analytics</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-6 py-8">
        <!-- Key Metrics -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                        <i class="fas fa-calendar text-blue-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-medium text-gray-600">Total Events</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= stats.totalEvents %></p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mr-4">
                        <i class="fas fa-check-circle text-green-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-medium text-gray-600">Approved</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= stats.approvedEvents %></p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mr-4">
                        <i class="fas fa-clock text-yellow-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-medium text-gray-600">Pending</h3>
                        <p class="text-2xl font-bold text-gray-800"><%= stats.pendingEvents %></p>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mr-4">
                        <i class="fas fa-users text-purple-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-medium text-gray-600">Participants</h3>
                        <p class="text-2xl font-bold text-gray-800">247</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-6">Quick Actions</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <a href="/faculty/events/create" class="bg-blue-50 border-2 border-blue-200 rounded-lg p-4 text-center hover:bg-blue-100 transition">
                    <i class="fas fa-plus-circle text-blue-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Create Event</p>
                    <p class="text-xs text-gray-600">Add new event</p>
                </a>
                
                <a href="/faculty/events" class="bg-green-50 border-2 border-green-200 rounded-lg p-4 text-center hover:bg-green-100 transition">
                    <i class="fas fa-list text-green-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Manage Events</p>
                    <p class="text-xs text-gray-600">Edit & delete</p>
                </a>
                
                <a href="/faculty/participants" class="bg-purple-50 border-2 border-purple-200 rounded-lg p-4 text-center hover:bg-purple-100 transition">
                    <i class="fas fa-users text-purple-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Participants</p>
                    <p class="text-xs text-gray-600">View & manage</p>
                </a>
                
                <a href="/faculty/reports" class="bg-yellow-50 border-2 border-yellow-200 rounded-lg p-4 text-center hover:bg-yellow-100 transition">
                    <i class="fas fa-file-alt text-yellow-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Reports</p>
                    <p class="text-xs text-gray-600">Generate reports</p>
                </a>
            </div>
        </div>

        <!-- Recent Events -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">Recent Events</h2>
                    <a href="/faculty/events" class="text-blue-600 hover:text-blue-800 text-sm">View All</a>
                </div>
                
                <% if (recentEvents && recentEvents.length > 0) { %>
                    <div class="space-y-4">
                        <% recentEvents.slice(0, 5).forEach(event => { %>
                            <div class="border rounded-lg p-4 hover:shadow-md transition">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <h3 class="font-semibold text-gray-800 mb-2"><%= event.title %></h3>
                                        <div class="flex items-center space-x-2 mb-2">
                                            <span class="px-2 py-1 text-xs rounded-full 
                                                <% if (event.status === 'approved') { %>bg-green-100 text-green-800<% } else if (event.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } else { %>bg-red-100 text-red-800<% } %>">
                                                <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                            </span>
                                            <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-600">
                                            <div class="flex justify-between">
                                                <span><i class="fas fa-calendar-alt mr-2"></i><%= new Date(event.date).toLocaleDateString() %></span>
                                                <span><i class="fas fa-users mr-2"></i><%= event.registrations.length %></span>
                                            </div>
                                            <div class="flex justify-between mt-1">
                                                <span><i class="fas fa-clock mr-2"></i><%= event.startTime %></span>
                                                <span><i class="fas fa-map-marker-alt mr-2"></i><%= event.venue %></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex space-x-2 ml-4">
                                        <a href="/faculty/events/<%= event._id %>/edit" class="p-2 text-blue-600 hover:bg-blue-50 rounded" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/faculty/events/<%= event._id %>/registrations" class="p-2 text-green-600 hover:bg-green-50 rounded" title="Participants">
                                            <i class="fas fa-users"></i>
                                        </a>
                                        <% if (event.status !== 'approved') { %>
                                            <form action="/faculty/events/<%= event._id %>/delete" method="POST" class="inline">
                                                <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-8">
                        <i class="fas fa-calendar-times text-4xl text-gray-300 mb-4"></i>
                        <p class="text-gray-500">No events created yet</p>
                        <a href="/faculty/events/create" class="inline-block mt-4 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
                            Create Your First Event
                        </a>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Event Categories -->
        <div class="bg-white rounded-lg shadow p-6 mt-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-6">Event Categories</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <a href="/faculty/events/create?category=seminar" class="bg-blue-50 rounded-lg p-4 text-center hover:bg-blue-100 transition">
                    <i class="fas fa-chalkboard-teacher text-blue-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Seminars</p>
                    <p class="text-xs text-gray-600">Academic events</p>
                </a>
                
                <a href="/faculty/events/create?category=workshop" class="bg-green-50 rounded-lg p-4 text-center hover:bg-green-100 transition">
                    <i class="fas fa-tools text-green-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Workshops</p>
                    <p class="text-xs text-gray-600">Hands-on training</p>
                </a>
                
                <a href="/faculty/events/create?category=cultural" class="bg-purple-50 rounded-lg p-4 text-center hover:bg-purple-100 transition">
                    <i class="fas fa-music text-purple-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Cultural</p>
                    <p class="text-xs text-gray-600">Arts & culture</p>
                </a>
                
                <a href="/faculty/events/create?category=sports" class="bg-red-50 rounded-lg p-4 text-center hover:bg-red-100 transition">
                    <i class="fas fa-running text-red-600 text-2xl mb-2"></i>
                    <p class="text-sm font-medium text-gray-800">Sports</p>
                    <p class="text-xs text-gray-600">Athletic events</p>
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white mt-12">
        <div class="container mx-auto px-6 py-4">
            <div class="text-center">
                <p>&copy; 2024 Event Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>
