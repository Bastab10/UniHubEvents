<%- include('../partials/header') %>

<style>
.compact-action-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #0ea5a4;
    color: #0ea5a4;
    transition: all 0.2s ease;
    font-weight: 500;
    white-space: nowrap;
    font-size: 0.75rem;
    cursor: pointer;
}

.compact-action-btn:hover {
    background-color: #0ea5a4;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(14, 165, 164, 0.3);
}

.compact-action-btn:focus {
    background-color: #0ea5a4;
    color: white;
    outline: none;
}

@media (max-width: 640px) {
    .compact-action-btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
    }
    
    .compact-action-btn i {
        font-size: 0.7rem !important;
    }
    
    .compact-action-btn span {
        font-size: 0.65rem !important;
    }
}
</style>

<div class="flex min-h-screen">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1 bg-white">
        <div class="p-6">
            <div class="mb-6 flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">Registered Students</h1>
                    <p class="text-gray-600">
                        Event: <%= event.title %> | 
                        Date: <%= new Date(event.date).toLocaleDateString() %> | 
                        Venue: <%= event.venue %>
                    </p>
                </div>
                <a href="/faculty/events" class="compact-action-btn">
                    <i class="fas fa-arrow-left text-sm"></i>
                    <span class="text-xs">Back to Events</span>
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <p class="text-sm text-blue-600 font-medium">Total Registrations</p>
                    <p class="text-2xl font-bold text-blue-800"><%= stats.total %></p>
                </div>
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <p class="text-sm text-yellow-600 font-medium">Pending</p>
                    <p class="text-2xl font-bold text-yellow-800"><%= stats.pending %></p>
                </div>
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <p class="text-sm text-green-600 font-medium">Approved</p>
                    <p class="text-2xl font-bold text-green-800"><%= stats.approved %></p>
                </div>
                <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                    <p class="text-sm text-red-600 font-medium">Rejected</p>
                    <p class="text-2xl font-bold text-red-800"><%= stats.rejected %></p>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-800">Student Registrations</h2>
                </div>
                
                <% if (typeof registrations !== 'undefined' && registrations && registrations.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">College ID</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Team Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Registered On</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% registrations.forEach(registration => { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% if (registration.student) { %>
                                                <%= registration.student.profile.fullName %>
                                            <% } else { %>
                                                <span class="text-gray-400">Student not found</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% if (registration.student) { %>
                                                <%= registration.student.profile.collegeId %>
                                            <% } else { %>
                                                <span class="text-gray-400">N/A</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% if (registration.student) { %>
                                                <%= registration.student.email %>
                                            <% } else { %>
                                                <span class="text-gray-400">N/A</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <%= registration.teamName || '-' %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% if (registration.status === 'pending') { %>
                                                <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Pending</span>
                                            <% } else if (registration.status === 'approved') { %>
                                                <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Approved</span>
                                            <% } else if (registration.status === 'rejected') { %>
                                                <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Rejected</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= new Date(registration.registeredAt).toLocaleDateString() %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                            <% if (registration.status === 'pending') { %>
                                                <button onclick="approveRegistration('<%= registration._id %>')" 
                                                        class="compact-action-btn mr-2">
                                                    <i class="fas fa-check-circle text-sm"></i>
                                                    <span class="text-xs">Approve</span>
                                                </button>
                                                <button onclick="rejectRegistration('<%= registration._id %>')" 
                                                        class="compact-action-btn mr-2">
                                                    <i class="fas fa-times-circle text-sm"></i>
                                                    <span class="text-xs">Reject</span>
                                                </button>
                                                <button onclick="deleteRegistration('<%= registration._id %>')" 
                                                        class="compact-action-btn">
                                                    <i class="fas fa-trash text-sm"></i>
                                                    <span class="text-xs">Delete</span>
                                                </button>
                                            <% } else if (registration.status === 'approved') { %>
                                                <span class="text-green-600">
                                                    <i class="fas fa-check-circle"></i> Approved
                                                </span>
                                                <button onclick="deleteRegistration('<%= registration._id %>')" 
                                                        class="compact-action-btn">
                                                    <i class="fas fa-trash text-sm"></i>
                                                    <span class="text-xs">Delete</span>
                                                </button>
                                            <% } else if (registration.status === 'rejected') { %>
                                                <span class="text-red-600">
                                                    <i class="fas fa-times-circle"></i> Rejected
                                                </span>
                                                <button onclick="deleteRegistration('<%= registration._id %>')" 
                                                        class="compact-action-btn">
                                                    <i class="fas fa-trash text-sm"></i>
                                                    <span class="text-xs">Delete</span>
                                                </button>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <i class="fas fa-users text-gray-300 text-6xl mb-4"></i>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">No registrations yet</h3>
                        <p class="text-gray-500">Students haven't registered for this event yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>

<script>
const eventId = '<%= event._id %>';

function approveRegistration(registrationId) {
    if (confirm('Are you sure you want to approve this registration?')) {
        fetch(`/faculty/events/${eventId}/registrations/${registrationId}/approve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error approving registration: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error approving registration');
        });
    }
}

function rejectRegistration(registrationId) {
    const reason = prompt('Please enter reason for rejection:');
    if (reason) {
        fetch(`/faculty/events/${eventId}/registrations/${registrationId}/reject`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ reason })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error rejecting registration: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error rejecting registration');
        });
    }
}

function deleteRegistration(registrationId) {
    if (confirm('Are you sure you want to delete this registration? This action cannot be undone.')) {
        fetch(`/faculty/events/${eventId}/registrations/${registrationId}/delete`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error deleting registration: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error deleting registration');
        });
    }
}
</script>
