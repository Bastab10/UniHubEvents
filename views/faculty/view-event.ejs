<%- include('../partials/header') %>

<style>
/* Compact Action Buttons - Match Header Logout Button Style */
.compact-action-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #0ea5a4;
    color: #0ea5a4;
    transition: all 0.2s ease;
    font-weight: 500;
    white-space: nowrap;
    font-size: 0.75rem;
    cursor: pointer;
}

.compact-action-btn:hover {
    background-color: #0ea5a4;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(14, 165, 164, 0.3);
}

.compact-action-btn:focus {
    background-color: #0ea5a4;
    color: white;
    outline: none;
}

/* Mobile responsiveness for compact buttons */
@media (max-width: 640px) {
    .compact-action-btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
    }
    
    .compact-action-btn i {
        font-size: 0.7rem !important;
    }
    
    .compact-action-btn span {
        font-size: 0.65rem !important;
    }
}
</style>

<div class="flex min-h-screen bg-gray-50" style="background-color: #F5F7FB;">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="p-6">
            <!-- Centered Container -->
            <div class="max-w-6xl mx-auto">
                <!-- Page Header -->
                <div class="bg-white rounded-xl shadow-lg p-6 mb-6 border-l-4 border-blue-500">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Event Details</h1>
                            <p class="text-gray-600 mt-2">View event information and registered students</p>
                        </div>
                    </div>
                </div>

                <!-- Event Details Card -->
                <div class="bg-white rounded-xl shadow-xl p-8 mb-6 border border-gray-200">
                    <!-- Event Banner -->
                    <div class="mb-8">
                        <% if (event.poster) { %>
                            <img src="/uploads/<%= event.poster %>" alt="<%= event.title %>" class="w-full h-64 object-cover rounded-lg shadow-md">
                        <% } else { %>
                            <div class="w-full h-64 bg-gradient-to-br from-blue-400 to-purple-600 rounded-lg shadow-md flex items-center justify-center">
                                <div class="text-center text-white">
                                    <i class="fas fa-calendar-alt text-5xl mb-3"></i>
                                    <p class="text-xl font-semibold">Event Banner</p>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Event Information -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Main Event Details -->
                        <div class="lg:col-span-2 space-y-6">
                            <!-- Title and Category -->
                            <div>
                                <h2 class="text-3xl font-bold text-gray-800 mb-3"><%= event.title %></h2>
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="px-4 py-2 text-sm font-semibold rounded-full 
                                        <% if (event.category === 'seminar') { %>bg-blue-100 text-blue-800<% } 
                                           else if (event.category === 'workshop') { %>bg-green-100 text-green-800<% } 
                                           else if (event.category === 'cultural') { %>bg-purple-100 text-purple-800<% } 
                                           else if (event.category === 'sports') { %>bg-orange-100 text-orange-800<% }
                                           else { %>bg-gray-100 text-gray-800<% } %>">
                                        <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                    </span>
                                    <span class="px-4 py-2 text-sm font-semibold rounded-full bg-indigo-100 text-indigo-800">
                                        <%= event.eventType === 'team' ? 'Team Event' : 'Individual Event' %>
                                    </span>
                                </div>
                            </div>

                            <!-- Description -->
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-2">Description</h3>
                                <p class="text-gray-600 leading-relaxed"><%= event.description || 'No description available' %></p>
                            </div>

                            <!-- Event Details Grid -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- Date and Time -->
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex items-center mb-2">
                                        <i class="fas fa-calendar-alt text-blue-500 text-xl mr-3"></i>
                                        <h4 class="font-semibold text-gray-800">Date & Time</h4>
                                    </div>
                                    <p class="text-gray-600 ml-8">
                                        <%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %><br>
                                        <strong>Time:</strong> <%= event.startTime %> - <%= event.endTime %>
                                    </p>
                                </div>

                                <!-- Venue -->
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex items-center mb-2">
                                        <i class="fas fa-map-marker-alt text-red-500 text-xl mr-3"></i>
                                        <h4 class="font-semibold text-gray-800">Venue</h4>
                                    </div>
                                    <p class="text-gray-600 ml-8"><%= event.venue %></p>
                                </div>

                                <!-- Max Participants -->
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex items-center mb-2">
                                        <i class="fas fa-users text-green-500 text-xl mr-3"></i>
                                        <h4 class="font-semibold text-gray-800">Capacity</h4>
                                    </div>
                                    <p class="text-gray-600 ml-8">
                                        <% if (event.maxParticipants) { %>
                                            <%= event.maxParticipants %> Maximum Participants
                                        <% } else { %>
                                            Unlimited Participants
                                        <% } %>
                                    </p>
                                </div>

                                <!-- Team Size (if team event) -->
                                <% if (event.eventType === 'team') { %>
                                    <div class="bg-gray-50 rounded-lg p-4">
                                        <div class="flex items-center mb-2">
                                            <i class="fas fa-users text-purple-500 text-xl mr-3"></i>
                                            <h4 class="font-semibold text-gray-800">Team Size</h4>
                                        </div>
                                        <p class="text-gray-600 ml-8"><%= event.teamSize %> Members per Team</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Registration Stats -->
                        <div class="space-y-6">
                            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg p-6 border border-blue-200">
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Registration Statistics</h3>
                                <div class="space-y-3">
                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-600">Total Registered</span>
                                        <span class="text-2xl font-bold text-blue-600"><%= event.registrations ? event.registrations.length : 0 %></span>
                                    </div>
                                    <% if (event.maxParticipants) { %>
                                        <div class="flex justify-between items-center">
                                            <span class="text-gray-600">Available Spots</span>
                                            <span class="text-xl font-semibold text-green-600">
                                                <%= Math.max(0, event.maxParticipants - (event.registrations ? event.registrations.length : 0)) %>
                                            </span>
                                        </div>
                                        <!-- Progress Bar -->
                                        <div class="mt-3">
                                            <div class="w-full bg-gray-200 rounded-full h-2">
                                                <% 
                                                const registeredCount = event.registrations ? event.registrations.length : 0;
                                                const percentage = (registeredCount / event.maxParticipants) * 100;
                                                %>
                                                <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%;"></div>
                                                <script>
                                                    document.addEventListener('DOMContentLoaded', function() {
                                                        const progressBar = document.getElementById('progress-bar');
                                                        if (progressBar) {
                                                            progressBar.style.width = '<%= Math.min(100, percentage) %>%';
                                                        }
                                                    });
                                                </script>
                                            </div>
                                            <p class="text-xs text-gray-500 mt-1"><%= Math.round(percentage) %>% filled</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Quick Actions -->
                            <div class="space-y-3">
                                <a href="/faculty/events/<%= event._id %>/edit" class="w-full bg-blue-600 text-white px-4 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium text-center block">
                                    <i class="fas fa-edit mr-2"></i>Edit Event
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Registered Students Section -->
                <div class="bg-white rounded-xl shadow-xl p-8 border border-gray-200">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-2xl font-bold text-gray-800">Registered Students</h2>
                        <div class="flex items-center gap-4">
                            <span class="text-sm text-gray-600">
                                <%= event.registrations ? event.registrations.length : 0 %> Total Registrations
                            </span>
                            <% if (event.registrations && event.registrations.length > 0) { %>
                                <button onclick="exportRegistrations()" class="compact-action-btn">
                                    <i class="fas fa-download text-sm"></i>
                                    <span class="text-xs">Export List</span>
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <% if (event.registrations && event.registrations.length > 0) { %>
                        <!-- Students Table -->
                        <div class="overflow-x-auto">
                            <table class="w-full table-auto">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-200">
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student Name</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student ID / Roll Number</th>
                                        <% if (event.eventType === 'team') { %>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Team Name</th>
                                        <% } %>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Registration Date</th>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    <% event.registrations.forEach((registration, index) => { %>
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-4 py-4 whitespace-nowrap">
                                                <% if (registration.student) { %>
                                                    <div class="flex items-center">
                                                        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-medium mr-3">
                                                            <%= registration.student.profile.fullName ? registration.student.profile.fullName.charAt(0).toUpperCase() : 'S' %>
                                                        </div>
                                                        <span class="font-medium text-gray-900">
                                                            <%= registration.student.profile.fullName %>
                                                        </span>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-gray-400">Student not found</span>
                                                <% } %>
                                            </td>
                                            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                                                <% if (registration.student) { %>
                                                    <%= registration.student.email %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                                                <% if (registration.student) { %>
                                                    <%= registration.student.profile.collegeId %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            <% if (event.eventType === 'team') { %>
                                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900">
                                                    <span class="px-2 py-1 bg-purple-100 text-purple-800 rounded-full text-xs font-medium">
                                                        <%= registration.teamName || 'No Team' %>
                                                    </span>
                                                </td>
                                            <% } %>
                                            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                                                <%= new Date(registration.registeredAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            </td>
                                            <td class="px-4 py-4 whitespace-nowrap text-sm font-medium">
                                                <% if (registration.student) { %>
                                                    <button onclick="viewStudentDetails('<%= registration.student._id %>')" 
        class="compact-action-btn mr-2"
        title="View Student Details">
    <i class="fas fa-eye text-sm"></i>
    <span class="text-xs">View</span>
</button>
<button onclick="deleteRegistration('<%= registration._id %>')" 
        class="compact-action-btn"
        title="Cancel Registration">
    <i class="fas fa-trash text-sm"></i>
    <span class="text-xs">Delete</span>
</button>
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-gray-400">N/A</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <!-- No Registrations State -->
                        <div class="text-center py-12">
                            <i class="fas fa-user-graduate text-gray-400 text-6xl mb-4"></i>
                            <h3 class="text-xl font-semibold text-gray-600 mb-2">No students have registered for this event yet.</h3>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
// Define event ID for JavaScript functions
const eventId = '<%= event._id %>';

// Export registrations function
function exportRegistrations() {
    // Get data from server-side rendered variables
    const registrationsElement = document.getElementById('registrations-data');
    const eventTitleElement = document.getElementById('event-title-data');
    const eventTypeElement = document.getElementById('event-type-data');
    
    if (!registrationsElement) {
        alert('No registrations data available');
        return;
    }
    
    const registrations = JSON.parse(registrationsElement.textContent || '[]');
    const eventTitle = eventTitleElement ? eventTitleElement.textContent : 'Event';
    const eventType = eventTypeElement ? eventTypeElement.textContent : 'individual';
    
    if (registrations.length === 0) {
        alert('No registrations to export');
        return;
    }
    
    let csv = '';
    
    if (eventType === 'team') {
        // Team events - structured format with team leader and members
        csv = 'Team Name,Team Leader Name,Team Leader College ID,Team Leader Email,Department (Leader),Member1 Name,Member1 College ID,Member2 Name,Member2 College ID,Member3 Name,Member3 College ID,Registration Date\n';
        
        registrations.forEach(reg => {
            // Team Information
            const teamName = reg.teamName || 'N/A';
            const teamLeaderName = reg.teamLeaderName || 'N/A';
            const teamLeaderCollegeId = reg.teamLeaderCollegeId || 'N/A';
            const teamLeaderEmail = reg.teamLeaderEmail || 'N/A';
            const teamLeaderDepartment = reg.teamLeaderDepartment || 'N/A';
            
            // Team Members - extract up to 3 members
            let member1Name = '', member1CollegeId = '';
            let member2Name = '', member2CollegeId = '';
            let member3Name = '', member3CollegeId = '';
            
            if (reg.teamMembers && Array.isArray(reg.teamMembers)) {
                if (reg.teamMembers[0]) {
                    member1Name = reg.teamMembers[0].name || '';
                    member1CollegeId = reg.teamMembers[0].collegeId || '';
                }
                if (reg.teamMembers[1]) {
                    member2Name = reg.teamMembers[1].name || '';
                    member2CollegeId = reg.teamMembers[1].collegeId || '';
                }
                if (reg.teamMembers[2]) {
                    member3Name = reg.teamMembers[2].name || '';
                    member3CollegeId = reg.teamMembers[2].collegeId || '';
                }
            }
            
            // Format registration date properly
            let registrationDate = 'N/A';
            if (reg.registeredAt) {
                try {
                    const date = new Date(reg.registeredAt);
                    if (!isNaN(date.getTime())) {
                        registrationDate = date.toLocaleDateString('en-GB'); // DD/MM/YYYY format
                    }
                } catch (e) {
                    registrationDate = 'Invalid Date';
                }
            }
            
            csv += `"${teamName}","${teamLeaderName}","${teamLeaderCollegeId}","${teamLeaderEmail}","${teamLeaderDepartment}","${member1Name}","${member1CollegeId}","${member2Name}","${member2CollegeId}","${member3Name}","${member3CollegeId}","${registrationDate}"\n`;
        });
    } else {
        // Individual events - original format
        csv = 'Student Name,Email,College ID,Registration Date\n';
        
        registrations.forEach(reg => {
            // Extract student data from nested structure
            let studentName = 'N/A';
            let studentEmail = 'N/A';
            let collegeId = 'N/A';
            
            if (reg.student) {
                // Try to get fullName first, then fall back to firstName + lastName
                studentName = reg.student.profile.fullName || 
                             (reg.student.profile.firstName && reg.student.profile.lastName ? 
                              reg.student.profile.firstName + ' ' + reg.student.profile.lastName : 
                              reg.student.profile.firstName || reg.student.profile.lastName || 'N/A');
                studentEmail = reg.student.email || 'N/A';
                collegeId = reg.student.profile.collegeId || 'N/A';
            }
            
            // Format registration date properly
            let registrationDate = 'N/A';
            if (reg.registeredAt) {
                try {
                    const date = new Date(reg.registeredAt);
                    if (!isNaN(date.getTime())) {
                        registrationDate = date.toLocaleDateString('en-GB'); // DD/MM/YYYY format
                    }
                } catch (e) {
                    registrationDate = 'Invalid Date';
                }
            }
            
            csv += `"${studentName}","${studentEmail}","${collegeId}","${registrationDate}"\n`;
        });
    }
    
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.setAttribute('hidden', '');
    a.setAttribute('href', url);
    a.setAttribute('download', eventTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase() + '_registrations.csv');
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}

// View Student Details
function viewStudentDetails(studentId) {
    // Redirect to student details page or show modal
    window.location.href = `/faculty/student/${studentId}`;
}

// Delete Registration
function deleteRegistration(registrationId) {
    if (confirm('Are you sure you want to cancel this student\'s registration?')) {
        fetch(`/faculty/events/${eventId}/registrations/${registrationId}/delete`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Reload the page to show updated registrations
                location.reload();
            } else {
                alert('Error cancelling registration: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error cancelling registration');
        });
    }
}
</script>

<!-- Hidden data elements for JavaScript -->
<div id="registrations-data" style="display: none;"><%- JSON.stringify(event.registrations || []) %></div>
<div id="event-title-data" style="display: none;"><%= event.title || 'Event' %></div>
<div id="event-type-data" style="display: none;"><%= event.eventType || 'individual' %></div>

<%- include('../partials/footer') %>
