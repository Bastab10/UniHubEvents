<%- include('../partials/header') %>

<style>
/* Flash Message Styles */
.flash-message {
    animation: slideIn 0.3s ease-out;
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
}

.flash-message.hide {
    opacity: 0;
    transform: translateY(-20px);
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Compact Action Buttons - Match Header Logout Button Style */
.compact-action-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid #0ea5a4;
    color: #0ea5a4;
    transition: all 0.2s ease;
    font-weight: 500;
    white-space: nowrap;
    font-size: 0.8125rem;
    cursor: pointer;
    min-height: 2.5rem;
    justify-content: center;
}

.compact-action-btn:hover {
    background-color: #0ea5a4;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(14, 165, 164, 0.3);
}

.compact-action-btn:focus {
    background-color: #0ea5a4;
    color: white;
    outline: none;
}

/* Mobile responsiveness for compact buttons */
@media (max-width: 640px) {
    .compact-action-btn {
        padding: 0.625rem 0.75rem;
        font-size: 0.75rem;
        min-height: 2.75rem;
        width: 100%;
        margin-bottom: 0.5rem;
    }
    
    .compact-action-btn i {
        font-size: 0.875rem !important;
    }
    
    .compact-action-btn span {
        font-size: 0.75rem !important;
    }
}

/* Mobile Responsive Layout */
@media (max-width: 768px) {
    .flex.min-h-screen.bg-gray-50 {
        padding: 0.5rem;
    }
    
    main {
        padding: 0.75rem;
        margin: 0;
        overflow-x: hidden;
    }
    
    .bg-white.rounded-xl.shadow-xl.p-8 {
        padding: 1rem;
        border-radius: 0.75rem;
    }
    
    .grid.grid-cols-1.md\:grid-cols-2 {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

/* Form Mobile Optimization */
@media (max-width: 640px) {
    .form-group {
        margin-bottom: 1.25rem;
    }
    
    label {
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }
    
    input[type="text"],
    input[type="email"],
    input[type="number"],
    input[type="date"],
    input[type="time"],
    select,
    textarea {
        width: 100%;
        padding: 0.75rem;
        font-size: 1rem;
        border-radius: 0.5rem;
        border: 1px solid #d1d5db;
        margin-bottom: 0.5rem;
    }
    
    textarea {
        min-height: 120px;
        resize: vertical;
    }
    
    .btn {
        width: 100%;
        padding: 0.875rem 1rem;
        font-size: 1rem;
        min-height: 3rem;
        margin-bottom: 0.75rem;
        border-radius: 0.5rem;
    }
    
    .btn-primary {
        background-color: #0ea5a4;
        color: white;
        border: none;
    }
    
    .btn-secondary {
        background-color: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }
}

/* File Upload Mobile Optimization */
@media (max-width: 640px) {
    .file-upload {
        width: 100%;
        padding: 1rem;
        border: 2px dashed #d1d5db;
        border-radius: 0.5rem;
        text-align: center;
        background-color: #f9fafb;
    }
    
    .file-upload:hover {
        border-color: #0ea5a4;
        background-color: #f0fdfa;
    }
}

/* Typography Mobile Optimization */
@media (max-width: 640px) {
    h1 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }
    
    h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }
    
    h3 {
        font-size: 1.125rem;
        margin-bottom: 0.75rem;
    }
    
    .text-2xl {
        font-size: 1.5rem;
    }
    
    .text-lg {
        font-size: 1rem;
    }
}

/* Button Groups Mobile */
@media (max-width: 640px) {
    .flex.gap-4 {
        flex-direction: column;
        gap: 0.75rem;
    }
    
    .flex.justify-end {
        justify-content: stretch;
        flex-direction: column;
    }
}

/* Remove horizontal scrolling */
@media (max-width: 640px) {
    body {
        overflow-x: hidden;
    }
    
    main {
        overflow-x: hidden;
    }
}
</style>

<div class="flex min-h-screen bg-gray-50">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="p-6">
            <!-- Centered Container -->
            <div class="max-w-4xl mx-auto">
                <!-- Page Header -->
                <div class="bg-white rounded-xl shadow-lg p-6 mb-6 border-l-4 border-blue-500">
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
                        Create New Event
                    </h1>
                    <p class="text-gray-600 mt-2">Fill in the details to create a new event</p>

                    <% if (error) { %>
                        <div id="flash-message" class="flash-message bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mt-4">
                            <div class="flex items-center">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                <span><%= error %></span>
                            </div>
                        </div>
                    <% } %>

                    <% if (success) { %>
                        <div id="flash-message" class="flash-message bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mt-4">
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-2"></i>
                                <span><%= success %></span>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Form Container -->
                <div class="bg-white rounded-xl shadow-xl p-8 border border-gray-200">
                    <form method="POST" action="/faculty/events/create" enctype="multipart/form-data" class="space-y-8">

                        <!-- Basic Information Section -->
                        <div class="space-y-6">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Basic Information</h2>
                            
                            <!-- Event Title - Full Width -->
                            <div>
                                <label for="title" class="block text-sm font-semibold mb-2 text-gray-700">Event Title *</label>
                                <input type="text" id="title" name="title" required
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                       placeholder="Enter event title">
                            </div>

                            <!-- Description - Full Width -->
                            <div>
                                <label for="description" class="block text-sm font-semibold mb-2 text-gray-700">Description *</label>
                                <textarea id="description" name="description" rows="4" required
                                          class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 resize-vertical transition-colors text-black"
                                          placeholder="Describe your event"></textarea>
                            </div>

                            <!-- Category and Sub-category - Two Columns -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="category" class="block text-sm font-semibold mb-2 text-gray-700">Category *</label>
                                    <select id="category" name="category" required
                                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                        <option value="">Select a category</option>
                                        <option value="seminar">Seminars</option>
                                        <option value="workshop">Workshops</option>
                                        <option value="hackathon">Hackathons</option>
                                        <option value="quiz">Quizzes</option>
                                        <option value="talkshow">Talk Shows</option>
                                        <option value="bootcamp">Bootcamps</option>
                                        <option value="cultural">Cultural</option>
                                        <option value="sports">Sports</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="subCategory" class="block text-sm font-semibold mb-2 text-gray-700">Sub-category</label>
                                    <input type="text" id="subCategory" name="subCategory"
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                           placeholder="e.g., Football, Music, Technical">
                                </div>
                            </div>

                            <!-- Event Type and Team Size - Two Columns -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="eventType" class="block text-sm font-semibold mb-2 text-gray-700">Event Type *</label>
                                    <select id="eventType" name="eventType" required
                                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                        <option value="">Select event type</option>
                                        <option value="individual">Individual</option>
                                        <option value="team">Team</option>
                                    </select>
                                </div>

                                <div id="teamSizeDiv" class="hidden">
                                    <label for="teamSize" class="block text-sm font-semibold mb-2 text-gray-700">
                                        Team Size (Members Only)
                                        <span class="text-xs font-normal text-gray-500 ml-1">(excluding team leader)</span>
                                    </label>
                                    <input type="number" id="teamSize" name="teamSize" min="1" max="20"
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                           placeholder="Number of team members (excluding leader)">
                                    <p class="text-xs text-gray-500 mt-1">Total people = 1 leader + N members</p>
                                </div>
                            </div>

                            <!-- Maximum Teams per Department - Shows only for Team events -->
                            <div id="maxTeamsPerDeptDiv" class="hidden">
                                <label for="maxTeamsPerDepartment" class="block text-sm font-semibold mb-2 text-gray-700">
                                    Maximum Teams per Department
                                    <span class="text-xs font-normal text-gray-500 ml-1">(Optional - Leave empty for unlimited)</span>
                                </label>
                                <input type="number" id="maxTeamsPerDepartment" name="maxTeamsPerDepartment" min="1" max="50"
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                       placeholder="e.g., 2 (only 2 teams allowed per department)">
                                <p class="text-xs text-gray-500 mt-1">Leave empty to allow unlimited teams from any department</p>
                            </div>

                            <!-- Event Format - Shows only for Team events -->
                            <div id="eventFormatDiv" class="hidden">
                                <label for="eventFormat" class="block text-sm font-semibold mb-2 text-gray-700">
                                    Event Format *
                                    <span class="text-xs font-normal text-gray-500 ml-1">(For team events only)</span>
                                </label>
                                <select id="eventFormat" name="eventFormat"
                                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                    <option value="">Select format</option>
                                    <option value="knockout">Knockout (Match-based)</option>
                                    <option value="ranking">Ranking (Multiple teams compete)</option>
                                </select>
                                <p class="text-xs text-gray-500 mt-1">Knockout: Teams compete in matches | Ranking: Final positions assigned</p>
                            </div>

                            <!-- Maximum Participants - Full Width -->
                            <div>
                                <label for="maxParticipants" class="block text-sm font-semibold mb-2 text-gray-700">Maximum Participants</label>
                                <input type="number" id="maxParticipants" name="maxParticipants" min="1"
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                       placeholder="Leave empty for unlimited">
                            </div>
                        </div>

                        <!-- Event Schedule Section -->
                        <div class="space-y-6">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Event Schedule</h2>
                            
                            <!-- Date and Time - Three Columns -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div>
                                    <label for="date" class="block text-sm font-semibold mb-2 text-gray-700">Event Date *</label>
                                    <input type="date" id="date" name="date" required
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                </div>

                                <div>
                                    <label for="startTime" class="block text-sm font-semibold mb-2 text-gray-700">Start Time *</label>
                                    <input type="time" id="startTime" name="startTime" required
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                </div>

                                <div>
                                    <label for="endTime" class="block text-sm font-semibold mb-2 text-gray-700">End Time *</label>
                                    <input type="time" id="endTime" name="endTime" required
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                </div>
                            </div>

                            <!-- Venue - Full Width -->
                            <div>
                                <label for="venue" class="block text-sm font-semibold mb-2 text-gray-700">Venue *</label>
                                <input type="text" id="venue" name="venue" required
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                       placeholder="Event location">
                            </div>
                        </div>

                        <!-- Media Section -->
                        <div class="space-y-6">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Event Media</h2>
                            
                            <!-- Poster Upload -->
                            <div>
                                <label for="poster" class="block text-sm font-semibold mb-2 text-gray-700">Event Poster</label>
                                <input type="file" id="poster" name="poster" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                       onchange="previewImage(this)">
                                <p class="text-sm text-gray-500 mt-1">Upload an image for your event poster (optional)</p>
                                <p class="text-xs text-gray-400 mt-1">Supported formats: JPEG, JPG, PNG, GIF, WEBP (Max size: 5MB)</p>
                                
                                <!-- Image Preview -->
                                <div id="imagePreview" class="mt-3 hidden">
                                    <img id="previewImg" src="" alt="Image preview" class="w-32 h-32 object-cover rounded-lg shadow-md">
                                    <p class="text-sm text-gray-500 mt-1">Image preview will appear here</p>
                                </div>
                                
                                <script>
                                function previewImage(input) {
                                    if (input.files && input.files[0]) {
                                        const file = input.files[0];
                                        const reader = new FileReader();
                                        
                                        reader.onload = function(e) {
                                            const preview = document.getElementById('imagePreview');
                                            const previewImg = document.getElementById('previewImg');
                                            
                                            if (preview && previewImg) {
                                                preview.classList.remove('hidden');
                                                previewImg.src = e.target.result;
                                                previewImg.onerror = function() {
                                                    this.style.display = 'none';
                                                    preview.classList.add('hidden');
                                                };
                                            }
                                        };
                                        
                                        reader.readAsDataURL(file);
                                    } else {
                                        const preview = document.getElementById('imagePreview');
                                        if (preview) {
                                            preview.classList.add('hidden');
                                        }
                                    }
                                }
                                </script>
                                <button type="button" onclick="removeImage()" class="mt-2 text-sm text-red-600 hover:text-red-800">
                                    <i class="fas fa-times mr-1"></i>Remove Image
                                </button>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                            <a href="/faculty/events" class="compact-action-btn">
                                <i class="fas fa-times text-sm"></i>
                                <span class="text-xs">Cancel</span>
                            </a>
                            <button type="submit" class="compact-action-btn">
                                <i class="fas fa-plus text-sm"></i>
                                <span class="text-xs">Create Event</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
// Auto-hide flash messages after 5 seconds
document.addEventListener('DOMContentLoaded', function() {
    const flashMessage = document.getElementById('flash-message');
    if (flashMessage) {
        setTimeout(function() {
            flashMessage.classList.add('hide');
            setTimeout(function() {
                flashMessage.style.display = 'none';
            }, 500); 
        }, 5000);
    }
});

// Show/hide team fields based on event type
document.getElementById('eventType').addEventListener('change', function() {
    const teamSizeDiv = document.getElementById('teamSizeDiv');
    const maxTeamsPerDeptDiv = document.getElementById('maxTeamsPerDeptDiv');
    const eventFormatDiv = document.getElementById('eventFormatDiv');
    if (this.value === 'team') {
        teamSizeDiv.classList.remove('hidden');
        maxTeamsPerDeptDiv.classList.remove('hidden');
        eventFormatDiv.classList.remove('hidden');
    } else {
        teamSizeDiv.classList.add('hidden');
        maxTeamsPerDeptDiv.classList.add('hidden');
        eventFormatDiv.classList.add('hidden');
    }
});

// Image preview functionality for mobile
function previewImage(input) {
    const preview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    if (input.files && input.files[0]) {
        const file = input.files[0];
        
        // Validate file size (5MB limit)
        if (file.size > 5 * 1024 * 1024) {
            alert('File size must be less than 5MB');
            input.value = '';
            return;
        }
        
        // Validate file type
        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
        if (!allowedTypes.includes(file.type)) {
            alert('Only JPEG, JPG, PNG, GIF, and WEBP files are allowed');
            input.value = '';
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            preview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
    }
}

// Remove image functionality
function removeImage() {
    const input = document.getElementById('poster');
    const preview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    input.value = '';
    previewImg.src = '';
    preview.classList.add('hidden');
}

// Mobile-specific enhancements
if (window.innerWidth <= 768) {
    // Add mobile-specific file input handling
    const fileInput = document.getElementById('poster');
    
    fileInput.addEventListener('touchstart', function() {
        this.classList.add('ring-2', 'ring-blue-500');
    });
    
    fileInput.addEventListener('touchend', function() {
        setTimeout(() => {
            this.classList.remove('ring-2', 'ring-blue-500');
        }, 200);
    });
    
    // Prevent zoom on input focus (mobile)
    fileInput.addEventListener('focus', function() {
        document.querySelector('meta[name="viewport"]').setAttribute('content', 'width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=0');
    });
    
    fileInput.addEventListener('blur', function() {
        document.querySelector('meta[name="viewport"]').setAttribute('content', 'width=device-width,initial-scale=1.0');
    });
}
</script>

<%- include('../partials/footer') %>