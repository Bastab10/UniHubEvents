<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Panel - Event Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .animate-slide-in {
            animation: slideIn 0.6s ease-out forwards;
        }
        
        .animate-fade-in {
            animation: fadeIn 0.8s ease-out forwards;
        }
        
        .card-hover {
            transition: all 0.3s ease;
        }
        
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .sidebar {
            background: linear-gradient(180deg, #1e3c72 0%, #2a5298 100%);
        }
        
        .stat-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border-left: 4px solid;
            transition: all 0.3s ease;
        }
        
        .stat-card.blue { border-left-color: #3b82f6; }
        .stat-card.green { border-left-color: #10b981; }
        .stat-card.yellow { border-left-color: #f59e0b; }
        .stat-card.purple { border-left-color: #8b5cf6; }
        .stat-card.red { border-left-color: #ef4444; }
        
        .quick-action-btn {
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .quick-action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }
        
        .quick-action-btn:hover::before {
            left: 100%;
        }
        
        .event-card {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }
        
        .event-card:hover {
            border-left-color: #3b82f6;
        }
        
        .notification-badge {
            animation: pulse 2s infinite;
        }
        
        .progress-bar {
            transition: width 1s ease-out;
        }
        
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-weight: 500;
        }
        
        .table-hover:hover {
            background-color: #f9fafb;
        }
        
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
        }
        
        .modal-content {
            background-color: white;
            margin: 5% auto;
            padding: 2rem;
            border-radius: 0.5rem;
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside class="sidebar w-64 text-white flex flex-col">
            <div class="p-6 border-b border-blue-700">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-graduation-cap text-blue-600"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold">Faculty Panel</h2>
                        <p class="text-xs text-blue-200">Event Management</p>
                    </div>
                </div>
            </div>
            
            <nav class="flex-1 p-4">
                <ul class="space-y-2">
                    <li>
                        <a href="/faculty/dashboard" class="flex items-center space-x-3 p-3 rounded-lg bg-white/10 hover:bg-white/20 transition">
                            <i class="fas fa-tachometer-alt w-5"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/events/create" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-plus-circle w-5"></i>
                            <span>Create Event</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/events" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-calendar w-5"></i>
                            <span>My Events</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/participants" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-users w-5"></i>
                            <span>Participants</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/sports" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-running w-5"></i>
                            <span>Sports</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/seminars" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-chalkboard-teacher w-5"></i>
                            <span>Seminars</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/analytics" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-chart-bar w-5"></i>
                            <span>Analytics</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/notifications" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-white/10 transition">
                            <i class="fas fa-bell w-5"></i>
                            <span>Notifications</span>
                            <span class="ml-auto bg-red-500 text-xs px-2 py-1 rounded-full notification-badge">3</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <div class="p-4 border-t border-blue-700">
                <div class="flex items-center space-x-3">
                    <img src="https://picsum.photos/seed/faculty/40/40" alt="Profile" class="w-10 h-10 rounded-full">
                    <div class="flex-1">
                        <p class="text-sm font-medium"><%= currentUser.profile.firstName %> <%= currentUser.profile.lastName %></p>
                        <p class="text-xs text-blue-200">Faculty</p>
                    </div>
                    <a href="/auth/logout" class="text-white/70 hover:text-white">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto">
            <!-- Header -->
            <header class="bg-white shadow-sm border-b border-gray-200">
                <div class="px-6 py-4 flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-800">Faculty Dashboard</h1>
                        <p class="text-gray-600">Manage institutional events and sports activities</p>
                    </div>
                    <div class="flex items-center space-x-4">
                        <button class="relative p-2 text-gray-600 hover:text-gray-800">
                            <i class="fas fa-bell text-xl"></i>
                            <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                        </button>
                        <button class="p-2 text-gray-600 hover:text-gray-800">
                            <i class="fas fa-cog text-xl"></i>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="p-6">
                <!-- Stats Overview -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8 animate-slide-in">
                    <div class="stat-card blue p-6 rounded-lg shadow-lg card-hover">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600 mb-1">Total Events</p>
                                <p class="text-3xl font-bold text-gray-800"><%= stats.totalEvents %></p>
                                <p class="text-xs text-blue-600 mt-2">
                                    <i class="fas fa-calendar-alt"></i> All time
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-calendar text-blue-600 text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card green p-6 rounded-lg shadow-lg card-hover">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600 mb-1">Approved Events</p>
                                <p class="text-3xl font-bold text-gray-800"><%= stats.approvedEvents %></p>
                                <p class="text-xs text-green-600 mt-2">
                                    <i class="fas fa-check-circle"></i> Active
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-check-circle text-green-600 text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card yellow p-6 rounded-lg shadow-lg card-hover">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600 mb-1">Pending Events</p>
                                <p class="text-3xl font-bold text-gray-800"><%= stats.pendingEvents %></p>
                                <p class="text-xs text-yellow-600 mt-2">
                                    <i class="fas fa-clock"></i> Under review
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-clock text-yellow-600 text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card purple p-6 rounded-lg shadow-lg card-hover">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600 mb-1">Total Participants</p>
                                <p class="text-3xl font-bold text-gray-800">247</p>
                                <p class="text-xs text-purple-600 mt-2">
                                    <i class="fas fa-users"></i> Registered
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-users text-purple-600 text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card red p-6 rounded-lg shadow-lg card-hover">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-600 mb-1">Upcoming</p>
                                <p class="text-3xl font-bold text-gray-800">5</p>
                                <p class="text-xs text-red-600 mt-2">
                                    <i class="fas fa-calendar-check"></i> This week
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-calendar-check text-red-600 text-xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions & Events -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <!-- Quick Actions -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-lg shadow-lg p-6 animate-fade-in">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h2>
                            <div class="space-y-3">
                                <a href="/faculty/events/create" class="quick-action-btn block w-full bg-gradient-to-r from-blue-500 to-blue-600 text-white p-4 rounded-lg hover:from-blue-600 hover:to-blue-700 text-center">
                                    <i class="fas fa-plus-circle mr-2"></i>
                                    Create New Event
                                </a>
                                <a href="/faculty/events" class="quick-action-btn block w-full bg-gradient-to-r from-green-500 to-green-600 text-white p-4 rounded-lg hover:from-green-600 hover:to-green-700 text-center">
                                    <i class="fas fa-list mr-2"></i>
                                    Manage Events
                                </a>
                                <a href="/faculty/sports" class="quick-action-btn block w-full bg-gradient-to-r from-purple-500 to-purple-600 text-white p-4 rounded-lg hover:from-purple-600 hover:to-purple-700 text-center">
                                    <i class="fas fa-running mr-2"></i>
                                    Sports Events
                                </a>
                                <a href="/faculty/seminars" class="quick-action-btn block w-full bg-gradient-to-r from-yellow-500 to-yellow-600 text-white p-4 rounded-lg hover:from-yellow-600 hover:to-yellow-700 text-center">
                                    <i class="fas fa-chalkboard-teacher mr-2"></i>
                                    Seminars
                                </a>
                            </div>
                        </div>

                        <!-- Event Categories -->
                        <div class="bg-white rounded-lg shadow-lg p-6 mt-6 animate-fade-in">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Event Categories</h2>
                            <div class="space-y-3">
                                <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                                    <div class="flex items-center">
                                        <i class="fas fa-chalkboard-teacher text-blue-600 mr-3"></i>
                                        <span class="text-sm font-medium">Seminars</span>
                                    </div>
                                    <span class="text-sm text-gray-600">12</span>
                                </div>
                                <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                                    <div class="flex items-center">
                                        <i class="fas fa-tools text-green-600 mr-3"></i>
                                        <span class="text-sm font-medium">Workshops</span>
                                    </div>
                                    <span class="text-sm text-gray-600">8</span>
                                </div>
                                <div class="flex items-center justify-between p-3 bg-purple-50 rounded-lg">
                                    <div class="flex items-center">
                                        <i class="fas fa-music text-purple-600 mr-3"></i>
                                        <span class="text-sm font-medium">Cultural</span>
                                    </div>
                                    <span class="text-sm text-gray-600">15</span>
                                </div>
                                <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">
                                    <div class="flex items-center">
                                        <i class="fas fa-running text-red-600 mr-3"></i>
                                        <span class="text-sm font-medium">Sports</span>
                                    </div>
                                    <span class="text-sm text-gray-600">10</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Events -->
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-lg shadow-lg p-6 animate-fade-in">
                            <div class="flex justify-between items-center mb-6">
                                <h2 class="text-lg font-semibold text-gray-800">Recent Events Created</h2>
                                <a href="/faculty/events" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                    View All <i class="fas fa-arrow-right ml-1"></i>
                                </a>
                            </div>
                            
                            <% if (recentEvents && recentEvents.length > 0) { %>
                                <div class="space-y-4">
                                    <% recentEvents.forEach(event => { %>
                                        <div class="event-card border rounded-lg p-4 hover:shadow-md transition-all">
                                            <div class="flex justify-between items-start">
                                                <div class="flex-1">
                                                    <div class="flex items-center space-x-2 mb-2">
                                                        <h3 class="font-semibold text-gray-800"><%= event.title %></h3>
                                                        <span class="status-badge 
                                                            <% if (event.status === 'approved') { %>bg-green-100 text-green-800<% } else if (event.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } else { %>bg-red-100 text-red-800<% } %>">
                                                            <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                                        </span>
                                                        <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                                            <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                                        </span>
                                                    </div>
                                                    <div class="grid grid-cols-2 gap-4 text-sm text-gray-600">
                                                        <div>
                                                            <i class="fas fa-calendar-alt mr-2 text-gray-400"></i>
                                                            <%= new Date(event.date).toLocaleDateString() %>
                                                        </div>
                                                        <div>
                                                            <i class="fas fa-clock mr-2 text-gray-400"></i>
                                                            <%= event.startTime %> - <%= event.endTime %>
                                                        </div>
                                                        <div>
                                                            <i class="fas fa-map-marker-alt mr-2 text-gray-400"></i>
                                                            <%= event.venue %>
                                                        </div>
                                                        <div>
                                                            <i class="fas fa-users mr-2 text-gray-400"></i>
                                                            <%= event.registrations.length %> / <%= event.maxParticipants || '∞' %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="flex space-x-2 ml-4">
                                                    <button onclick="editEvent('<%= event._id %>')" class="p-2 text-blue-600 hover:bg-blue-50 rounded" title="Edit Event">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button onclick="viewParticipants('<%= event._id %>')" class="p-2 text-green-600 hover:bg-green-50 rounded" title="View Participants">
                                                        <i class="fas fa-users"></i>
                                                    </button>
                                                    <button onclick="markAttendance('<%= event._id %>')" class="p-2 text-purple-600 hover:bg-purple-50 rounded" title="Mark Attendance">
                                                        <i class="fas fa-check-square"></i>
                                                    </button>
                                                    <% if (event.status !== 'approved') { %>
                                                        <button onclick="deleteEvent('<%= event._id %>')" class="p-2 text-red-600 hover:bg-red-50 rounded" title="Delete Event">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-12">
                                    <i class="fas fa-calendar-times text-6xl text-gray-300 mb-4"></i>
                                    <p class="text-gray-500 text-lg">No events created yet</p>
                                    <p class="text-gray-400 text-sm mt-2">Create your first event to get started</p>
                                    <a href="/faculty/events/create" class="inline-block mt-4 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                                        <i class="fas fa-plus mr-2"></i>Create Event
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modals -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">Edit Event</h3>
                <button onclick="closeModal('editModal')" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="editForm">
                <!-- Edit form content will be loaded here -->
            </form>
        </div>
    </div>

    <div id="participantsModal" class="modal">
        <div class="modal-content">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">Event Participants</h3>
                <button onclick="closeModal('participantsModal')" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div id="participantsList">
                <!-- Participants list will be loaded here -->
            </div>
        </div>
    </div>

    <script>
        // Modal functions
        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Event actions
        function editEvent(eventId) {
            // Load event data and open edit modal
            window.location.href = `/faculty/events/${eventId}/edit`;
        }

        function viewParticipants(eventId) {
            // Load participants and open modal
            fetch(`/faculty/events/${eventId}/registrations`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('participantsList').innerHTML = html;
                    openModal('participantsModal');
                });
        }

        function markAttendance(eventId) {
            window.location.href = `/faculty/events/${eventId}/attendance`;
        }

        function deleteEvent(eventId) {
            if (confirm('Are you sure you want to delete this event? This action cannot be undone.')) {
                fetch(`/faculty/events/${eventId}/delete`, { method: 'POST' })
                    .then(response => {
                        if (response.ok) {
                            location.reload();
                        }
                    });
            }
        }

        // Close modals when clicking outside
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }

        // Animate progress bars on page load
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(() => {
                document.querySelectorAll('.progress-bar').forEach(bar => {
                    bar.style.width = bar.style.width;
                });
            }, 500);
        });
    </script>
</body>
</html>
