<%- include('../partials/header') %>

<style>
/* Edit Event Styles */
.edit-event-container {
    background: #f8fafc;
    min-height: 100vh;
}

.form-container {
    background: white;
    border-radius: 1rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    padding: 2rem;
    margin-bottom: 2rem;
}

.form-label {
    font-weight: 600;
    color: #374151;
    margin-bottom: 0.5rem;
}

.form-control, .form-select {
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    transition: all 0.3s ease;
}

.form-control:focus, .form-select:focus {
    border-color: #4f46e5;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    outline: none;
}

.btn-primary {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    border: none;
    padding: 0.75rem 2rem;
    font-weight: 600;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #4338ca, #6d28d9);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(79, 70, 229, 0.3);
}

/* Mobile Responsive Layout */
@media (max-width: 768px) {
    .edit-event-container {
        padding: 0.5rem;
    }
    
    .form-container {
        padding: 1rem;
        border-radius: 0.75rem;
        margin-bottom: 1rem;
    }
    
    main {
        padding: 0.75rem;
        margin: 0;
        overflow-x: hidden;
    }
}

/* Form Mobile Optimization */
@media (max-width: 640px) {
    .form-group {
        margin-bottom: 1.25rem;
    }
    
    .form-label {
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }
    
    .form-control, .form-select {
        width: 100%;
        padding: 0.75rem;
        font-size: 1rem;
        border-radius: 0.5rem;
        border: 2px solid #e5e7eb;
        margin-bottom: 0.5rem;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        outline: none;
    }
    
    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }
    
    .btn-primary, .btn-secondary {
        width: 100%;
        padding: 0.875rem 1rem;
        font-size: 1rem;
        min-height: 3rem;
        margin-bottom: 0.75rem;
        border-radius: 0.5rem;
    }
    
    .btn-secondary {
        background-color: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }
}

/* File Upload Mobile Optimization */
@media (max-width: 640px) {
    input[type="file"] {
        width: 100%;
        padding: 0.75rem;
        font-size: 1rem;
        border-radius: 0.5rem;
        border: 2px dashed #d1d5db;
        background-color: #f9fafb;
    }
    
    input[type="file"]:hover {
        border-color: #4f46e5;
        background-color: #f0f9ff;
    }
}

/* Typography Mobile Optimization */
@media (max-width: 640px) {
    h1 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }
    
    h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }
    
    h3 {
        font-size: 1.125rem;
        margin-bottom: 0.75rem;
    }
    
    .text-2xl {
        font-size: 1.5rem;
    }
    
    .text-lg {
        font-size: 1rem;
    }
}

/* Button Groups Mobile */
@media (max-width: 640px) {
    .flex.gap-4 {
        flex-direction: column;
        gap: 0.75rem;
    }
    
    .flex.justify-end {
        justify-content: stretch;
        flex-direction: column;
    }
    
    .grid.grid-cols-1.md\\:grid-cols-2 {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .grid.grid-cols-1.md\\:grid-cols-3 {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

/* Remove horizontal scrolling */
@media (max-width: 640px) {
    body {
        overflow-x: hidden;
    }
    
    main {
        overflow-x: hidden;
    }
}

.btn-secondary {
    background: #6b7280;
    border: none;
    padding: 0.75rem 2rem;
    font-weight: 600;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
}

.btn-secondary:hover {
    background: #4b5563;
    transform: translateY(-2px);
}

.poster-preview {
    width: 100%;
    max-width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 2px solid #e5e7eb;
}

.poster-upload {
    border: 2px dashed #d1d5db;
    border-radius: 0.5rem;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
}

.poster-upload:hover {
    border-color: #4f46e5;
    background: #f9fafb;
}

.category-section {
    background: #f9fafb;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
}

/* Compact Action Buttons - Match Header Logout Button Style */
.compact-action-btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #0ea5a4;
    color: #0ea5a4;
    transition: all 0.2s ease;
    font-weight: 500;
    white-space: nowrap;
    font-size: 0.75rem;
    cursor: pointer;
}

.compact-action-btn:hover {
    background-color: #0ea5a4;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(14, 165, 164, 0.3);
}

.compact-action-btn:focus {
    background-color: #0ea5a4;
    color: white;
    outline: none;
}

/* Mobile responsiveness for compact buttons */
@media (max-width: 640px) {
    .compact-action-btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
    }
    
    .compact-action-btn i {
        font-size: 0.7rem !important;
    }
    
    .compact-action-btn span {
        font-size: 0.65rem !important;
    }
}

/* Responsive Design */
@media (max-width: 768px) {
    .form-container {
        padding: 1.5rem;
        margin: 0 1rem 2rem;
    }
    
    .btn-primary, .btn-secondary {
        padding: 0.625rem 1.5rem;
        font-size: 0.875rem;
    }
}
</style>

<div class="edit-event-container">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="container mx-auto px-4 py-6">
            <!-- Page Header -->
            <div class="mb-8">
                <!-- Centered Title and Subtitle -->
                <div class="text-center">
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">Edit Event</h1>
                    <p class="text-gray-600">Update your event details</p>
                </div>
            </div>

        <!-- Form Section -->
        <div class="container mx-auto px-4 py-6">
            <!-- Centered Container -->
            <div class="max-w-4xl mx-auto">
                <div class="form-container">
                    <!-- Flash Messages -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                            <div class="flex items-center">
                                <i class="fas fa-exclamation-circle mr-2"></i>
                                <%= error %>
                            </div>
                        </div>
                    <% } %>

                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-2"></i>
                                <%= success %>
                            </div>
                        </div>
                    <% } %>

                    <form action="/faculty/events/<%= event._id %>/edit" method="POST" enctype="multipart/form-data" class="space-y-8">
                        
                        <!-- Basic Information Section -->
                        <div class="space-y-6">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Basic Information</h2>
                            
                            <!-- Event Title - Full Width -->
                            <div>
                                <label for="title" class="block text-sm font-semibold mb-2 text-gray-700">Event Title *</label>
                                <input type="text" 
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                       id="title" 
                                       name="title" 
                                       value="<%= formData.title || event.title %>"
                                       placeholder="Enter event title"
                                       required>
                            </div>

                            <!-- Description - Full Width -->
                            <div>
                                <label for="description" class="block text-sm font-semibold mb-2 text-gray-700">Description *</label>
                                <textarea class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 resize-vertical transition-colors text-black" 
                                          id="description" 
                                          name="description" 
                                          rows="4" 
                                          placeholder="Describe your event"
                                          required><%= formData.description || event.description %></textarea>
                            </div>

                            <!-- Category and Event Type - Two Columns -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label for="category" class="block text-sm font-semibold mb-2 text-gray-700">Category *</label>
                                    <select class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                            id="category" 
                                            name="category" 
                                            required 
                                            onchange="toggleSubCategory()">
                                        <option value="">Select Category</option>
                                        <option value="seminar" <%= (formData.category || event.category) === 'seminar' ? 'selected' : '' %>>Seminars</option>
                                        <option value="workshop" <%= (formData.category || event.category) === 'workshop' ? 'selected' : '' %>>Workshops</option>
                                        <option value="hackathon" <%= (formData.category || event.category) === 'hackathon' ? 'selected' : '' %>>Hackathons</option>
                                        <option value="quiz" <%= (formData.category || event.category) === 'quiz' ? 'selected' : '' %>>Quizzes</option>
                                        <option value="talkshow" <%= (formData.category || event.category) === 'talkshow' ? 'selected' : '' %>>Talk Shows</option>
                                        <option value="bootcamp" <%= (formData.category || event.category) === 'bootcamp' ? 'selected' : '' %>>Bootcamps</option>
                                        <option value="technical" <%= (formData.category || event.category) === 'technical' ? 'selected' : '' %>>Technical</option>
                                        <option value="cultural" <%= (formData.category || event.category) === 'cultural' ? 'selected' : '' %>>Cultural</option>
                                        <option value="sports" <%= (formData.category || event.category) === 'sports' ? 'selected' : '' %>>Sports</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="eventType" class="block text-sm font-semibold mb-2 text-gray-700">Event Type *</label>
                                    <select class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                            id="eventType" 
                                            name="eventType" 
                                            onchange="toggleTeamSize()">
                                        <option value="individual" <%= (formData.eventType || event.eventType) === 'individual' ? 'selected' : '' %>>Individual</option>
                                        <option value="team" <%= (formData.eventType || event.eventType) === 'team' ? 'selected' : '' %>>Team</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Team Size, Max Participants, and Max Teams per Department - Three Columns -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div id="teamSizeField" style="display: none;">
                                    <label for="teamSize" class="block text-sm font-semibold mb-2 text-gray-700">Team Size *</label>
                                    <input type="number" 
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                           id="teamSize" 
                                           name="teamSize" 
                                           value="<%= formData.teamSize || event.teamSize %>"
                                           min="2"
                                           placeholder="Number of team members">
                                </div>
                                
                                <div id="maxTeamsPerDeptField" style="display: none;">
                                <label for="maxTeamsPerDepartment" class="block text-sm font-semibold mb-2 text-gray-700">
                                    Maximum Teams per Department
                                    <span class="text-xs font-normal text-gray-500 ml-1">(Optional - Leave empty for unlimited)</span>
                                </label>
                                <input type="number"
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black"
                                       id="maxTeamsPerDepartment"
                                       name="maxTeamsPerDepartment"
                                       value="<%= formData.maxTeamsPerDepartment || event.maxTeamsPerDepartment %>"
                                       min="1"
                                       max="50"
                                       placeholder="e.g., 2 (only 2 teams allowed per department)">
                                <p class="text-xs text-gray-500 mt-1">Leave empty to allow unlimited teams from any department</p>
                            </div>
                            <div>
                                <label for="maxParticipants" class="block text-sm font-semibold mb-2 text-gray-700">Max Participants</label>
                                <input type="number" 
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                       id="maxParticipants" 
                                       name="maxParticipants" 
                                       value="<%= formData.maxParticipants || event.maxParticipants %>"

                                       min="1"
                                       placeholder="Leave empty for unlimited">
                            </div>
                            <div id="eventFormatField" style="display: none;">
                                <label for="eventFormat" class="block text-sm font-semibold mb-2 text-gray-700">
                                    Event Format *
                                    <span class="text-xs font-normal text-gray-500 ml-1">(For team events only)</span>
                                </label>
                                <select id="eventFormat" name="eventFormat"
                                        class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black">
                                    <option value="">Select format</option>
                                    <option value="knockout" <%= (formData.eventFormat || event.eventFormat) === 'knockout' ? 'selected' : '' %>>Knockout (Match-based)</option>
                                    <option value="ranking" <%= (formData.eventFormat || event.eventFormat) === 'ranking' ? 'selected' : '' %>>Ranking (Multiple teams compete)</option>
                                </select>
                                <p class="text-xs text-gray-500 mt-1">Knockout: Teams compete in matches | Ranking: Final positions assigned</p>
                            </div>
                        </div>

                        <!-- Subcategory Section (for Sports) -->
                        <div class="space-y-6" id="subCategoryField" style="display: none;">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Sports Subcategory</h2>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- <div>
                                    <label for="subCategory" class="block text-sm font-semibold mb-2 text-gray-700">Subcategory</label>
                                    <select class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors" 
                                            id="subCategory" 
                                            name="subCategory">
                                        <option value="">Select Subcategory</option>
                                        <option value="cricket" <%= (formData.subCategory || event.subCategory) === 'cricket' ? 'selected' : '' %>>Cricket</option>
                                        <option value="football" <%= (formData.subCategory || event.subCategory) === 'football' ? 'selected' : '' %>>Football</option>
                                        <option value="basketball" <%= (formData.subCategory || event.subCategory) === 'basketball' ? 'selected' : '' %>>Basketball</option>
                                        <option value="volleyball" <%= (formData.subCategory || event.subCategory) === 'volleyball' ? 'selected' : '' %>>Volleyball</option>
                                        <option value="badminton" <%= (formData.subCategory || event.subCategory) === 'badminton' ? 'selected' : '' %>>Badminton</option>
                                        <option value="table-tennis" <%= (formData.subCategory || event.subCategory) === 'table-tennis' ? 'selected' : '' %>>Table Tennis</option>
                                        <option value="athletics" <%= (formData.subCategory || event.subCategory) === 'athletics' ? 'selected' : '' %>>Athletics</option>
                                        <option value="chess" <%= (formData.subCategory || event.subCategory) === 'chess' ? 'selected' : '' %>>Chess</option>
                                    </select>
                                </div> -->
                            </div>
                        </div>

                        <!-- Event Schedule Section -->
                        <div class="space-y-6">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Event Schedule</h2>
                            
                            <!-- Date and Time - Three Columns -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div>
                                    <label for="date" class="block text-sm font-semibold mb-2 text-gray-700">Date *</label>
                                    <input type="date" 
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                           id="date" 
                                           name="date" 
                                           value="<% if (formData.date) { %><%= new Date(formData.date).toISOString().split('T')[0] %><% } else { %><%= new Date(event.date).toISOString().split('T')[0] %><% } %>"
                                           required>
                                </div>
                                
                                <div>
                                    <label for="startTime" class="block text-sm font-semibold mb-2 text-gray-700">Start Time *</label>
                                    <input type="time" 
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                           id="startTime" 
                                           name="startTime" 
                                           value="<%= formData.startTime || event.startTime %>"
                                           required>
                                </div>
                                
                                <div>
                                    <label for="endTime" class="block text-sm font-semibold mb-2 text-gray-700">End Time *</label>
                                    <input type="time" 
                                           class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                           id="endTime" 
                                           name="endTime" 
                                           value="<%= formData.endTime || event.endTime %>"
                                           required>
                                </div>
                            </div>

                            <!-- Venue - Full Width -->
                            <div>
                                <label for="venue" class="block text-sm font-semibold mb-2 text-gray-700">Venue *</label>
                                <input type="text" 
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors text-black" 
                                       id="venue" 
                                       name="venue" 
                                       value="<%= formData.venue || event.venue %>"
                                       placeholder="Enter venue location"
                                       required>
                            </div>
                        </div>

                        <!-- Event Media Section -->
                        <div class="space-y-6">
                            <h2 class="text-lg font-semibold text-gray-800 pb-2 border-b border-gray-200">Event Media</h2>
                            
                            <!-- Current Poster Display -->
                            <% if (event.poster && event.poster.trim() !== '') { %>
                                <div>
                                    <label class="block text-sm font-semibold mb-2 text-gray-700">Current Poster</label>
                                    <div class="border-2 border-gray-200 rounded-lg p-4 bg-gray-50 inline-block">
                                        <img src="<%= event.poster %>" 
                                             alt="Current Event Poster" 
                                             class="w-32 h-32 object-cover rounded-lg shadow-md">
                                        <p class="text-sm text-gray-500 text-center mt-2">Current event poster</p>
                                    </div>
                                </div>
                            <% } else { %>
                                <div>
                                    <label class="block text-sm font-semibold mb-2 text-gray-700">Current Poster</label>
                                    <div class="border-2 border-gray-200 rounded-lg p-8 bg-gray-50 inline-block">
                                        <div class="text-center">
                                            <div class="w-32 h-32 bg-gradient-to-br from-blue-400 to-purple-600 rounded-lg flex items-center justify-center mb-3">
                                                <i class="fas fa-calendar-alt text-white text-3xl"></i>
                                            </div>
                                            <p class="text-gray-500">No poster uploaded yet</p>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                            
                            <!-- Poster Upload -->
                            <div>
                                <label for="poster" class="block text-sm font-semibold mb-2 text-gray-700">Update Poster (Optional)</label>
                                <input type="file" 
                                       class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 hover:border-blue-400 transition-colors" 
                                       id="poster" 
                                       name="poster" 
                                       accept="image/*">
                                <p class="text-sm text-gray-500 mt-1">Leave empty to keep current poster</p>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                            <a href="/faculty/events" class="compact-action-btn">
                                <i class="fas fa-times text-sm"></i>
                                <span class="text-xs">Cancel</span>
                            </a>
                            <button type="submit" class="compact-action-btn">
                                <i class="fas fa-save text-sm"></i>
                                <span class="text-xs">Update Event</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
// Show/hide team fields based on event type
function toggleTeamSize() {
    const eventType = document.getElementById('eventType').value;
    const teamSizeField = document.getElementById('teamSizeField');
    const maxTeamsPerDeptField = document.getElementById('maxTeamsPerDeptField');
    const eventFormatField = document.getElementById('eventFormatField');

    if (eventType === 'team') {
        teamSizeField.style.display = 'block';
        maxTeamsPerDeptField.style.display = 'block';
        if (eventFormatField) eventFormatField.style.display = 'block';
    } else {
        teamSizeField.style.display = 'none';
        maxTeamsPerDeptField.style.display = 'none';
        if (eventFormatField) eventFormatField.style.display = 'none';
    }
}

// Show/hide subcategory field based on category
function toggleSubCategory() {
    const category = document.getElementById('category').value;
    const subCategoryField = document.getElementById('subCategoryField');
    
    if (category === 'sports') {
        subCategoryField.style.display = 'block';
    } else {
        subCategoryField.style.display = 'none';
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    toggleTeamSize();
    toggleSubCategory();
});
</script>

<%- include('../partials/footer') %>
