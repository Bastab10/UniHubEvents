<%- include('../partials/header') %>

<style>
/* Mobile Responsive Layout for Student Details - Specific to page content only */
@media (max-width: 768px) {
    main .flex.min-h-screen.bg-gray-50 {
        padding: 0.5rem;
    }
    
    main {
        padding: 0.75rem;
        margin: 0;
        overflow-x: hidden;
    }
    
    main .bg-white.rounded-xl.shadow-lg.p-6 {
        padding: 1rem;
        border-radius: 0.75rem;
        margin-bottom: 1rem;
    }
    
    main .bg-white.rounded-xl.shadow-xl.p-8 {
        padding: 1rem;
        border-radius: 0.75rem;
    }
    
    main .grid.grid-cols-1.md\:grid-cols-2 {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

/* Mobile Profile Section - Specific to page content only */
@media (max-width: 640px) {
    main .flex.items-center.mb-8 {
        flex-direction: column;
        text-align: center;
        margin-bottom: 1.5rem;
    }
    
    main .w-20.h-20 {
        width: 80px;
        height: 80px;
        margin-bottom: 1rem;
        margin-right: 0;
    }
    
    main .flex.flex-col.md\:flex-row.justify-between.items-start.md\:items-center {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }
    
    main .flex.items-center {
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 1rem;
    }
    
    main .text-sm.font-medium.text-gray-500.w-32 {
        width: 100%;
        margin-bottom: 0.25rem;
        font-weight: 600;
    }
    
    main .text-sm.text-gray-900 {
        width: 100%;
        word-break: break-word;
    }
}

/* Mobile Typography - Specific to page content only */
@media (max-width: 640px) {
    main h1 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
    
    main h2 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }
    
    main h3 {
        font-size: 1.125rem;
        margin-bottom: 0.75rem;
    }
    
    main .text-2xl {
        font-size: 1.5rem;
    }
    
    main .text-xl {
        font-size: 1.125rem;
    }
}

/* Mobile Buttons - Specific to page content only */
@media (max-width: 640px) {
    main .bg-gray-600.text-white.px-6.py-3 {
        width: 100%;
        padding: 0.875rem 1rem;
        text-align: center;
        justify-content: center;
        margin-bottom: 0.5rem;
    }
    
    main .bg-blue-600.text-white.px-6.py-2 {
        width: 100%;
        padding: 0.875rem 1rem;
        text-align: center;
        justify-content: center;
    }
}

/* Mobile Spacing - Specific to page content only */
@media (max-width: 640px) {
    main .space-y-6 > * + * {
        margin-top: 1rem;
    }
    
    main .space-y-4 > * + * {
        margin-top: 0.75rem;
    }
    
    main .mb-8 {
        margin-bottom: 1.5rem;
    }
    
    main .mb-6 {
        margin-bottom: 1rem;
    }
    
    main .mb-4 {
        margin-bottom: 0.75rem;
    }
}

/* Remove horizontal scrolling - Specific to page content only */
@media (max-width: 640px) {
    body {
        overflow-x: hidden;
    }
    
    main {
        overflow-x: hidden;
    }
}
</style>

<div class="flex min-h-screen bg-gray-50">
    <%- include('../partials/sidebar') %>
    
    <main class="flex-1">
        <div class="p-6">
            <!-- Centered Container -->
            <div class="max-w-4xl mx-auto">
                <!-- Page Header -->
                <div class="bg-white rounded-xl shadow-lg p-6 mb-6 border-l-4 border-blue-500">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Student Details</h1>
                            <p class="text-gray-600 mt-2">View detailed student information</p>
                        </div>
                        <!-- <div class="mt-4 md:mt-0">
                            <a href="javascript:history.back()" class="bg-gray-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-gray-700 transition-colors shadow-lg">
                                <i class="fas fa-arrow-left mr-2"></i>Back
                            </a>
                        </div> -->
                    </div>
                </div>

                <!-- Student Details Card -->
                <div class="bg-white rounded-xl shadow-xl p-8 border border-gray-200">
                    <% if (student) { %>
                        <!-- Student Profile -->
                        <div class="mb-8">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800">
                                    <%= student.profile.fullName || 
                                       (student.profile.firstName && student.profile.lastName ? 
                                        student.profile.firstName + ' ' + student.profile.lastName : 
                                        student.profile.firstName || student.profile.lastName || 'N/A') %>
                                </h2>
                                <p class="text-gray-600"><%= student.email || 'N/A' %></p>
                            </div>
                        </div>

                        <!-- Information Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <!-- Personal Information -->
                            <div class="space-y-6">
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Personal Information</h3>
                                
                                <div class="space-y-4">
                                    <div class="flex items-center">
                                        <span class="text-sm font-medium text-gray-500 w-32">Full Name:</span>
                                        <span class="text-sm text-gray-900">
                                            <%= student.profile.fullName || 
                                               (student.profile.firstName && student.profile.lastName ? 
                                                student.profile.firstName + ' ' + student.profile.lastName : 
                                                student.profile.firstName || student.profile.lastName || 'N/A') %>
                                        </span>
                                    </div>
                                    
                                    <div class="flex items-center">
                                        <span class="text-sm font-medium text-gray-500 w-32">Email:</span>
                                        <span class="text-sm text-gray-900"><%= student.email || 'N/A' %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Academic Information -->
                            <div class="space-y-6">
                                <h3 class="text-lg font-semibold text-gray-800 mb-4">Academic Information</h3>
                                
                                <div class="space-y-4">
                                    <div class="flex items-center">
                                        <span class="text-sm font-medium text-gray-500 w-32">Student ID:</span>
                                        <span class="text-sm text-gray-900"><%= student.profile.collegeId || 'N/A' %></span>
                                    </div>
                                    
                                    <div class="flex items-center">
                                        <span class="text-sm font-medium text-gray-500 w-32">Department:</span>
                                        <span class="text-sm text-gray-900"><%= student.profile.department || 'Not specified' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Student Not Found -->
                        <div class="text-center py-12">
                            <i class="fas fa-user-slash text-gray-400 text-6xl mb-4"></i>
                            <h3 class="text-xl font-semibold text-gray-600 mb-2">Student Not Found</h3>
                            <p class="text-gray-500 mb-6">The requested student could not be found in the system.</p>
                            <a href="javascript:history.back()" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition-colors">
                                <i class="fas fa-arrow-left mr-2"></i>Go Back
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
