<%- include('../partials/header') %>

<%- include('../partials/sidebar') %>

<style>
/* Force white background for Faculty Dashboard on all devices */
main {
    background-color: #ffffff !important;
}

/* Override dark mode styles for Faculty Dashboard */
@media (prefers-color-scheme: dark) {
    main {
        background-color: #ffffff !important;
    }
}

/* Mobile-specific override */
@media (max-width: 768px) {
    main {
        background-color: #ffffff !important;
    }
}

/* Ensure all content areas are white */
.bg-gray-50 {
    background-color: #ffffff !important;
}

@media (max-width: 768px) {
    .bg-gray-50 {
        background-color: #ffffff !important;
    }
}
</style>

<main class="flex-1">
    <!-- Faculty Dashboard Title -->
    <h1 class="text-2xl font-bold text-gray-800 mb-2">Faculty Dashboard</h1>
    <p class="text-gray-700 sm:text-gray-600 mb-8">Welcome back, <%= currentUser.profile.firstName %>! Manage your events and track participation.</p>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-blue-100 rounded-full">
                    <i class="fas fa-calendar text-blue-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Total Events</p>
                    <p class="text-2xl font-bold text-gray-800"><%= stats.totalEvents %></p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-green-100 rounded-full">
                    <i class="fas fa-users text-green-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Total Registrations</p>
                    <p class="text-2xl font-bold text-gray-800"><%= stats.totalRegistrations %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- My Events Section -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">My Events</h2>
        <a href="/faculty/events/create" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            <i class="fas fa-plus mr-2"></i>Create Event
        </a>
    </div>
    
    <% if (allEvents && allEvents.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <% allEvents.forEach(event => { %>
                <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
                    <!-- Event Image -->
                    <div class="h-48 bg-gradient-to-br from-blue-400 to-purple-600 relative overflow-hidden">
                        <% if (event.poster) { %>
                            <img src="<%= event.poster %>" alt="<%= event.title %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center">
                                <i class="fas fa-calendar-alt text-white text-4xl"></i>
                            </div>
                        <% } %>
                        
                        <!-- Category Badge -->
                        <div class="absolute top-3 right-3">
                            <span class="px-3 py-1 text-xs font-semibold rounded-full 
                                <% if (event.category === 'seminar') { %>bg-blue-100 text-blue-800<% } 
                                   else if (event.category === 'workshop') { %>bg-green-100 text-green-800<% } 
                                   else if (event.category === 'cultural') { %>bg-purple-100 text-purple-800<% } 
                                   else if (event.category === 'technical') { %>bg-yellow-100 text-yellow-800<% } 
                                   else { %>bg-gray-100 text-gray-800<% } %>">
                                <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                            </span>
                        </div>
                    </div>
                    
                    <!-- Event Content -->
                    <div class="p-5">
                        <!-- Event Title -->
                        <h3 class="text-xl font-bold text-gray-800 mb-3 truncate"><%= event.title %></h3>
                        
                        <!-- Event Details -->
                        <div class="space-y-2 mb-4">
                            <!-- Date and Time -->
                            <div class="flex items-center text-gray-600">
                                <i class="fas fa-calendar-alt w-5 text-blue-500"></i>
                                <span class="text-sm ml-2"><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                <i class="fas fa-clock w-5 text-green-500 ml-3"></i>
                                <span class="text-sm ml-2"><%= event.startTime %> - <%= event.endTime %></span>
                            </div>
                            
                            <!-- Venue -->
                            <div class="flex items-center text-gray-600">
                                <i class="fas fa-map-marker-alt w-5 text-red-500"></i>
                                <span class="text-sm ml-2 truncate"><%= event.venue %></span>
                            </div>
                            
                            <!-- Organizer -->
                            <div class="flex items-center text-gray-600">
                                <i class="fas fa-user w-5 text-purple-500"></i>
                                <span class="text-sm ml-2">
                                    <%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %>
                                </span>
                            </div>
                            
                            <!-- Event Type and Registrations -->
                            <div class="flex items-center justify-between text-gray-600">
                                <div class="flex items-center">
                                    <i class="fas fa-tag w-5 text-orange-500"></i>
                                    <span class="text-sm ml-2">
                                        <%= event.eventType === 'team' ? 'Team Event' : 'Individual Event' %>
                                    </span>
                                </div>
                                <div class="flex items-center">
                                    <i class="fas fa-users w-5 text-indigo-500"></i>
                                    <span class="text-sm ml-2">
                                        <%= event.registrations ? event.registrations.length : 0 %> registered
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="flex gap-2">
                            <a href="/faculty/events/<%= event._id %>" class="flex-1 bg-blue-50 text-blue-600 px-3 py-2 rounded-lg text-center hover:bg-blue-100 transition-colors text-sm font-medium">
                                <i class="fas fa-eye mr-1"></i>View
                            </a>
                            <a href="/faculty/events/<%= event._id %>/edit" class="flex-1 bg-green-50 text-green-600 px-3 py-2 rounded-lg text-center hover:bg-green-100 transition-colors text-sm font-medium">
                                <i class="fas fa-edit mr-1"></i>Edit
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- No Events State -->
        <div class="text-center py-12 bg-white rounded-xl shadow-lg mb-8">
            <i class="fas fa-calendar-plus text-gray-400 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">No Events Created Yet</h3>
            <p class="text-gray-500 mb-6">Start by creating your first event to engage with students</p>
            <a href="/faculty/events/create" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors inline-block">
                <i class="fas fa-plus mr-2"></i>Create Your First Event
            </a>
        </div>
    <% } %>

    <!-- Quick Actions Section -->
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/faculty/events/create" class="flex flex-col items-center p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition">
            <i class="fas fa-plus-circle text-blue-600 text-2xl mb-2"></i>
            <span class="text-sm font-medium text-gray-700">Create Event</span>
        </a>
        <a href="/faculty/events" class="flex flex-col items-center p-4 bg-green-50 rounded-lg hover:bg-green-100 transition">
            <i class="fas fa-list text-green-600 text-2xl mb-2"></i>
            <span class="text-sm font-medium text-gray-700">My Events</span>
        </a>
        <a href="#" class="flex flex-col items-center p-4 bg-purple-50 rounded-lg hover:bg-purple-100 transition">
            <i class="fas fa-chart-line text-purple-600 text-2xl mb-2"></i>
            <span class="text-sm font-medium text-gray-700">Analytics</span>
        </a>
        <a href="#" class="flex flex-col items-center p-4 bg-yellow-50 rounded-lg hover:bg-yellow-100 transition">
            <i class="fas fa-bell text-yellow-600 text-2xl mb-2"></i>
            <span class="text-sm font-medium text-gray-700">Notifications</span>
        </a>
    </div>
</main>

<%- include('../partials/footer') %>
