<%- include('../partials/header') %>

<%- include('../partials/sidebar') %>

<link rel="stylesheet" href="/css/dashboard.css">

<style>
/* Force white background for Coordinator Dashboard on all devices */
main {
    background-color: #ffffff !important;
    padding: 1rem;
    width: 100%;
    max-width: 100%;
    margin: 0;
}

/* Override dark mode styles for Coordinator Dashboard */
@media (prefers-color-scheme: dark) {
    main {
        background-color: #ffffff !important;
    }
}

/* Mobile-specific override */
@media (max-width: 768px) {
    main {
        background-color: #ffffff !important;
        padding: 0.75rem;
        margin-left: 0 !important;
        margin-right: 0 !important;
        width: 100vw;
        max-width: 100vw;
        overflow-x: hidden;
    }
}

/* Ensure all content areas are white */
.bg-gray-50 {
    background-color: #ffffff !important;
}

@media (max-width: 768px) {
    .bg-gray-50 {
        background-color: #ffffff !important;
    }
}

/* Compact Action Buttons - Match Header Logout Button Style */
.compact-action-btn {
    text-decoration: none;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid #0ea5a4;
    color: #0ea5a4;
    transition: all 0.2s ease;
    font-weight: 500;
    white-space: nowrap;
    font-size: 0.8125rem;
    min-height: 2.5rem;
    justify-content: center;
}

.compact-action-btn:hover {
    background-color: #0ea5a4;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(14, 165, 164, 0.3);
}

.compact-action-btn:focus {
    background-color: #0ea5a4;
    color: white;
    outline: none;
}

/* Mobile responsiveness for compact buttons */
@media (max-width: 640px) {
    .compact-action-btn {
        padding: 0.625rem 0.75rem;
        font-size: 0.75rem;
        min-height: 2.75rem;
        width: 100%;
        margin-bottom: 0.5rem;
    }
    
    .compact-action-btn i {
        font-size: 0.875rem !important;
    }
    
    .compact-action-btn span {
        font-size: 0.75rem !important;
    }
    
    /* Button groups on mobile */
    .flex.gap-2.justify-end {
        flex-direction: column;
        gap: 0.5rem !important;
    }
    
    .flex.gap-3 {
        flex-direction: column;
        gap: 0.75rem !important;
    }
}

/* Stats Cards Mobile Optimization */
@media (max-width: 640px) {
    .grid.grid-cols-1.md\\:grid-cols-2 {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .bg-white.rounded-lg.shadow-md.p-6 {
        padding: 1.25rem;
    }
    
    .text-2xl.font-bold {
        font-size: 1.5rem;
    }
}

/* Events Grid Mobile Optimization */
@media (max-width: 640px) {
    .events-grid {
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
        padding: 0;
    }
}

/* Typography Mobile Optimization */
@media (max-width: 640px) {
    h1 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
    
    .text-gray-700 {
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
    }
    
    h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }
}

/* Remove horizontal scrolling */
@media (max-width: 640px) {
    body {
        overflow-x: hidden;
    }
    
    main {
        overflow-x: hidden;
    }
}
</style>

<main class="flex-1">
    <!-- Coordinator Dashboard Title -->
    <h1 class="text-2xl font-bold text-gray-800 mb-2">Coordinator Dashboard</h1>
    <p class="text-gray-700 sm:text-gray-600 mb-8">Welcome back, <%= currentUser.profile.fullName %>! Manage your events and track participation.</p>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-blue-100 rounded-full">
                    <i class="fas fa-calendar text-blue-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Total Events</p>
                    <p class="text-2xl font-bold text-gray-800"><%= stats.totalEvents %></p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 bg-green-100 rounded-full">
                    <i class="fas fa-users text-green-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-500">Total Registrations</p>
                    <p class="text-2xl font-bold text-gray-800"><%= stats.totalRegistrations %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- My Events Section -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">My Events</h2>
        <a href="/faculty/events/create" class="compact-action-btn">
            <i class="fas fa-plus text-sm"></i>
            <span class="text-xs">Create Event</span>
        </a>
    </div>
    
    <% if (allEvents && allEvents.length > 0) { %>
        <div class="events-grid">
            <% allEvents.forEach(event => { %>
                <div class="event-card group" data-category="<%= event.category || 'other' %>">
                    <!-- Event Image -->
                    <div class="event-image">
                        <% if (event.poster && event.poster.trim() !== '') { %>
                            <img src="/images/<%= event.poster %>" 
                                 alt="<%= event.title %>" 
                                 class="w-full h-full object-cover"
                                 style="object-fit: cover;">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-100 to-purple-100">
                                <div class="text-center">
                                    <i class="fas fa-calendar-alt text-4xl text-blue-600 mb-2"></i>
                                    <p class="text-blue-600 text-sm">No poster uploaded</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    
                    <!-- Event Content -->
                    <div class="event-content">
                        <!-- Title and Category Badge -->
                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
                            <h3 class="event-title mb-2 sm:mb-0 sm:mr-2">
                                <%= event.title %>
                            </h3>
                            <% if (event.category) { %>
                                <span class="category-badge ml-0 sm:ml-2 flex-shrink-0
                                    <% if (event.category === 'sports') { %>
                                        bg-green-100 text-green-800
                                    <% } else if (event.category === 'workshop') { %>
                                        bg-blue-100 text-blue-800
                                    <% } else if (event.category === 'cultural') { %>
                                        bg-purple-100 text-purple-800
                                    <% } else if (event.category === 'seminar') { %>
                                        bg-yellow-100 text-yellow-800
                                    <% } else { %>
                                        bg-gray-100 text-gray-800
                                    <% } %>
                                ">
                                    <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                </span>
                            <% } %>
                        </div>
                        
                        <!-- Description -->
                        <p class="event-description mb-3">
                            <%= event.description || 'No description available' %>
                        </p>
                        
                        <!-- Event Details -->
                        <div class="event-details mb-4">
                            <div class="flex items-center">
                                <i class="fas fa-calendar mr-2 text-gray-400"></i>
                                <span><%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-clock mr-2 text-gray-400"></i>
                                <span><%= event.startTime %> - <%= event.endTime %></span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-map-marker-alt mr-2 text-gray-400"></i>
                                <span><%= event.venue %></span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-user mr-2 text-gray-400"></i>
                                <span><%= event.organizer.profile.firstName %> <%= event.organizer.profile.lastName %></span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-users mr-2 text-gray-400"></i>
                                <span><%= event.registrations ? event.registrations.length : 0 %> / <%= event.maxParticipants || 'Unlimited' %> registered</span>
                            </div>
                        </div>
                        
                        <!-- View and Edit Buttons -->
                        <div class="flex gap-2 justify-end">
                            <a href="/faculty/events/<%= event._id %>" class="compact-action-btn">
                                <i class="fas fa-eye text-sm"></i>
                                <span class="text-xs">View</span>
                            </a>
                            <a href="/faculty/events/<%= event._id %>/edit" class="compact-action-btn">
                                <i class="fas fa-edit text-sm"></i>
                                <span class="text-xs">Edit</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- No Events State -->
        <div class="text-center py-12 bg-white rounded-xl shadow-lg mb-8">
            <i class="fas fa-calendar-plus text-gray-400 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">No Events Created Yet</h3>
            <p class="text-gray-500 mb-6">Start by creating your first event to engage with students</p>
            <a href="/faculty/events/create" class="compact-action-btn">
                <i class="fas fa-plus text-sm"></i>
                <span class="text-xs">Create Your First Event</span>
            </a>
        </div>
    <% } %>

    <!-- Quick Actions Section -->
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h2>
    <div class="flex flex-wrap gap-3">
        <a href="/faculty/events/create" class="compact-action-btn">
            <i class="fas fa-plus text-sm"></i>
            <span class="text-xs">Create Event</span>
        </a>
        <a href="#" class="compact-action-btn">
            <i class="fas fa-chart-line text-sm"></i>
            <span class="text-xs">Analytics</span>
        </a>
        <a href="#" class="compact-action-btn">
            <i class="fas fa-bell text-sm"></i>
            <span class="text-xs">Notifications</span>
        </a>
    </div>
</main>

<%- include('../partials/footer') %>
