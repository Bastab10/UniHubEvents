<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Panel - Event Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .animate-slide-in {
            animation: slideIn 0.6s ease-out forwards;
        }
        
        .animate-fade-in {
            animation: fadeIn 0.8s ease-out forwards;
        }
        
        .card-hover {
            transition: all 0.3s ease;
        }
        
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .sidebar {
            background: linear-gradient(180deg, #1e3c72 0%, #2a5298 100%);
        }
        
        .stat-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border-left: 4px solid;
            transition: all 0.3s ease;
        }
        
        .stat-card.blue { border-left-color: #3b82f6; }
        .stat-card.green { border-left-color: #10b981; }
        .stat-card.yellow { border-left-color: #f59e0b; }
        .stat-card.purple { border-left-color: #8b5cf6; }
        .stat-card.red { border-left-color: #ef4444; }
        
        .quick-action-btn {
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .quick-action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }
        
        .quick-action-btn:hover::before {
            left: 100%;
        }
        
        .event-card {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }
        
        .event-card:hover {
            border-left-color: #3b82f6;
        }
        
        .notification-badge {
            animation: pulse 2s infinite;
        }
        
        .progress-bar {
            transition: width 1s ease-out;
        }
        
        .table-hover:hover {
            background-color: #f9fafb;
        }
        
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-weight: 500;
        }
        
        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .card-shadow {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        
        .hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .hover-lift:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside class="sidebar w-64 text-white flex flex-col">
            <div class="p-6 border-b border-blue-700">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                        <i class="fas fa-graduation-cap text-blue-600"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold">Faculty Panel</h2>
                        <p class="text-xs text-blue-200">Event Management</p>
                    </div>
                </div>
            </div>
            
            <nav class="flex-1 p-4">
                <ul class="space-y-2">
                    <li>
                        <a href="/faculty/dashboard" class="flex items-center space-x-3 p-3 rounded-lg bg-white/10 hover:bg-white/20 transition">
                            <i class="fas fa-tachometer-alt w-5"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/analytics" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-plus-circle w-5"></i>
                            <span>Create Event</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/events/create" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-plus-circle w-5"></i>
                            <span>Create Event</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/events" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-calendar w-5"></i>
                            <span>My Events</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/participants" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-users w-5"></i>
                            <span>Participants</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/sports" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-running w-5"></i>
                            <span>Sports</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/seminars" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-chalkboard-teacher w-5"></i>
                            <span>Seminars</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/reports" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-file-alt w-5"></i>
                            <span>Reports</span>
                        </a>
                    </li>
                    <li>
                        <a href="/faculty/analytics" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600 transition">
                            <i class="fas fa-chart-bar w-5"></i>
                            <span>Analytics</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto">
            <!-- Header -->
            <header class="header-gradient text-white shadow-lg">
                <div class="px-6 py-6">
                    <div class="flex justify-between items-center">
                        <div>
                            <h1 class="text-3xl font-bold mb-2">Event Management</h1>
                            <p class="text-blue-100">Create and manage institutional events</p>
                        </div>
                        <div class="flex items-center space-x-4">
                            <button class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg transition">
                                <i class="fas fa-bell mr-2"></i>
                                <span class="relative">
                                    Notifications
                                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full notification-badge"></span>
                                </span>
                            </button>
                            <button class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg transition">
                                <i class="fas fa-cog mr-2"></i>
                                Settings
                            </button>
                            <a href="/auth/logout" class="bg-red-500/80 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition">
                                <i class="fas fa-sign-out-alt mr-2"></i>
                                Logout
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="p-6">
                <!-- Quick Actions -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 animate-slide-in">
                    <a href="/faculty/events/create" class="quick-action-btn bg-gradient-to-r from-blue-500 to-blue-600 text-white p-6 rounded-xl text-center hover:from-blue-600 hover:to-blue-700 hover-lift">
                        <i class="fas fa-plus-circle text-3xl mb-3"></i>
                        <h3 class="text-lg font-bold">Create Event</h3>
                        <p class="text-sm opacity-90">Add new institutional event</p>
                    </a>
                    
                    <a href="/faculty/events" class="quick-action-btn bg-gradient-to-r from-green-500 to-green-600 text-white p-6 rounded-xl text-center hover:from-green-600 hover:to-green-700 hover-lift">
                        <i class="fas fa-calendar text-3xl mb-3"></i>
                        <h3 class="text-lg font-bold">Manage Events</h3>
                        <p class="text-sm opacity-90">View and edit your events</p>
                    </a>
                    
                    <a href="/faculty/participants" class="quick-action-btn bg-gradient-to-r from-purple-500 to-purple-600 text-white p-6 rounded-xl text-center hover:from-purple-600 hover:to-purple-700 hover-lift">
                        <i class="fas fa-users text-3xl mb-3"></i>
                        <h3 class="text-lg font-bold">Participants</h3>
                        <p class="text-sm opacity-90">Manage event participants</p>
                    </a>
                    
                    <a href="/faculty/reports" class="quick-action-btn bg-gradient-to-r from-yellow-500 to-yellow-600 text-white p-6 rounded-xl text-center hover:from-yellow-600 hover:to-yellow-700 hover-lift">
                        <i class="fas fa-file-alt text-3xl mb-3"></i>
                        <h3 class="text-lg font-bold">Reports</h3>
                        <p class="text-sm opacity-90">Generate event reports</p>
                    </a>
                </div>

                <!-- Event Categories -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 animate-fade-in">
                    <div class="stat-card blue p-6 rounded-xl card-shadow hover-lift">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-chalkboard-teacher text-blue-600 text-xl"></i>
                            </div>
                            <h3 class="text-lg font-semibold text-gray-800">Seminars</h3>
                        </div>
                        <a href="/faculty/events/create?category=seminar" class="block text-center text-blue-600 hover:text-blue-800 font-medium">
                            Create Seminar <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                    
                    <div class="stat-card green p-6 rounded-xl card-shadow hover-lift">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-tools text-green-600 text-xl"></i>
                            </div>
                            <h3 class="text-lg font-semibold text-gray-800">Workshops</h3>
                        </div>
                        <a href="/faculty/events/create?category=workshop" class="block text-center text-green-600 hover:text-green-800 font-medium">
                            Create Workshop <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                    
                    <div class="stat-card purple p-6 rounded-xl card-shadow hover-lift">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-music text-purple-600 text-xl"></i>
                            </div>
                            <h3 class="text-lg font-semibold text-gray-800">Cultural</h3>
                        </div>
                        <a href="/faculty/events/create?category=cultural" class="block text-center text-purple-600 hover:text-purple-800 font-medium">
                            Create Cultural Event <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                    
                    <div class="stat-card red p-6 rounded-xl card-shadow hover-lift">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-running text-red-600 text-xl"></i>
                            </div>
                            <h3 class="text-lg font-semibold text-gray-800">Sports</h3>
                        </div>
                        <a href="/faculty/events/create?category=sports" class="block text-center text-red-600 hover:text-red-800 font-medium">
                            Create Sports Event <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                </div>

                <!-- Recent Events -->
                <div class="bg-white p-6 rounded-xl card-shadow animate-fade-in">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-gray-800">Your Recent Events</h2>
                        <a href="/faculty/events" class="text-blue-600 hover:text-blue-800 font-medium">
                            View All Events <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                    
                    <% if (recentEvents && recentEvents.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% recentEvents.slice(0, 6).forEach(event => { %>
                                <div class="event-card border rounded-lg p-5 hover:shadow-lg">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="flex-1">
                                            <h3 class="font-semibold text-gray-800 text-lg mb-2"><%= event.title %></h3>
                                            <div class="flex items-center space-x-2 mb-3">
                                                <span class="status-badge 
                                                    <% if (event.status === 'approved') { %>bg-green-100 text-green-800<% } else if (event.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } else { %>bg-red-100 text-red-800<% } %>">
                                                    <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                                </span>
                                                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">
                                                    <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
                                                </span>
                                            </div>
                                            <div class="text-sm text-gray-600 space-y-1">
                                                <div class="flex items-center">
                                                    <i class="fas fa-calendar-alt mr-3 text-gray-400"></i>
                                                    <span><%= new Date(event.date).toLocaleDateString() %></span>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-clock mr-3 text-gray-400"></i>
                                                    <span><%= event.startTime %> - <%= event.endTime %></span>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-map-marker-alt mr-3 text-gray-400"></i>
                                                    <span><%= event.venue %></span>
                                                </div>
                                                <div class="flex items-center">
                                                    <i class="fas fa-users mr-3 text-gray-400"></i>
                                                    <span><%= event.registrations.length %> registered</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex space-x-2 ml-4">
                                            <a href="/faculty/events/<%= event._id %>/edit" class="p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" title="Edit Event">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="/faculty/events/<%= event._id %>/registrations" class="p-2 bg-green-600 text-white rounded-lg hover:bg-green-700" title="View Participants">
                                                <i class="fas fa-users"></i>
                                            </a>
                                            <a href="/faculty/events/<%= event._id %>/attendance" class="p-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700" title="Mark Attendance">
                                                <i class="fas fa-check-square"></i>
                                            </a>
                                            <% if (event.status !== 'approved') { %>
                                                <form action="/faculty/events/<%= event._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this event?')" class="inline">
                                                    <button type="submit" class="p-2 bg-red-600 text-white rounded-lg hover:bg-red-700" title="Delete Event">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-12">
                                <i class="fas fa-calendar-times text-6xl text-gray-300 mb-4"></i>
                                <h3 class="text-xl font-semibold text-gray-600 mb-2">No Events Created Yet</h3>
                                <p class="text-gray-500 mb-6">Start by creating your first event to manage institutional activities</p>
                                <a href="/faculty/events/create" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition">
                                    <i class="fas fa-plus mr-2"></i>
                                    Create Your First Event
                                </a>
                            </div>
                        <% } %>
                </div>

                <!-- Statistics Overview -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 animate-fade-in">
                    <div class="bg-white p-6 rounded-xl card-shadow">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Stats</h3>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg">
                                <span class="text-sm font-medium text-gray-700">Total Events</span>
                                <span class="text-xl font-bold text-blue-600"><%= stats.totalEvents || 0 %></span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg">
                                <span class="text-sm font-medium text-gray-700">Approved Events</span>
                                <span class="text-xl font-bold text-green-600"><%= stats.approvedEvents || 0 %></span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-yellow-50 rounded-lg">
                                <span class="text-sm font-medium text-gray-700">Pending Events</span>
                                <span class="text-xl font-bold text-yellow-600"><%= stats.pendingEvents || 0 %></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-white p-6 rounded-xl card-shadow">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Event Categories</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-3 border rounded-lg hover:bg-gray-50">
                                <div class="flex items-center">
                                    <i class="fas fa-chalkboard-teacher text-blue-600 mr-3"></i>
                                    <span class="text-sm font-medium">Seminars</span>
                                </div>
                                <span class="text-sm text-gray-600">Academic events</span>
                            </div>
                            <div class="flex items-center justify-between p-3 border rounded-lg hover:bg-gray-50">
                                <div class="flex items-center">
                                    <i class="fas fa-tools text-green-600 mr-3"></i>
                                    <span class="text-sm font-medium">Workshops</span>
                                </div>
                                <span class="text-sm text-gray-600">Hands-on training</span>
                            </div>
                            <div class="flex items-center justify-between p-3 border rounded-lg hover:bg-gray-50">
                                <div class="flex items-center">
                                    <i class="fas fa-music text-purple-600 mr-3"></i>
                                    <span class="text-sm font-medium">Cultural</span>
                                </div>
                                <span class="text-sm text-gray-600">Arts & culture</span>
                            </div>
                            <div class="flex items-center justify-between p-3 border rounded-lg hover:bg-gray-50">
                                <div class="flex items-center">
                                    <i class="fas fa-running text-red-600 mr-3"></i>
                                    <span class="text-sm font-medium">Sports</span>
                                </div>
                                <span class="text-sm text-gray-600">Athletic events</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-white p-6 rounded-xl card-shadow">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Help & Support</h3>
                        <div class="space-y-3">
                            <a href="#" class="flex items-center p-3 border rounded-lg hover:bg-gray-50">
                                <i class="fas fa-question-circle text-blue-600 mr-3"></i>
                                <span class="text-sm font-medium">Help Center</span>
                            </a>
                            <a href="#" class="flex items-center p-3 border rounded-lg hover:bg-gray-50">
                                <i class="fas fa-book text-green-600 mr-3"></i>
                                <span class="text-sm font-medium">User Guide</span>
                            </a>
                            <a href="#" class="flex items-center p-3 border rounded-lg hover:bg-gray-50">
                                <i class="fas fa-envelope text-purple-600 mr-3"></i>
                                <span class="text-sm font-medium">Contact Support</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Add interactive animations on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Animate cards on scroll
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate-fade-in');
                    }
                });
            });

            document.querySelectorAll('.animate-fade-in').forEach(el => {
                observer.observe(el);
            });
        });
    </script>
</body>
</html>
