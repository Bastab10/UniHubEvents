<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Result - <%= result.event.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <% if (success && success.length > 0) { %>
            <div class="mb-6 bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-r-lg">
                <div class="flex items-center">
                    <i class="fas fa-check-circle mr-3 text-green-500"></i>
                    <span class="font-medium"><%= success %></span>
                </div>
            </div>
        <% } %>
        <% if (error && error.length > 0) { %>
            <div class="mb-6 bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-r-lg">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-circle mr-3 text-red-500"></i>
                    <span class="font-medium"><%= error %></span>
                </div>
            </div>
        <% } %>

        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <!-- Header -->
            <div class="bg-white border-b border-gray-200 py-6 px-4 sm:px-6 lg:px-8 -mx-6 -mt-6 rounded-t-lg">
                <div class="text-center">
                    <h1 class="text-2xl font-semibold text-gray-800">Edit Event Result</h1>
                    <p class="mt-1 text-gray-500 text-sm"><%= result.event.title %></p>
                    <% if (result.event.eventMode === 'versity') { %>
                        <span class="inline-block mt-2 px-3 py-1 bg-red-100 text-red-800 text-xs rounded-full font-medium">Versity Week Event</span>
                    <% } %>
                </div>
            </div>

            <form action="/faculty/results/<%= result._id %>/edit" method="POST" class="space-y-6 pt-6">
                <!-- Winners Section -->
                <div class="pt-4 border-t border-gray-200">
                    <h3 class="text-sm font-semibold text-gray-700 mb-4 uppercase tracking-wide">Winners</h3>

                    <div class="grid gap-4 md:grid-cols-3">
                        <!-- 1st Position -->
                        <div class="border border-gray-200 rounded-lg p-4">
                            <div class="text-sm font-medium text-amber-600 mb-3">🥇 First Place</div>
                            <label class="block text-sm text-gray-600 mb-1">Name</label>
                            <input type="text" name="firstPosition[name]" required
                                   value="<%= result.firstPosition.name %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">Department</label>
                            <input type="text" name="firstPosition[department]"
                                   value="<%= result.firstPosition.department %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">College ID</label>
                            <input type="text" name="firstPosition[collegeId]" required
                                   value="<%= result.firstPosition.collegeId %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">Points <span class="text-xs text-gray-400">(Optional)</span></label>
                            <input type="number" name="firstPosition[points]" min="0"
                                   value="<%= result.firstPosition.points || '' %>"
                                   placeholder="Enter points"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400">
                        </div>

                        <!-- 2nd Position -->
                        <div class="border border-gray-200 rounded-lg p-4">
                            <div class="text-sm font-medium text-gray-600 mb-3">🥈 Second Place</div>
                            <label class="block text-sm text-gray-600 mb-1">Name</label>
                            <input type="text" name="secondPosition[name]" required
                                   value="<%= result.secondPosition.name %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">Department</label>
                            <input type="text" name="secondPosition[department]"
                                   value="<%= result.secondPosition.department %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">College ID</label>
                            <input type="text" name="secondPosition[collegeId]"
                                   value="<%= result.secondPosition.collegeId %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">Points <span class="text-xs text-gray-400">(Optional)</span></label>
                            <input type="number" name="secondPosition[points]" min="0"
                                   value="<%= result.secondPosition.points || '' %>"
                                   placeholder="Enter points"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400">
                        </div>

                        <!-- 3rd Position -->
                        <div class="border border-gray-200 rounded-lg p-4">
                            <div class="text-sm font-medium text-orange-700 mb-3">🥉 Third Place</div>
                            <label class="block text-sm text-gray-600 mb-1">Name</label>
                            <input type="text" name="thirdPosition[name]" required
                                   value="<%= result.thirdPosition.name %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">Department</label>
                            <input type="text" name="thirdPosition[department]"
                                   value="<%= result.thirdPosition.department %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">College ID</label>
                            <input type="text" name="thirdPosition[collegeId]"
                                   value="<%= result.thirdPosition.collegeId %>"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 mb-3">

                            <label class="block text-sm text-gray-600 mb-1">Points <span class="text-xs text-gray-400">(Optional)</span></label>
                            <input type="number" name="thirdPosition[points]" min="0"
                                   value="<%= result.thirdPosition.points || '' %>"
                                   placeholder="Enter points"
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400">
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex gap-3">
                    <button type="submit" class="px-4 py-2 bg-gray-800 text-white text-sm rounded hover:bg-gray-900">
                        <i class="fas fa-save mr-2"></i>Update Result
                    </button>
                    <a href="/faculty/dashboard" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded hover:bg-gray-300">
                        Cancel
                    </a>
                </div>
            </form>

            <% if (result.event.eventMode === 'versity') { %>
            <div class="mt-6 pt-6 border-t border-gray-200 bg-amber-50 p-4 rounded-lg">
                <div class="flex items-start">
                    <i class="fas fa-info-circle text-amber-500 mt-0.5 mr-3"></i>
                    <div>
                        <p class="text-sm font-medium text-amber-800">Versity Week Event Notice</p>
                        <p class="text-sm text-amber-700 mt-1">
                            This is a Versity Week event. Changing departments will automatically recalculate leaderboard points:
                            <span class="font-semibold">1st Place = 10 pts, 2nd Place = 7 pts, 3rd Place = 5 pts</span>
                        </p>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

    </div>

    <%- include('../partials/footer') %>
</body>
</html>
