```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Faculty Panel - Enhanced Event Management</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-50">

<div class="flex h-screen">

<!-- Sidebar -->
<aside class="w-64 bg-gray-800 text-white flex flex-col">

<div class="p-6 border-b border-gray-700">
<h2 class="text-lg font-bold">Faculty Panel</h2>
<p class="text-sm text-gray-300">Event Management System</p>
</div>

<nav class="flex-1 p-4">
<ul class="space-y-2">

<li>
<a href="/faculty/dashboard"
class="flex items-center space-x-3 p-3 rounded-lg bg-gray-700 hover:bg-gray-600">
<i class="fas fa-tachometer-alt w-5"></i>
<span>Dashboard</span>
</a>
</li>

<li>
<a href="/faculty/events/create"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-plus-circle w-5"></i>
<span>Create Event</span>
</a>
</li>

<li>
<a href="/faculty/events"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-calendar w-5"></i>
<span>My Events</span>
</a>
</li>

<li>
<a href="/faculty/calendar"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-calendar-alt w-5"></i>
<span>Calendar</span>
</a>
</li>

<li>
<a href="/faculty/participants"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-users w-5"></i>
<span>Participants</span>
</a>
</li>

<li>
<a href="/faculty/sports"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-running w-5"></i>
<span>Sports</span>
</a>
</li>

<li>
<a href="/faculty/seminars"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-chalkboard-teacher w-5"></i>
<span>Seminars</span>
</a>
</li>

<li>
<a href="/faculty/reports"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-file-alt w-5"></i>
<span>Reports</span>
</a>
</li>

<li>
<a href="/faculty/analytics"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-chart-bar w-5"></i>
<span>Analytics</span>
</a>
</li>

<li>
<a href="/faculty/notifications"
class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-600">
<i class="fas fa-bell w-5"></i>
<span>Notifications</span>
<span class="ml-auto bg-red-500 text-xs px-2 py-1 rounded-full">3</span>
</a>
</li>

</ul>
</nav>
</aside>



<!-- Main Content -->
<main class="flex-1 overflow-y-auto">

<header class="bg-white shadow-sm border-b">
<div class="px-6 py-4">
<h1 class="text-2xl font-bold text-gray-800">
Enhanced Faculty Dashboard
</h1>
<p class="text-gray-600">
Comprehensive event management and monitoring system
</p>
</div>
</header>



<div class="p-6">

<!-- Statistics -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

<div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-500">
<h3 class="text-sm font-medium text-gray-600">Total Events</h3>
<p class="text-3xl font-bold text-gray-800">
<%= stats.totalEvents %>
</p>
</div>

<div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-500">
<h3 class="text-sm font-medium text-gray-600">Active Events</h3>
<p class="text-3xl font-bold text-gray-800">
<%= stats.approvedEvents %>
</p>
</div>

<div class="bg-white p-6 rounded-lg shadow border-l-4 border-yellow-500">
<h3 class="text-sm font-medium text-gray-600">Pending Review</h3>
<p class="text-3xl font-bold text-gray-800">
<%= stats.pendingEvents %>
</p>
</div>

<div class="bg-white p-6 rounded-lg shadow border-l-4 border-purple-500">
<h3 class="text-sm font-medium text-gray-600">Total Participants</h3>
<p class="text-3xl font-bold text-gray-800">247</p>
</div>

</div>



<!-- Status Tracking -->
<div class="bg-white p-6 rounded-lg shadow">

<h2 class="text-lg font-semibold text-gray-800 mb-4">
Status Tracking
</h2>

<div class="p-3 border rounded-lg">

<div class="flex justify-between items-center mb-2">
<span class="text-sm font-medium">Approval Status</span>
<span class="text-sm font-bold text-yellow-600">
<%= stats.pendingEvents %> Pending
</span>
</div>

<div class="w-full bg-gray-200 rounded-full h-2">
    <% 
    const percentage = ((stats.approvedEvents + stats.pendingEvents) > 0 ? Math.round((stats.approvedEvents / (stats.approvedEvents + stats.pendingEvents)) * 100) : 0);
%>
<div class="bg-green-600 h-2 rounded-full progress-bar" id="progressBar"></div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const progressBar = document.getElementById('progressBar');
        if (progressBar) {
            progressBar.style.width = '<%= percentage %>%';
        }
    });
</script>
</div>

</div>

</div>



</div>
</main>
</div>

</body>
</html>
```
